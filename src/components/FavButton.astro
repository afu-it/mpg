---
// Heart toggle for saving a gateway to favourites (Phase 2).
// Renders in its default (un-favourited) state server-side; src/scripts/favourites.ts
// hydrates aria-pressed from the signed-in user's favourites and wires the toggle.
interface Props {
  slug: string;
  name: string;
  size?: number;
}
const { slug, name, size = 18 } = Astro.props;
---

<button
  type="button"
  class="fav-btn grid shrink-0 place-items-center rounded-md p-1 text-muted transition-colors hover:text-accent"
  data-fav-slug={slug}
  aria-pressed="false"
  aria-label={`Save ${name} to favourites`}
  title="Save to favourites"
>
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path
      d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"
    ></path>
  </svg>
</button>

<style>
  /* Filled accent heart once favourited. */
  .fav-btn[aria-pressed="true"] {
    color: var(--color-accent);
  }
  .fav-btn[aria-pressed="true"] svg {
    fill: currentColor;
  }
</style>
