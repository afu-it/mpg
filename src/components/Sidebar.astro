---
// Filter sidebar, wired up by src/scripts/table.ts.
import { getLocale, tr } from "../i18n/locale";
const T = tr(getLocale(Astro), {
  en: {
    gateway: "Gateways", bank: "Banks", ewallet: "E-wallet", infrastructure: "Infrastructure", all: "All",
    card: "Card", no_code: "No-code", recurring: "Recurring", mcp: "MCP server",
    category: "Category", channels: "Channels", features: "Features", developer: "Developer",
    reset: "Reset filters",
    regulation: "Regulation", bnm: "On BNM register",
    signup: "Sign-up & payout", no_ssm: "No SSM needed", instant: "Same-day payout",
  },
  ms: {
    gateway: "Gateway", bank: "Bank", ewallet: "E-wallet", infrastructure: "Infrastruktur", all: "Semua",
    card: "Kad", no_code: "Tanpa kod", recurring: "Recurring", mcp: "Server MCP",
    category: "Kategori", channels: "Cara bayar", features: "Ciri", developer: "Developer",
    reset: "Set semula penapis",
    regulation: "Kawal selia", bnm: "Dalam senarai BNM",
    signup: "Daftar & duit masuk", no_ssm: "Tanpa SSM", instant: "Duit masuk hari sama",
  },
});
const categories = [
  { key: "gateway", label: T.gateway },
  { key: "bank", label: T.bank },
  { key: "ewallet", label: T.ewallet },
  { key: "bnpl", label: "BNPL" },
  { key: "infrastructure", label: T.infrastructure },
  { key: "all", label: T.all },
];
const channels = [
  { key: "fpx", label: "FPX" },
  { key: "card", label: T.card },
  { key: "ewallet", label: T.ewallet },
  { key: "duitnowqr", label: "DuitNow QR" },
  { key: "bnpl", label: "BNPL" },
];
const features = [
  { key: "no_code", label: T.no_code },
  { key: "recurring", label: T.recurring },
];
// developer group (2026-07-17, owner request): stays visible so devs can
// instantly list gateways with an API or an MCP server
const developer = [
  { key: "api", label: "API" },
  { key: "mcp", label: T.mcp },
];

// regulation group (2026-10-21, owner request): gateways whose own company is on
// Bank Negara's register; matched through data-bnm like the other features
const regulation = [{ key: "bnm", label: T.bnm }];

// sign-up & payout group (2026-10-21, reader requests): individuals without SSM
// registration, and real-time / same-day payout; both set only from a quoted
// official page (data-no_ssm / data-instant)
const signup = [
  { key: "no_ssm", label: T.no_ssm },
  { key: "instant", label: T.instant },
];

const heading = "mb-2 text-xs font-semibold uppercase tracking-wide text-muted";
// collapsed-by-default groups (spec 16 slice C): plain <details>, so table.ts
// selectors and the filter inputs' DOM stay untouched
const summary =
  "flex cursor-pointer select-none items-center justify-between text-xs font-semibold uppercase tracking-wide text-muted [&::-webkit-details-marker]:hidden";
// py-3 below md keeps each row a >=44px touch target inside the mobile drawer
const row =
  "flex cursor-pointer select-none items-center gap-2.5 rounded-md px-2 py-3 text-sm text-fg hover:bg-panel md:py-1.5";
const input = "size-3.5 accent-accent";
---

<div class="space-y-6">
  <div>
    <h2 class={heading}>{T.category}</h2>
    {
      categories.map((c) => (
        <label class={row}>
          <input
            type="radio"
            name="gw-category"
            value={c.key}
            checked={c.key === "gateway"}
            class={input}
          />
          {c.label}
        </label>
      ))
    }
  </div>

  <details class="group">
    <summary class={summary}>
      <h2>{T.channels}</h2>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-3.5 transition-transform group-open:rotate-180" aria-hidden="true">
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </summary>
    <div class="mt-2">
      {
        channels.map((c) => (
          <label class={row}>
            <input type="checkbox" data-filter-channel={c.key} class={input} />
            {c.key === "duitnowqr" ? <span class="text-duitnow">{c.label}</span> : c.key === "fpx" ? <span class="text-fpx">{c.label}</span> : c.label}
          </label>
        ))
      }
    </div>
  </details>

  <details class="group">
    <summary class={summary}>
      <h2>{T.features}</h2>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-3.5 transition-transform group-open:rotate-180" aria-hidden="true">
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </summary>
    <div class="mt-2">
      {
        features.map((f) => (
          <label class={row}>
            <input type="checkbox" data-filter-feature={f.key} class={input} />
            {f.label}
          </label>
        ))
      }
    </div>
  </details>

  <details class="group" open>
    <summary class={summary}>
      <h2>{T.signup}</h2>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-3.5 transition-transform group-open:rotate-180" aria-hidden="true">
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </summary>
    <div class="mt-2">
      {
        signup.map((f) => (
          <label class={row}>
            <input type="checkbox" data-filter-feature={f.key} class={input} />
            {f.label}
          </label>
        ))
      }
    </div>
  </details>

  <details class="group" open>
    <summary class={summary}>
      <h2>{T.regulation}</h2>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-3.5 transition-transform group-open:rotate-180" aria-hidden="true">
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </summary>
    <div class="mt-2">
      {
        regulation.map((f) => (
          <label class={row}>
            <input type="checkbox" data-filter-feature={f.key} class={input} />
            {f.label}
          </label>
        ))
      }
    </div>
  </details>

  <details class="group" open>
    <summary class={summary}>
      <h2>{T.developer}</h2>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-3.5 transition-transform group-open:rotate-180" aria-hidden="true">
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </summary>
    <div class="mt-2">
      {
        developer.map((f) => (
          <label class={row}>
            <input type="checkbox" data-filter-feature={f.key} class={input} />
            {f.label}
          </label>
        ))
      }
    </div>
  </details>

  <button
    id="gw-reset"
    type="button"
    class="rounded-md border border-line px-3 py-1.5 text-xs text-muted hover:text-fg"
  >
    {T.reset}
  </button>
</div>
