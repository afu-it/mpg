---
import { getCollection } from "astro:content";
import { gatewayCost, effectiveCostAt, REF_TICKET } from "../lib/fees";
import { splitName, stripParens } from "../lib/name";
import Logo from "./Logo.astro";
import FeeCell from "./FeeCell.astro";
import FeatureBadge from "./FeatureBadge.astro";
import MethodologyNote from "./MethodologyNote.astro";
import { getLocale, localizePath, tr } from "../i18n/locale";
import { bnmBadge } from "../lib/bnm";

const locale = getLocale(Astro);
const T = tr(locale, {
  en: {
    showing: "Showing",
    of: (total: number) => `of ${total} gateways`,
    comparable: "with comparable published pricing",
    gateway: "Gateway",
    estTitle: "Estimated processing fee on a RM100 transaction, blending FPX/card/e-wallet (50/30/20). Indicative; see note below.",
    est: "Est. fee / RM100",
    fixedTitle: "Setup / recurring",
    fixed: "Fixed fee",
    card: "Card",
    settlement: "Settlement",
    recurring: "Recurring",
    divider: "Pricing on request · no comparable published rates · ordered by popularity",
    bank: "Bank",
    apiTitle: "Public developer API documentation",
    mcpOfficial: "Official MCP server: AI-agent ready",
    mcpCommunity: "Community MCP server (third-party)",
    estCellTitle: "Estimated blended fee on a RM100 transaction",
    onRequestTitle: "No comparable published pricing — contact the provider for a quote",
    onRequest: "On request",
    empty: "No gateways match your filters.",
  },
  ms: {
    showing: "Menunjukkan",
    of: (total: number) => `daripada ${total} gateway`,
    comparable: "ada harga rasmi yang boleh dibandingkan",
    gateway: "Gateway",
    estTitle: "Anggaran caj bagi jualan RM100, campuran FPX/kad/e-wallet (50/30/20). Sekadar panduan, baca nota di bawah.",
    est: "Anggaran caj / RM100",
    fixedTitle: "Fee setup / fee bulanan",
    fixed: "Fee tetap",
    card: "Kad",
    settlement: "Duit masuk",
    recurring: "Recurring",
    divider: "Harga atas permintaan · tiada kadar rasmi untuk dibandingkan · disusun ikut populariti",
    bank: "Bank",
    apiTitle: "Dokumentasi API terbuka untuk developer",
    mcpOfficial: "Server MCP rasmi, AI agent boleh guna terus",
    mcpCommunity: "Server MCP komuniti (pihak ketiga)",
    estCellTitle: "Anggaran caj campuran bagi jualan RM100",
    onRequestTitle: "Tiada harga rasmi untuk dibandingkan. Hubungi gateway untuk dapatkan sebut harga",
    onRequest: "Atas permintaan",
    empty: "Tiada gateway yang ikut penapis yang anda pilih.",
  },
});

// Each gateway gets a blended effective cost (RM on a RM100 transaction) and a
// `rankable` flag. Only gateways that publish official rates for a comparable
// channel set are ranked by fee; the rest ("Pricing on request") sort below.
const entries = (await getCollection("gateways")).map((g) => ({
  g,
  ...gatewayCost(g.data.fees, REF_TICKET),
}));

// Default order = cheapest published effective cost first; un-rankable gateways
// drop below, ordered by editorial popularity then name.
entries.sort((a, b) => {
  if (a.rankable !== b.rankable) return a.rankable ? -1 : 1;
  if (a.rankable && b.rankable && a.cost !== b.cost) return a.cost - b.cost;
  if (b.g.data.popularity !== a.g.data.popularity) return b.g.data.popularity - a.g.data.popularity;
  return a.g.data.name.localeCompare(b.g.data.name);
});
const total = entries.length;
const rankedCount = entries.filter((e) => e.rankable).length;
// index of the ranked → "Pricing on request" boundary; a divider row renders here
// (table.ts repositions/hides it as filters and sorts change)
const firstOnRequest = entries.findIndex((e) => !e.rankable);

const rm = (n: number) => `RM${n.toFixed(2)}`;

// header cells: label + whether sortable + sort type
const feeCols = [
  { key: "fpx", label: "FPX" },
  { key: "card", label: T.card },
  { key: "ewallet", label: "E-wallet" },
  { key: "duitnowqr", label: "DuitNow QR" },
  { key: "bnpl", label: "BNPL" },
] as const;

const COLS = 3 + feeCols.length + 2; // gateway + est fee + fixed fee + fee cols + settlement + recurring

const th =
  "whitespace-nowrap px-2.5 py-2 text-left align-bottom font-medium text-muted";
const sortBtn =
  "group inline-flex items-center gap-1 hover:text-fg aria-[sort]:text-fg";
const td = "whitespace-nowrap px-2.5 py-2 align-middle";
---

<div class="mb-3 space-y-3">
  <slot name="controls" />
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <slot name="chips" />
    <p class="text-sm text-muted">
      {T.showing} <span id="gw-count" class="text-fg">{total}</span> {T.of(total)}{" "}
      · <span class="text-fg">{rankedCount}</span> {T.comparable}
    </p>
  </div>
</div>

<div class="gw-scroll max-h-[calc(100dvh-8rem)] overflow-auto rounded-md border border-line">
  <table id="gw-table" class="w-full border-collapse text-sm">
    <thead class="sticky top-0 z-20 border-b border-line bg-panel">
      <tr>
        <th scope="col" class={`${th} sticky left-0 z-30 bg-panel`} aria-sort="none">
          <button type="button" class={sortBtn} data-sort-type="text">
            {T.gateway} <span class="sort-arrow text-accent" aria-hidden="true"></span>
          </button>
        </th>
        <th scope="col" class={th} aria-sort="none">
          <button
            type="button"
            class={sortBtn}
            data-sort-type="num"
            title={T.estTitle}
          >
            {T.est} <span class="sort-arrow text-accent" aria-hidden="true"></span>
          </button>
        </th>
        <th scope="col" class={th} aria-sort="none">
          <button type="button" class={sortBtn} data-sort-type="num" title={T.fixedTitle}>
            {T.fixed} <span class="sort-arrow text-accent" aria-hidden="true"></span>
          </button>
        </th>
        {
          feeCols.map((c) => (
            <th scope="col" class={th} data-col-key={c.key} aria-sort="none">
              <button type="button" class={sortBtn} data-sort-type="num">
                {c.key === "duitnowqr" ? <span class="text-duitnow">{c.label}</span> : c.key === "fpx" ? <span class="text-fpx">{c.label}</span> : c.label} <span class="sort-arrow text-accent" aria-hidden="true" />
              </button>
            </th>
          ))
        }
        <th scope="col" class={th} aria-sort="none">
          <button type="button" class={sortBtn} data-sort-type="text">
            {T.settlement} <span class="sort-arrow text-accent" aria-hidden="true"></span>
          </button>
        </th>
        <th scope="col" class={th} aria-sort="none">
          <button type="button" class={sortBtn} data-sort-type="num">
            {T.recurring} <span class="sort-arrow text-accent" aria-hidden="true"></span>
          </button>
        </th>
      </tr>
    </thead>

    <tbody>
      {
        entries.map(({ g, rankable, cost }, i) => (
          <>
          {i === firstOnRequest && (
            <tr id="gw-divider" data-divider class="border-b border-line/60">
              <td colspan={COLS} class="bg-panel px-3 py-1.5 text-[11px] uppercase tracking-wide text-muted">
                {T.divider}
              </td>
            </tr>
          )}
          <tr
            class="cursor-pointer border-b border-line/60 last:border-0 hover:bg-panel"
            data-name={g.data.name.toLowerCase()}
            data-category={g.data.category}
            data-value={rankable ? String(cost) : "Infinity"}
            data-popularity={String(g.data.popularity)}
            data-rankable={String(rankable)}
            data-channels={g.data.channels.join(" ")}
            data-no_code={String(g.data.features.no_code)}
            data-api={String(g.data.features.api)}
            data-mcp={String(g.data.mcp !== "none")}
            data-bnm={String(Boolean(g.data.bnm))}
            data-no_ssm={String(Boolean(g.data.no_ssm))}
            data-instant={String(Boolean(g.data.instant_settlement))}
            data-recurring={String(g.data.features.recurring)}
            data-href={localizePath(`/gateway/${g.id}/`, locale)}
          >
            <td class={`px-2.5 py-2 align-middle sticky left-0 z-10 w-[12.5rem] min-w-[12.5rem] bg-surface`} data-sort-value={g.data.name.toLowerCase()}>
              <a
                href={`/gateway/${g.id}/`}
                class="flex items-center gap-2.5 font-medium text-fg hover:text-accent"
              >
                <Logo slug={g.id} name={g.data.name} compact />
                {/* name, then the note (if any), then badges that may wrap, so the
                    sticky first column stays narrow instead of growing to the longest row */}
                <span class="flex min-w-0 flex-col gap-1">
                <span class="font-bold leading-tight">{splitName(g.data.name).base}</span>
                <span class="flex flex-wrap items-center gap-1">
                {g.data.category === "bnpl" && (
                  <span class="rounded-full bg-brand-red px-1 py-px text-[8px] font-medium uppercase tracking-tight text-white">
                    BNPL
                  </span>
                )}
                {g.data.category === "bank" && (
                  <span class="rounded-full border border-line px-1 py-px text-[8px] font-medium uppercase tracking-tight text-muted">
                    {T.bank}
                  </span>
                )}
                {g.data.category === "ewallet" && (
                  <span class="rounded-full border border-line px-1 py-px text-[8px] font-medium uppercase tracking-tight text-muted">
                    E-wallet
                  </span>
                )}
                {g.data.bnm && (() => {
                  // compact marker only: the row is already a link, so the BNM list link lives on the detail page
                  const b = bnmBadge(g.data.bnm, locale);
                  return (
                    <span
                      class="rounded-full border border-line px-1 py-px text-[9px] font-medium uppercase tracking-wide text-muted"
                      title={b.title}
                      aria-label={`${b.text}: ${b.title}`}
                    >
                      BNM
                    </span>
                  );
                })()}
                {g.data.features.api && g.data.dev_docs && (
                  <span
                    class="rounded-full border border-line px-1 py-px text-[9px] font-medium uppercase tracking-wide text-muted"
                    title={T.apiTitle}
                  >
                    API
                  </span>
                )}
                {g.data.mcp !== "none" && (
                  <span
                    class="rounded-full border border-accent px-1 py-px text-[9px] font-medium uppercase tracking-wide text-accent"
                    title={g.data.mcp === "official" ? T.mcpOfficial : T.mcpCommunity}
                  >
                    MCP
                  </span>
                )}
                </span>
                </span>
              </a>
            </td>
            <td class={td} data-sort-value={rankable ? String(cost) : "Infinity"}>
              {rankable ? (
                <span class="font-medium text-fg" title={T.estCellTitle}>{rm(cost)}</span>
              ) : (
                <span class="text-muted" title={T.onRequestTitle}>{T.onRequest}</span>
              )}
            </td>
            <td class="gw-minor min-w-[8rem] max-w-[13rem] px-2.5 py-2 align-middle" data-sort-value={String(effectiveCostAt(g.data.fees.monthly, REF_TICKET))}>
              <FeeCell value={stripParens(g.data.fees.setup)} />
              {/* the recurring fee goes on its own line so long notes wrap instead of widening the column */}
              {g.data.fees.monthly !== g.data.fees.setup && (
                <span class="mt-0.5 block text-xs leading-snug text-muted">/ {stripParens(g.data.fees.monthly)}</span>
              )}
            </td>
            {feeCols.map((c) => {
              const v = g.data.fees[c.key] ?? "—";
              return (
                <td
                  class={`${td}${v === "—" ? " gw-minor" : ""}`}
                  data-label={c.label}
                  data-sort-value={String(effectiveCostAt(v, REF_TICKET))}
                >
                  <FeeCell value={stripParens(v)} />
                </td>
              );
            })}
            <td class={td} data-label={T.settlement} data-sort-value={g.data.settlement.toLowerCase()}>
              <FeeCell value={stripParens(g.data.settlement)} />
            </td>
            <td class={`${td} gw-minor`} data-sort-value={g.data.features.recurring ? "0" : "1"}>
              <FeatureBadge on={g.data.features.recurring} label={T.recurring} />
            </td>
          </tr>
          </>
        ))
      }
    </tbody>
  </table>

  <p id="gw-empty" hidden class="px-3 py-8 text-center text-muted">
    {T.empty}
  </p>
</div>

<MethodologyNote bnm />

<style>
  /* the table scrolls inside its own box so the sideways scrollbar stays on screen
     (macOS hides overlay scrollbars until you scroll, and the page bottom is 60 rows away) */
  /* Chrome ignores ::-webkit-scrollbar once scrollbar-width/color is set, and the
     standard properties keep macOS overlay (hidden) bars, so only Firefox gets them */
  @supports not selector(::-webkit-scrollbar) {
    .gw-scroll {
      scrollbar-width: thin;
      scrollbar-color: var(--color-muted) transparent;
    }
  }
  .gw-scroll::-webkit-scrollbar {
    height: 10px;
    width: 10px;
  }
  .gw-scroll::-webkit-scrollbar-thumb {
    background: #52525b;
    border-radius: 999px;
    border: 2px solid transparent;
    background-clip: padding-box;
  }
  .gw-scroll::-webkit-scrollbar-thumb:hover {
    background-color: var(--color-muted);
  }
  .gw-scroll::-webkit-scrollbar-corner {
    background: transparent;
  }
  /* vertical dividers between columns (desktop table only; mobile cards reset below) */
  @media (min-width: 768px) {
    #gw-table td + td {
      border-left: 1px solid var(--color-line);
    }
    /* zebra rows, counted over visible gateway rows only so filters and the
       divider band don't break the pattern; tds carry it so the sticky name
       cell stripes too */
    #gw-table tbody tr:nth-child(even of :not([hidden]):not([data-divider])) td {
      background-color: color-mix(in oklab, var(--color-line) 35%, var(--color-surface));
    }
    #gw-table tbody tr:not([data-divider]):hover td {
      background-color: color-mix(in oklab, var(--color-line) 60%, var(--color-surface));
    }
  }
  /* sort direction arrow driven by aria-sort on the parent <th> */
  th[aria-sort="ascending"] .sort-arrow::after {
    content: "↑";
  }
  th[aria-sort="descending"] .sort-arrow::after {
    content: "↓";
  }

  /* Mobile card list (spec 14): the SAME table DOM renders as cards below md,
     so table.ts search/sort/filter/divider logic keeps working untouched.
     The sort dropdown replaces column-header sorting on mobile. */
  @media (max-width: 767px) {
    #gw-table {
      display: block;
    }
    #gw-table thead {
      display: none;
    }
    #gw-table tbody {
      display: block;
    }
    #gw-table tbody tr {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      padding: 0.75rem 0.875rem;
      border-bottom: 1px solid color-mix(in oklab, var(--color-line) 60%, transparent);
    }
    /* full-width break between the name/fee header line and the chips */
    #gw-table tbody tr::after {
      content: "";
      order: 0;
      width: 100%;
    }
    #gw-table tbody td {
      display: block;
      padding: 0;
      white-space: normal;
    }
    /* name cell: no sticky on cards */
    #gw-table tbody td:first-child {
      position: static;
      background: transparent;
      order: -1;
      flex: 1 1 auto;
      min-width: 0;
    }
    /* est fee: card header right side */
    #gw-table tbody td:nth-child(2) {
      order: -1;
      flex: 0 0 auto;
      margin-left: auto;
      text-align: right;
    }
    /* labelled fee chips flow inline under the header line */
    #gw-table tbody td[data-label] {
      order: 1;
      display: inline-flex;
      align-items: baseline;
      gap: 0.3rem;
      flex: 0 0 auto;
      margin-top: 0.5rem;
      margin-right: 0.875rem;
      font-size: 0.75rem;
    }
    #gw-table tbody td[data-label]::before {
      content: attr(data-label);
      color: var(--color-muted);
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    /* low-value columns and empty fee cells vanish on mobile */
    #gw-table tbody td.gw-minor {
      display: none;
    }
    /* divider band spans the card width */
    #gw-table tbody tr[data-divider] {
      display: block;
      padding: 0;
    }
    #gw-table tbody tr[data-divider] td {
      display: block;
      white-space: normal;
    }
  }
</style>

<script>
  import "../scripts/table.ts";
</script>
