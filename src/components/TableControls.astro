---
// Search + channel/feature filter chips. Wired up by src/scripts/table.ts.
const channels = [
  { key: "fpx", label: "FPX" },
  { key: "card", label: "Card" },
  { key: "ewallet", label: "E-wallet" },
  { key: "duitnowqr", label: "DuitNow QR" },
  { key: "bnpl", label: "BNPL" },
];
const features = [
  { key: "no_code", label: "No-code" },
  { key: "api", label: "API" },
  { key: "recurring", label: "Recurring" },
];

const chip =
  "rounded-full border border-line px-3 py-1 text-xs text-muted transition-colors hover:text-fg aria-pressed:border-accent aria-pressed:bg-raised aria-pressed:text-accent";
---

<div class="flex flex-col gap-3">
  <input
    id="gw-search"
    type="search"
    placeholder="Search gateway…"
    autocomplete="off"
    aria-label="Search payment gateways by name"
    class="w-full rounded-md border border-line bg-panel px-3 py-2 text-fg placeholder:text-muted focus:border-accent sm:max-w-xs"
  />

  <div class="flex flex-wrap items-center gap-2">
    <span class="mr-1 text-xs text-muted">Channels</span>
    {
      channels.map((c) => (
        <button type="button" class={chip} data-filter-channel={c.key} aria-pressed="false">
          {c.label}
        </button>
      ))
    }
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <span class="mr-1 text-xs text-muted">Features</span>
    {
      features.map((f) => (
        <button type="button" class={chip} data-filter-feature={f.key} aria-pressed="false">
          {f.label}
        </button>
      ))
    }
  </div>
</div>
