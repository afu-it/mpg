---
// Author bio box (EEAT): rendered at the bottom of every blog post. The Person
// JSON-LD lives in the post template's Article block; this is the visible half.
import { AUTHOR } from "../lib/blog";
import { getLocale, tr } from "../i18n/locale";

const locale = getLocale(Astro);
const T = tr(locale, {
  en: { by: "Written by", role: AUTHOR.role, bio: AUTHOR.bio, github: "GitHub: gateway agent-skills repo" },
  ms: { by: "Ditulis oleh", role: AUTHOR.roleMs, bio: AUTHOR.bioMs, github: "GitHub: repo agent-skills gateway" },
});
---

<aside class="mt-10 rounded-lg border border-line bg-panel p-4">
  <p class="text-sm font-medium text-fg">
    {T.by} {AUTHOR.name} <span class="text-muted">· {T.role}</span>
  </p>
  <p class="mt-2 text-sm text-muted">{T.bio}</p>
  <p class="mt-2 text-sm">
    <a
      href="https://github.com/afu-it/malaysia-payment-gateway"
      rel="me"
      class="text-accent underline-offset-2 hover:underline"
    >
      {T.github}
    </a>
    <span class="px-1 text-muted">·</span>
    <a href="https://www.threads.com/@afwzn" rel="me" class="text-accent underline-offset-2 hover:underline">
      Threads: @afwzn
    </a>
  </p>
</aside>
