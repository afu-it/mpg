---
// Live fee table for blog posts: renders current directory data for the
// gateway slugs a post declares in frontmatter, so blog numbers can never
// drift from /gateways. Same engine as the site ranking (toApiGateway).
import { getCollection } from "astro:content";
import { toApiGateway, type GatewayEntryLike } from "../lib/api";
import Logo from "./Logo.astro";
import { getLocale, tr, formatDate } from "../i18n/locale";
import { gatewayMs } from "../i18n/content";

interface Props {
  slugs: string[];
}
const { slugs } = Astro.props;

const locale = getLocale(Astro);
const T = tr(locale, {
  en: {
    gateway: "Gateway",
    fpx: "FPX",
    card: "Card (local)",
    ewallet: "E-wallet",
    duitnow: "DuitNow QR",
    est: "Est. / RM100",
    settlement: "Settlement",
    onRequest: "On request",
    caption: (d: string) =>
      `Live directory data, verified against official sources on ${d}. Third-party figures carry a trailing *; "Contact sales" means the provider does not publish that rate.`,
  },
  ms: {
    gateway: "Gateway",
    fpx: "FPX",
    card: "Kad (tempatan)",
    ewallet: "E-wallet",
    duitnow: "DuitNow QR",
    est: "Anggaran / RM100",
    settlement: "Duit masuk",
    onRequest: "Atas permintaan",
    caption: (d: string) =>
      `Data terkini dari direktori kami, disemak dengan sumber rasmi pada ${d}. Angka bertanda * datang dari pihak ketiga. "Hubungi jualan" bermaksud gateway itu tidak siarkan kadar tersebut.`,
  },
});
// fee cells keep their figures; only the "Contact sales" placeholder is translated
const fee = (v: string | undefined) => (locale === "ms" && v === "Contact sales" ? "Hubungi jualan" : v);


const all = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
const rows = slugs
  .map((s) => all.find((e) => e.id === s))
  .filter((e): e is GatewayEntryLike => Boolean(e))
  .map((e) => ({ entry: e, api: toApiGateway(e) }));
const settlementMs = new Map<string, string | undefined>();
for (const r of rows) settlementMs.set(r.entry.id, (await gatewayMs(r.entry.id, locale))?.data.settlement);

const verified = rows
  .map((r) => r.entry.data.verified_date)
  .sort()
  .at(-1);
const verifiedShown = verified && locale === "ms" ? formatDate(verified, locale) : verified;
---

{
  rows.length > 0 && (
    <figure class="not-prose my-6 overflow-x-auto rounded-lg border border-line">
      <table class="w-full min-w-[560px] text-sm">
        <thead>
          <tr class="border-b border-line bg-panel text-left text-xs uppercase tracking-wide text-muted">
            <th class="px-3 py-2 font-medium">{T.gateway}</th>
            <th class="px-3 py-2 font-medium">{T.fpx}</th>
            <th class="px-3 py-2 font-medium">{T.card}</th>
            <th class="px-3 py-2 font-medium">{T.ewallet}</th>
            <th class="px-3 py-2 font-medium">{T.duitnow}</th>
            <th class="px-3 py-2 font-medium">{T.est}</th>
            <th class="px-3 py-2 font-medium">{T.settlement}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(({ entry, api }) => (
            <tr class="border-b border-line last:border-b-0">
              <td class="px-3 py-2">
                <a href={`/gateway/${entry.id}/`} class="flex items-center gap-2 text-fg hover:text-accent">
                  <Logo slug={entry.id} name={entry.data.name} size={18} />
                  <span class="font-medium">{entry.data.name}</span>
                </a>
              </td>
              <td class="px-3 py-2 text-muted">{fee(entry.data.fees.fpx)}</td>
              <td class="px-3 py-2 text-muted">{fee(entry.data.fees.card)}</td>
              <td class="px-3 py-2 text-muted">{fee(entry.data.fees.ewallet)}</td>
              <td class="px-3 py-2 text-muted">{fee(entry.data.fees.duitnowqr)}</td>
              <td class="px-3 py-2 font-medium text-fg">
                {api.rankable && api.est_fee_rm100 != null ? `RM${api.est_fee_rm100.toFixed(2)}` : T.onRequest}
              </td>
              <td class="px-3 py-2 text-muted">{settlementMs.get(entry.id) ?? fee(entry.data.settlement)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <figcaption class="border-t border-line bg-panel px-3 py-2 text-xs text-muted">
        {T.caption(String(verifiedShown))}
      </figcaption>
    </figure>
  )
}
