---
// Live fee table for blog posts: renders current directory data for the
// gateway slugs a post declares in frontmatter, so blog numbers can never
// drift from /gateways. Same engine as the site ranking (toApiGateway).
import { getCollection } from "astro:content";
import { toApiGateway, type GatewayEntryLike } from "../lib/api";
import Logo from "./Logo.astro";

interface Props {
  slugs: string[];
}
const { slugs } = Astro.props;

const all = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
const rows = slugs
  .map((s) => all.find((e) => e.id === s))
  .filter((e): e is GatewayEntryLike => Boolean(e))
  .map((e) => ({ entry: e, api: toApiGateway(e) }));

const verified = rows
  .map((r) => r.entry.data.verified_date)
  .sort()
  .at(-1);
---

{
  rows.length > 0 && (
    <figure class="not-prose my-6 overflow-x-auto rounded-lg border border-line">
      <table class="w-full min-w-[560px] text-sm">
        <thead>
          <tr class="border-b border-line bg-panel text-left text-xs uppercase tracking-wide text-muted">
            <th class="px-3 py-2 font-medium">Gateway</th>
            <th class="px-3 py-2 font-medium">FPX</th>
            <th class="px-3 py-2 font-medium">Card (local)</th>
            <th class="px-3 py-2 font-medium">E-wallet</th>
            <th class="px-3 py-2 font-medium">DuitNow QR</th>
            <th class="px-3 py-2 font-medium">Est. / RM100</th>
            <th class="px-3 py-2 font-medium">Settlement</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(({ entry, api }) => (
            <tr class="border-b border-line last:border-b-0">
              <td class="px-3 py-2">
                <a href={`/gateway/${entry.id}/`} class="flex items-center gap-2 text-fg hover:text-accent">
                  <Logo slug={entry.id} name={entry.data.name} size={18} />
                  <span class="font-medium">{entry.data.name}</span>
                </a>
              </td>
              <td class="px-3 py-2 text-muted">{entry.data.fees.fpx}</td>
              <td class="px-3 py-2 text-muted">{entry.data.fees.card}</td>
              <td class="px-3 py-2 text-muted">{entry.data.fees.ewallet}</td>
              <td class="px-3 py-2 text-muted">{entry.data.fees.duitnowqr}</td>
              <td class="px-3 py-2 font-medium text-fg">
                {api.rankable && api.est_fee_rm100 != null ? `RM${api.est_fee_rm100.toFixed(2)}` : "On request"}
              </td>
              <td class="px-3 py-2 text-muted">{entry.data.settlement}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <figcaption class="border-t border-line bg-panel px-3 py-2 text-xs text-muted">
        Live directory data, verified against official sources on {verified}. Third-party figures carry a
        trailing *; "Contact sales" means the provider does not publish that rate.
      </figcaption>
    </figure>
  )
}
