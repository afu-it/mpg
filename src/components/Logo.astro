---
// Renders a provider logo from src/assets/logos/<slug>.{svg,png,webp} if present,
// otherwise a clean monogram chip. No broken images, no 404s.
// Square logos get subtly rounded corners; logos flagged `logo_round` in their
// frontmatter are cropped to a full circle.
import { getCollection } from "astro:content";

interface Props {
  slug: string;
  name: string;
  size?: number;
}
const { slug, name, size = 22 } = Astro.props;

const logos = import.meta.glob("/src/assets/logos/*.{svg,png,webp}", {
  eager: true,
  query: "?url",
  import: "default",
});
// map slug -> url, preferring .svg when both an svg and a raster exist
const bySlug: Record<string, string> = {};
for (const [path, url] of Object.entries(logos)) {
  const key = path.split("/").pop()!.replace(/\.\w+$/, "");
  if (!bySlug[key] || path.endsWith(".svg")) bySlug[key] = url as string;
}
const logoUrl = bySlug[slug];

const roundSlugs = new Set(
  (await getCollection("gateways")).filter((g) => g.data.logo_round).map((g) => g.id),
);
const isRound = roundSlugs.has(slug);

const initial = (name.trim().charAt(0) || "?").toUpperCase();
---

{
  logoUrl ? (
    isRound ? (
      <img
        src={logoUrl}
        alt={`${name} logo`}
        style={`width:${size}px;height:${size}px`}
        class="shrink-0 rounded-full object-cover"
        loading="lazy"
      />
    ) : (
      <img
        src={logoUrl}
        alt={`${name} logo`}
        style={`height:${size}px`}
        class="w-auto max-w-[120px] rounded-[22%] object-contain"
        loading="lazy"
      />
    )
  ) : (
    <span
      class="grid shrink-0 place-items-center rounded-sm bg-raised font-semibold text-accent"
      style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.48)}px`}
      aria-hidden="true"
    >
      {initial}
    </span>
  )
}
