---
export const prerender = true;

import Base from "../../../layouts/Base.astro";
import { GLOSSARY, glossaryPath, termCopy } from "../../../lib/glossary";
import { getLocale, localizePath, tr } from "../../../i18n/locale";
import { breadcrumbLd } from "../../../lib/jsonld";

const site = (Astro.site?.href ?? "https://malaysiapg.com.my/").replace(/\/$/, "");

const locale = getLocale(Astro);
const T = tr(locale, {
  en: {
    title: "Glossary: payment terms in plain language | MPG",
    description:
      "Plain-language definitions of Malaysian payment-gateway terms: FPX, DuitNow QR, MDR, settlement, webhooks, idempotency, MCP and more.",
    h1: "Glossary",
    lead: "Payment words in plain English. Tap a term for the full explanation.",
    search: "Search terms",
    searchPh: "Search, e.g. FPX, MDR, webhook",
    none: "No term matches that search.",
    count: (n: number) => `${n} terms`,
    back: "← Learn",
    readMore: "Read more",
    setName: "Malaysian payment gateway glossary",
    crumbHome: "Home",
    crumbLearn: "Learn",
  },
  ms: {
    title: "Glosari: istilah bayaran dalam bahasa mudah | MPG",
    description:
      "Maksud istilah payment gateway Malaysia dalam bahasa mudah: FPX, DuitNow QR, MDR, duit masuk, webhook, idempotent, MCP dan banyak lagi.",
    h1: "Glosari",
    lead: "Istilah bayaran dalam bahasa mudah. Tekan satu istilah untuk penerangan penuh.",
    search: "Cari istilah",
    searchPh: "Cari, contoh FPX, MDR, webhook",
    none: "Tiada istilah yang sepadan.",
    count: (n: number) => `${n} istilah`,
    back: "← Belajar",
    readMore: "Baca lagi",
    setName: "Glosari payment gateway Malaysia",
    crumbHome: "Utama",
    crumbLearn: "Belajar",
  },
});
const terms = GLOSSARY.map((t) => ({ slug: t.slug, en: t.term, ...termCopy(t, locale) }));
const path = (slug: string) => localizePath(glossaryPath(slug), locale);

// DefinedTermSet: each term links its own page (spec 12 item 2)
const termSetLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": `${site}/learn/glossary/#termset`,
  name: T.setName,
  url: `${site}${localizePath("/learn/glossary/", locale)}`,
  hasDefinedTerm: terms.map((t) => ({
    "@type": "DefinedTerm",
    name: t.term,
    description: t.def,
    url: `${site}${path(t.slug)}`,
  })),
});
const crumbLd = JSON.stringify(
  breadcrumbLd(site, [
    { name: T.crumbHome, path: localizePath("/", locale) },
    { name: T.crumbLearn, path: localizePath("/learn/", locale) },
    { name: T.h1 },
  ]),
);
---

<Base
  title={T.title}
  description={T.description}
>
  <script is:inline type="application/ld+json" set:html={termSetLd} />
  <script is:inline type="application/ld+json" set:html={crumbLd} />
  <a href="/learn/" class="text-sm text-muted hover:text-fg">{T.back}</a>

  <header class="mt-4 max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">{T.h1}</h1>
    <p class="mt-2 text-muted">{T.lead}</p>
  </header>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <label class="relative block w-full max-w-sm">
      <span class="sr-only">{T.search}</span>
      <svg class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input
        id="gl-search"
        type="search"
        autocomplete="off"
        placeholder={T.searchPh}
        class="w-full rounded-lg border border-line bg-panel py-2 pl-9 pr-3 text-sm text-fg placeholder:text-muted focus:border-accent focus:outline-none"
      />
    </label>
    <span class="text-xs text-muted">{T.count(terms.length)}</span>
  </div>

  <ul id="gl-list" class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      terms.map((t) => (
        <li data-q={`${t.term} ${t.en} ${t.def}`.toLowerCase()}>
          <a href={glossaryPath(t.slug)} class="group flex h-full flex-col rounded-xl border border-line bg-panel p-5 hover:border-muted">
            <span class="flex items-center justify-between gap-2">
              <span class={`text-lg font-semibold ${t.en === "DuitNow QR" ? "text-duitnow" : t.en === "FPX" ? "text-fpx" : "text-fg"}`}>
                {t.term}
              </span>
              <span class="text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-fg" aria-hidden="true">→</span>
            </span>
            <span class="mt-2 line-clamp-3 text-sm text-muted">{t.def}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p id="gl-none" class="mt-6 hidden text-sm text-muted">{T.none}</p>

  <script>
    const input = document.getElementById("gl-search") as HTMLInputElement | null;
    const items = [...document.querySelectorAll<HTMLElement>("#gl-list > li")];
    const none = document.getElementById("gl-none");
    input?.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const li of items) {
        li.hidden = q !== "" && !(li.dataset.q ?? "").includes(q);
        if (!li.hidden) shown++;
      }
      none?.classList.toggle("hidden", shown > 0);
    });
  </script>
</Base>
