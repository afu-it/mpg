---
export const prerender = true;

import Base from "../../layouts/Base.astro";
import { SKILLS_REPO } from "../../lib/learn";

const sections = [
  {
    href: "/learn/glossary",
    title: "Glossary",
    desc: "Plain-language definitions: FPX, DuitNow QR, MDR, settlement, webhooks, idempotency, MCP and more.",
  },
  {
    href: "/learn/integration-flow",
    title: "The safe integration flow",
    desc: "The order to wire a gateway so a payment can never be faked: pending record → checkout → verify webhook → settle once.",
  },
  {
    href: "/learn/ai-agents",
    title: "Build with AI agents",
    desc: "Install AFU's setup-* skills, paste a ready prompt, and understand what MCP vs API/webhooks unlocks for AI coding tools.",
  },
  {
    href: "/learn/checklist",
    title: "Production checklist",
    desc: "What to verify before going live: env vars, webhook URLs, replay-safety, separated keys, no fake-redirect unlock.",
  },
  {
    href: "/learn/api",
    title: "Data API",
    desc: "Query the whole directory as JSON (fees, estimated cost, channels, features, developer support) from your code or an AI agent. MCP server coming.",
  },
];
---

<Base
  title="Learn: integrate a Malaysia payment gateway | MPG"
  description="Understand and ship Malaysian payment gateways: glossary, the safe integration flow, AI-agent setup, and a production checklist."
>
  <header class="max-w-2xl">
    <h1 class="text-2xl font-semibold tracking-tight text-fg">Learn</h1>
    <p class="mt-2 text-muted">
      The directory tells you <em>which</em> gateway to pick. This section tells
      you <em>how</em> to integrate one safely: the jargon, the correct order to
      wire things, and how to hand the job to an AI coding agent.
    </p>
  </header>

  <!-- which type do you need? gateway (integrate) vs bank/e-wallet (account) -->
  <section class="mt-8">
    <h2 class="text-base font-medium text-fg">Which type do you need?</h2>
    <p class="mt-1.5 max-w-2xl text-sm text-muted">
      Not every provider works the same way. There are three broad ways to start
      accepting payments in Malaysia, depending on whether you are integrating code
      or opening a business account.
    </p>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      <div class="rounded-md border border-line bg-panel p-4">
        <span class="rounded-full bg-raised px-2 py-0.5 text-xs font-medium text-accent">Integrate</span>
        <h3 class="mt-2 text-sm font-medium text-fg">Payment gateway</h3>
        <p class="mt-1 text-sm text-muted">
          For developers. Sign up, get API keys, then call the API or drop in a
          plugin (WooCommerce, Shopify). You control the code.
        </p>
        <p class="mt-2 text-xs text-muted">e.g. CHIP, Billplz, Stripe, Curlec, Fiuu</p>
        <a href="/gateways?category=gateway" class="mt-2 inline-block text-sm text-accent hover:underline">
          Browse gateways →
        </a>
      </div>
      <div class="rounded-md border border-line bg-panel p-4">
        <span class="rounded-full bg-raised px-2 py-0.5 text-xs font-medium text-accent">Merchant account</span>
        <h3 class="mt-2 text-sm font-medium text-fg">Bank gateway</h3>
        <p class="mt-1 text-sm text-muted">
          Apply for a business or merchant account with a Malaysian bank. It runs on
          the bank's own hosted gateway, usually tied to your business account.
        </p>
        <p class="mt-2 text-xs text-muted">e.g. Maybank2u Pay, CIMB, OCBC</p>
        <a href="/gateways?category=bank" class="mt-2 inline-block text-sm text-accent hover:underline">
          Browse banks →
        </a>
      </div>
      <div class="rounded-md border border-line bg-panel p-4">
        <span class="rounded-full bg-raised px-2 py-0.5 text-xs font-medium text-accent">Merchant account</span>
        <h3 class="mt-2 text-sm font-medium text-fg">E-wallet &amp; BNPL</h3>
        <p class="mt-1 text-sm text-muted">
          Register as a merchant to accept e-wallets and DuitNow QR, or to offer
          Buy-Now-Pay-Later instalments at checkout.
        </p>
        <p class="mt-2 text-xs text-muted">e.g. Touch 'n Go eWallet, Atome</p>
        <a href="/gateways?category=ewallet" class="mt-2 inline-block text-sm text-accent hover:underline">E-wallet →</a>
        <a href="/gateways?category=bnpl" class="mt-2 ml-4 inline-block text-sm text-accent hover:underline">BNPL →</a>
      </div>
    </div>
  </section>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      sections.map((s) => (
        <a
          href={s.href}
          class="group rounded-md border border-line bg-panel p-5 transition-colors hover:border-accent"
        >
          <h2 class="flex items-center justify-between text-base font-medium text-fg">
            {s.title}
            <span class="text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-accent">
              →
            </span>
          </h2>
          <p class="mt-1.5 text-sm text-muted">{s.desc}</p>
        </a>
      ))
    }
  </div>

  <section class="mt-10 rounded-md border border-line bg-panel p-5">
    <h2 class="text-base font-medium text-fg">Built for vibe coders</h2>
    <p class="mt-1.5 max-w-2xl text-sm text-muted">
      Using Claude Code, Cursor or Codex? Many gateways here map to an open-source{" "}
      <strong class="text-fg">setup skill</strong> that teaches your agent the
      correct, secure integration, and every gateway page with one has a{" "}
      <strong class="text-fg">Copy prompt</strong> button you can paste straight in.
    </p>
    <a
      href={SKILLS_REPO}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-block text-sm text-accent hover:underline"
    >
      afu-it/malaysia-payment-gateway →
    </a>
  </section>
</Base>
