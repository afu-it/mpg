---
// Settlement-speed ranking (spec 12 item 6): static sibling of the
// /best/[profile] pages. Ranks by worst-case parsed settlement days
// (lib/settlement.ts) so nobody ranks faster than they officially promise.
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import { toApiGateway, type GatewayEntryLike } from "../../lib/api";
import { parseSettlementDays } from "../../lib/settlement";
import { breadcrumbLd } from "../../lib/jsonld";
import { PROFILES, profileCopy } from "../../lib/seo-pages";
import { getLocale, tr, formatDate } from "../../i18n/locale";

const locale = getLocale(Astro);
const T = tr(locale, {
  en: {
    title: "Fastest settlement payment gateways in Malaysia | MPG",
    description:
      "Malaysian payment gateways ranked by officially stated settlement speed: who pays out T+1, who takes a week, and who does not say. Worst-case ranked.",
    home: "Home",
    learn: "Learn",
    breadcrumb: "Breadcrumb",
    crumb: "Fastest settlement",
    h1: "Fastest settlement payment gateways in Malaysia",
    lead: 'Settlement is when the money actually reaches your bank account, and it moves your cash flow more than a few basis points of fees ever will. Providers below are ranked by their officially stated settlement time, using the slowest leg they promise (a "T+1 to T+2" provider ranks as T+2, never flattered).',
    answer: (date: string, name: string, settlement: string) =>
      `As of ${date}, the fastest officially stated settlement among Malaysian payment providers is ${name} at ${settlement}.`,
    instantH: "Real-time or same-day payout",
    instantP:
      "These gateways say on their own page that money can reach your bank instantly or on the same day, sometimes only on a paid plan, an add-on or for some payment methods. The condition is shown under each name.",
    source: "Source",
    rankedH: "Ranked by stated settlement (slowest leg)",
    sameDay: "Same day",
    nextDay: "Next business day",
    upTo: (d: number) => `Up to ${d} business days`,
    estFee: "est. fee",
    unstatedH: "Settlement not stated publicly",
    unstatedP:
      "These providers publish no official settlement time (or only a third-party figure), so we will not rank them on it. Listed by market presence; ask when you request a quote.",
    whatT1: "What does T+1 mean?",
    compare: "Compare side by side",
    browse: "Browse all providers",
    more: "More guides",
  },
  ms: {
    title: "Payment gateway dengan duit masuk paling cepat di Malaysia | MPG",
    description:
      "Payment gateway Malaysia disusun ikut tempoh duit masuk ke akaun yang dinyatakan secara rasmi: siapa bayar T+1, siapa ambil seminggu, dan siapa tak beritahu.",
    home: "Utama",
    learn: "Belajar",
    breadcrumb: "Laluan halaman",
    crumb: "Duit masuk paling cepat",
    h1: "Payment gateway dengan duit masuk paling cepat di Malaysia",
    lead: 'Tempoh duit masuk ialah bila duit jualan betul-betul sampai ke akaun bank anda. Ini lebih beri kesan pada aliran tunai anda berbanding beza kecil dalam caj. T+1 bermaksud sehari bekerja selepas jualan. Gateway di bawah disusun ikut tempoh duit masuk rasmi mereka, guna tempoh paling lambat yang dijanjikan (gateway yang tulis "T+1 hingga T+2" dikira T+2, supaya tak nampak lebih cepat daripada sebenarnya).',
    answer: (date: string, name: string, settlement: string) =>
      `Sehingga ${date}, tempoh duit masuk paling cepat yang dinyatakan secara rasmi antara payment gateway Malaysia ialah ${name}, iaitu ${settlement}.`,
    instantH: "Duit masuk serta-merta atau hari yang sama",
    instantP:
      "Gateway ini tulis di laman rasmi mereka bahawa duit boleh masuk ke bank anda serta-merta atau pada hari yang sama. Kadang-kadang cuma untuk pelan berbayar, tambahan berbayar atau cara bayar tertentu. Syaratnya ditulis di bawah setiap nama.",
    source: "Sumber",
    rankedH: "Disusun ikut tempoh duit masuk (ambil yang paling lambat)",
    sameDay: "Hari yang sama",
    nextDay: "Hari bekerja berikutnya",
    upTo: (d: number) => `Sehingga ${d} hari bekerja`,
    estFee: "anggaran caj",
    unstatedH: "Tempoh duit masuk tak disiarkan",
    unstatedP:
      "Gateway ini tak siarkan tempoh duit masuk rasmi (atau cuma ada angka pihak ketiga), jadi kami tak susun ikut tempoh ini. Senarai ini ikut siapa lebih dikenali di pasaran. Tanya mereka bila minta sebut harga.",
    whatT1: "Apa maksud T+1?",
    compare: "Banding sebelah-menyebelah",
    browse: "Lihat semua gateway",
    more: "Panduan lain",
  },
});

const entries = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
const gateways = entries.map(toApiGateway).filter((g) => g.category !== "infrastructure");
const asOf = gateways.map((g) => g.verified_date).sort().at(-1);

const parsed = gateways.map((g) => ({ g, days: parseSettlementDays(g.settlement) }));
const ranked = parsed
  .filter((x): x is { g: (typeof gateways)[number]; days: number } => x.days != null)
  .sort((a, b) => a.days - b.days || b.g.popularity - a.g.popularity || a.g.name.localeCompare(b.g.name));
const unstated = parsed
  .filter((x) => x.days == null)
  .map((x) => x.g)
  .sort((a, b) => b.popularity - a.popularity || a.name.localeCompare(b.name));

const site = (Astro.site?.href ?? "https://malaysiapg.com.my/").replace(/\/$/, "");
const top = ranked[0];
const answerLine = top
  ? T.answer(asOf && locale === "ms" ? formatDate(asOf, locale) : String(asOf), top.g.name, top.g.settlement)
  : undefined;

const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: T.h1,
    itemListElement: ranked.map((x, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: x.g.name,
      url: `${site}/gateway/${x.g.slug}/`,
    })),
  },
  breadcrumbLd(site, [
    { name: T.home, path: "/" },
    { name: T.learn, path: "/learn/" },
    { name: T.crumb },
  ]),
];

// real-time / same-day payout (reader request 2026-10-21): only gateways whose
// own page says so (gateway.instant_settlement, quoted with source)
const instant = (entries as (GatewayEntryLike & {
  data: GatewayEntryLike["data"] & {
    instant_settlement?: { detail: string; detail_ms: string; quote: string; source: string; checked: string };
  };
})[])
  .filter((e) => e.data.instant_settlement)
  .map((e) => ({ g: toApiGateway(e), s: e.data.instant_settlement! }))
  .sort((a, b) => b.g.popularity - a.g.popularity || a.g.name.localeCompare(b.g.name));

const dayLabel = (d: number) => (d === 0 ? T.sameDay : d === 1 ? T.nextDay : T.upTo(d));
---

<Base title={T.title} description={T.description}>
  <nav aria-label={T.breadcrumb} class="mb-4 flex items-center gap-2 text-sm text-muted">
    <a href="/" class="hover:text-fg hover:underline">{T.home}</a>
    <span aria-hidden="true">/</span>
    <a href="/learn/" class="hover:text-fg hover:underline">{T.learn}</a>
    <span aria-hidden="true">/</span>
    <span class="text-fg">{T.crumb}</span>
  </nav>

  <h1 class="max-w-3xl text-3xl font-bold tracking-tight text-fg sm:text-4xl">{T.h1}</h1>
  <p class="mt-4 max-w-3xl text-muted">{T.lead}</p>
  {answerLine && <p class="mt-3 max-w-3xl font-medium text-fg">{answerLine}</p>}

  {
    instant.length > 0 && (
      <section class="mt-12">
        <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">{T.instantH}</h2>
        <p class="mb-3 max-w-3xl text-sm text-muted">{T.instantP}</p>
        <ul class="divide-y divide-line border-y border-line">
          {instant.map((x) => (
            <li class="py-4">
              <div class="flex flex-wrap items-center gap-3">
                <Logo slug={x.g.slug} name={x.g.name} size={26} />
                <a href={`/gateway/${x.g.slug}/`} class="font-medium text-fg hover:underline">
                  {x.g.name}
                </a>
              </div>
              <p class="mt-2 pl-9 text-sm text-fg">{locale === "ms" ? x.s.detail_ms : x.s.detail}</p>
              <blockquote class="mt-2 ml-9 border-l-2 border-line pl-3 text-sm italic text-muted" lang="en">
                "{x.s.quote}"
              </blockquote>
              <p class="mt-1 pl-9 text-xs text-muted">
                {T.source}:{" "}
                <a href={x.s.source} target="_blank" rel="noopener noreferrer" class="hover:text-fg hover:underline" data-l10n="off">
                  {new URL(x.s.source).hostname.replace(/^www\./, "")}
                </a>
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mt-12">
    <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">
      {T.rankedH}
    </h2>
    <ol class="divide-y divide-line border-y border-line">
      {
        ranked.map((x, i) => (
          <li class="py-4">
            <div class="flex flex-wrap items-center gap-3">
              <span class="w-6 text-right font-semibold text-muted">{i + 1}.</span>
              <Logo slug={x.g.slug} name={x.g.name} size={26} />
              <a href={`/gateway/${x.g.slug}/`} class="font-medium text-fg hover:underline">
                {x.g.name}
              </a>
              <span class="ml-auto text-sm text-fg">{x.g.settlement}</span>
            </div>
            <p class="mt-2 pl-9 text-sm text-muted">
              {dayLabel(x.days)}
              {x.g.est_fee_rm100 != null && (
                <>
                  {" · "}{T.estFee} ~RM{x.g.est_fee_rm100.toFixed(2)} / RM100
                </>
              )}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-12">
    <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">
      {T.unstatedH}
    </h2>
    <p class="mb-3 max-w-3xl text-sm text-muted">{T.unstatedP}</p>
    <div class="flex flex-wrap gap-2">
      {
        unstated.map((g) => (
          <a
            href={`/gateway/${g.slug}/`}
            class="rounded-full border border-line bg-panel px-3 py-1 text-xs text-muted hover:text-fg"
          >
            {g.name}
          </a>
        ))
      }
    </div>
  </section>

  <div class="mt-8 flex flex-wrap gap-3">
    <a href="/learn/glossary/settlement/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      {T.whatT1}
    </a>
    <a href="/compare/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      {T.compare}
    </a>
    <a href="/gateways/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      {T.browse}
    </a>
  </div>

  <section class="mt-12 border-t border-line pt-6">
    <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">{T.more}</h2>
    <div class="flex flex-wrap gap-2">
      {
        PROFILES.map((p) => (
          <a
            href={`/best/${p.slug}/`}
            class="rounded-full border border-line bg-panel px-3 py-1 text-xs text-muted hover:text-fg"
          >
            {profileCopy(p, locale).h1}
          </a>
        ))
      }
    </div>
  </section>

  {jsonld.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</Base>
