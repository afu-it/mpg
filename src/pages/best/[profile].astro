---
// Programmatic SEO: one pre-rendered page per curated need profile (spec 10).
// All ranking flows through recommend() via seo-pages.ts, so the shortlist can
// never contradict /gateways, /choose, or the JSON API.
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import { toApiGateway, type GatewayEntryLike } from "../../lib/api";
import { PROFILES, buildProfilePage, profileJsonLd, headlineRates } from "../../lib/seo-pages";
import { breadcrumbLd } from "../../lib/jsonld";

export async function getStaticPaths() {
  return PROFILES.map((p) => ({ params: { profile: p.slug }, props: { def: p } }));
}

const { def } = Astro.props;

const entries = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
const gateways = entries.map(toApiGateway);
// citable "as of" date = the newest official verification across the directory
const asOf = gateways.map((g) => g.verified_date).sort().at(-1);
const page = buildProfilePage(gateways, def, 8, asOf);
const site = (Astro.site?.href ?? "https://malaysiapg.com.my/").replace(/\/$/, "");
const jsonld = [
  ...profileJsonLd(page, site),
  breadcrumbLd(site, [
    { name: "Home", path: "/" },
    { name: "Learn", path: "/learn/" },
    { name: def.h1 },
  ]),
];

const shortlist = [...page.ranked, ...page.onRequest];
const compareIds = shortlist.slice(0, 4).map((m) => m.gateway.slug).join(",");
const otherProfiles = PROFILES.filter((p) => p.slug !== def.slug);
---

<Base title={def.title} description={def.description}>
  <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-sm text-muted">
    <a href="/" class="hover:text-fg hover:underline">Home</a>
    <span aria-hidden="true">/</span>
    <a href="/learn/" class="hover:text-fg hover:underline">Learn</a>
    <span aria-hidden="true">/</span>
    <span class="text-fg">{def.h1}</span>
  </nav>

  <h1 class="text-2xl font-semibold tracking-tight text-fg">{def.h1}</h1>
  <p class="mt-2 max-w-3xl text-muted">{def.intro}</p>
  {page.answerLine && <p class="mt-3 max-w-3xl font-medium text-fg">{page.answerLine}</p>}

  {
    page.relaxed.length > 0 && (
      <p class="mt-4 rounded-md border border-line bg-panel px-4 py-3 text-sm text-muted">
        No provider matched every criterion, so we relaxed: {page.relaxed.join(", ")}.
      </p>
    )
  }

  {
    page.ranked.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">
          Ranked by estimated cost (published rates)
        </h2>
        <ol class="space-y-3">
          {page.ranked.map((m, i) => (
            <li class="rounded-md border border-line bg-panel p-4">
              <div class="flex flex-wrap items-center gap-3">
                <span class="w-6 text-right font-semibold text-muted">{i + 1}.</span>
                <Logo slug={m.gateway.slug} name={m.gateway.name} size={26} />
                <a href={`/gateway/${m.gateway.slug}/`} class="font-medium text-fg hover:underline">
                  {m.gateway.name}
                </a>
                <span class="ml-auto text-sm text-fg">
                  ~RM{m.gateway.est_fee_rm100!.toFixed(2)}
                  <span class="text-muted"> / RM100</span>
                </span>
              </div>
              <p class="mt-2 pl-9 text-sm text-muted">{m.gateway.tagline}</p>
              {headlineRates(m.gateway) && (
                <p class="mt-1 pl-9 text-xs text-muted">{headlineRates(m.gateway)}</p>
              )}
              {m.reasons.length > 0 && (
                <div class="mt-2 flex flex-wrap gap-2 pl-9">
                  {m.reasons.map((r) => (
                    <span class="rounded-full border border-line bg-raised px-2.5 py-0.5 text-xs text-muted">{r}</span>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    page.onRequest.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">
          Also fits, pricing on request
        </h2>
        <p class="mb-3 max-w-3xl text-sm text-muted">
          These providers match the same needs but publish no comparable rates, so we will not rank
          them by price. Listed by market presence.
        </p>
        <ul class="space-y-2">
          {page.onRequest.map((m) => (
            <li class="flex items-center gap-3 rounded-md border border-line bg-panel px-4 py-3">
              <Logo slug={m.gateway.slug} name={m.gateway.name} size={22} />
              <a href={`/gateway/${m.gateway.slug}/`} class="text-fg hover:underline">
                {m.gateway.name}
              </a>
              <span class="ml-auto text-sm text-muted">Contact sales</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="mt-8 flex flex-wrap gap-3">
    {
      compareIds && (
        <a
          href={`/compare/?ids=${compareIds}`}
          class="rounded-md bg-brand-blue px-4 py-2 text-sm font-medium text-white hover:opacity-90"
        >
          Compare the top picks
        </a>
      )
    }
    <a href="/choose/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      Answer 4 questions instead
    </a>
    <a href="/gateways/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      Browse all {gateways.length} providers
    </a>
  </div>

  <section class="mt-10">
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">FAQ</h2>
    <div class="space-y-4">
      {
        page.faqs.map((f) => (
          <div class="rounded-md border border-line bg-panel p-4">
            <h3 class="font-medium text-fg">{f.q}</h3>
            <p class="mt-1 text-sm text-muted">{f.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-10 border-t border-line pt-6">
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">More guides</h2>
    <div class="flex flex-wrap gap-2">
      {
        otherProfiles.map((p) => (
          <a
            href={`/best/${p.slug}/`}
            class="rounded-full border border-line bg-panel px-3 py-1 text-xs text-muted hover:text-fg"
          >
            {p.h1}
          </a>
        ))
      }
    </div>
  </section>

  {jsonld.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</Base>
