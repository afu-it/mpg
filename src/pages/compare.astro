---
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import MethodologyNote from "../components/MethodologyNote.astro";
import { breadcrumbLd } from "../lib/jsonld";

const crumbLd = breadcrumbLd(String(Astro.site ?? "https://malaysiapg.com.my/"), [
  { name: "Home", path: "/" },
  { name: "Compare" },
]);

const gateways = (await getCollection("gateways")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

// logo url map (same resolution as Logo.astro) so the client can render logos
const logos = import.meta.glob("/src/assets/logos/*.{svg,png,webp}", {
  eager: true,
  query: "?url",
  import: "default",
});
const logoBySlug: Record<string, string> = {};
for (const [path, url] of Object.entries(logos)) {
  const key = path.split("/").pop()!.replace(/\.\w+$/, "");
  if (!logoBySlug[key] || path.endsWith(".svg")) logoBySlug[key] = url as string;
}

const data = gateways.map((g) => ({
  id: g.id,
  name: g.data.name,
  category: g.data.category,
  website: g.data.website,
  settlement: g.data.settlement,
  min_txn: g.data.min_txn,
  channels: g.data.channels,
  features: g.data.features,
  fees: g.data.fees,
  methods: g.data.methods ?? [],
  banks: g.data.banks ?? [],
  mcp: g.data.mcp,
  webhooks: g.data.webhooks ?? null,
  plugins: g.data.plugins ?? [],
  logo: logoBySlug[g.id] ?? null,
}));

const presets = [
  { title: "Cheap FPX", desc: "Lowest flat FPX rates", ids: ["toyyibpay", "billplz", "bayarcash"] },
  { title: "Popular gateways", desc: "Widely used in Malaysia", ids: ["stripe-malaysia", "curlec", "ipay88", "fiuu"] },
  { title: "Best for cards", desc: "Low card processing rates", ids: ["kiple", "xendit", "hitpay"] },
  { title: "BNPL providers", desc: "Buy now, pay later", ids: ["atome", "spaylater", "ahapay"] },
];
---

<Base
  full
  title="Compare payment gateways · MPG"
  description="Compare up to four Malaysian payment gateways side by side: FPX, card, e-wallet and DuitNow QR fees, settlement times, features and supported banks."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbLd)} />
  <div class="mx-auto w-full max-w-[1400px] px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-sm text-muted">
      <a href="/" class="hover:text-fg hover:underline">Home</a>
      <span aria-hidden="true">/</span>
      <span class="text-fg">Compare</span>
    </nav>

    <header class="mb-8">
      <h1 class="max-w-3xl text-3xl font-bold tracking-tight text-fg sm:text-4xl">
        Compare payment gateways
      </h1>
      <p class="mt-4 max-w-2xl text-muted">
        Pick up to 4 gateways and compare fees, settlement, channels and
        features side by side. The lowest fee in each row is highlighted.
      </p>
    </header>

    <!-- preset shortcuts: quiet rows, same links (spec 16 rollout) -->
    <div class="mb-10 max-w-2xl">
      <p class="mb-3 text-xs font-medium uppercase tracking-widest text-muted">Preset comparisons</p>
      <ul class="divide-y divide-line border-y border-line">
        {
          presets.map((p) => (
            <li>
              <a
                href={`/compare/?ids=${p.ids.join(",")}`}
                class="group flex flex-wrap items-baseline gap-x-3 gap-y-0.5 px-1 py-3 hover:bg-panel"
              >
                <h2 class="text-sm font-medium text-fg">{p.title}</h2>
                <p class="text-xs text-muted">{p.desc}</p>
                <p class="ml-auto truncate text-xs text-muted group-hover:text-accent">
                  {p.ids.join(" · ")}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- comparison area (rendered by compare.ts) -->
    <div id="compare-root" class="overflow-x-auto"></div>

    <MethodologyNote />

    <!-- SEO copy kept verbatim, folded so the tool stays the page (spec 16 rollout) -->
    <section class="mt-10 border-t border-line pt-6">
      <details class="group max-w-3xl">
        <summary class="flex cursor-pointer select-none items-center gap-2 text-sm text-muted hover:text-fg [&::-webkit-details-marker]:hidden">
          <h2 class="font-medium">How this comparison works</h2>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-3.5 transition-transform group-open:rotate-180" aria-hidden="true">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Every figure comes from the provider's official pricing page and carries a verified
          date on its detail page. The side-by-side rows cover fees per channel, settlement
          speed, supported banks and e-wallets, and developer experience (API docs, webhooks,
          plugins, MCP). Fee strings in different units are made comparable through the
          estimated cost of a RM100 transaction, so a flat "RM1.00" and a "1.2%" rate can be
          compared honestly.
        </p>
        <h3 class="mt-5 text-sm font-medium text-fg">Picking between close providers</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          When estimated costs are within a few sen, decide on the other rows: settlement speed
          moves your cash flow, plugin support saves integration time, and quote-based
          providers may beat published rates at volume. Use the share link above to send this
          exact comparison to a teammate.
        </p>
      </details>
    </section>
  </div>

  <script type="application/json" id="gw-data" set:html={JSON.stringify(data)} />
  <script>
    import "../scripts/compare.ts";
  </script>
</Base>
