---
// Fee-change log page (spec 12 item 4): a dated, sourced freshness signal.
// Entries come from src/lib/fee-changes.ts, curated during fee audits.
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import { FEE_CHANGES, KIND_LABEL, KIND_LABEL_MS } from "../lib/fee-changes";
import { breadcrumbLd } from "../lib/jsonld";
import { getLocale, tr, formatDate } from "../i18n/locale";

const locale = getLocale(Astro);
const T = tr(locale, {
  en: {
    title: "Recent Malaysian payment gateway fee changes | MPG",
    description:
      "A dated log of Malaysian payment gateway fee changes: increases, newly published official rates, and rates quietly withdrawn, from our fee audits.",
    home: "Home",
    crumb: "Fee changes",
    h1: "Payment gateway fee changes",
    lead: "Every change we found when re-checking each provider's official pricing page, newest first.",
    logged: "Changes logged",
    lastChecked: "Last checked",
    all: "All",
    filter: "Filter by type of change",
    empty: "No changes of this type.",
    verified: (d: string) => `Verified ${d}`,
    directory: "Directory",
    howH: "How this log works",
    how: 'We periodically re-verify every fee in the directory against each provider\'s own pricing pages (the current pass covered all providers). A change only appears here when the official source itself changed; each provider\'s detail page carries the source link and verified date. If a provider stops publishing a figure, we mark it "Contact sales" rather than keep a stale number.',
    table: "Current fees table",
    calc: "Fee calculator",
  },
  ms: {
    title: "Perubahan fee payment gateway Malaysia terkini | MPG",
    description:
      "Log bertarikh perubahan fee payment gateway Malaysia: caj naik, kadar rasmi yang baru disiarkan, dan kadar yang ditarik balik senyap-senyap, dari semakan kami.",
    home: "Utama",
    crumb: "Perubahan fee",
    h1: "Perubahan fee payment gateway",
    lead: "Setiap perubahan yang kami jumpa semasa semak semula halaman harga rasmi setiap gateway. Yang terbaru di atas.",
    logged: "Perubahan dicatat",
    lastChecked: "Terakhir disemak",
    all: "Semua",
    filter: "Tapis ikut jenis perubahan",
    empty: "Tiada perubahan jenis ini.",
    verified: (d: string) => `Disemak ${d}`,
    directory: "Direktori",
    howH: "Macam mana log ini dibuat",
    how: 'Dari semasa ke semasa kami semak semula setiap fee dalam direktori ini dengan halaman harga rasmi setiap gateway (semakan terkini meliputi semua gateway). Perubahan hanya dicatat di sini bila sumber rasmi itu sendiri berubah. Halaman setiap gateway ada link sumber dan tarikh disemak. Kalau gateway berhenti siarkan sesuatu angka, kami tandakan "Hubungi jualan" dan tidak simpan angka lama.',
    table: "Jadual fee semasa",
    calc: "Kalkulator fee",
  },
});
const kindLabel = locale === "ms" ? KIND_LABEL_MS : KIND_LABEL;
const showDate = (d: string) => (locale === "ms" ? formatDate(d, locale) : d);

const site = (Astro.site?.href ?? "https://malaysiapg.com.my/").replace(/\/$/, "");

// existing slugs so entries about renamed/removed providers never emit dead links
const validSlugs = new Set((await getCollection("gateways")).map((g) => g.id));

const changes = [...FEE_CHANGES].sort((a, b) => b.observed.localeCompare(a.observed));
const byDate = new Map<string, typeof changes>();
for (const c of changes) {
  const list = byDate.get(c.observed) ?? [];
  list.push(c);
  byDate.set(c.observed, list);
}
// filter chips: only the kinds that actually occur, most frequent first
const kindCounts = [...changes.reduce((m, c) => m.set(c.kind, (m.get(c.kind) ?? 0) + 1), new Map<string, number>())]
  .sort((a, b) => b[1] - a[1]);

const crumbLd = JSON.stringify(
  breadcrumbLd(site, [{ name: T.home, path: "/" }, { name: T.crumb }]),
);

// dot colour per kind; the badge text carries the meaning, the dot is a scan aid
const KIND_DOT: Record<string, string> = {
  increase: "bg-brand-red-soft",
  decrease: "bg-brand-yellow",
  published: "bg-accent",
  unpublished: "bg-muted",
  correction: "bg-muted",
  listing: "bg-fg",
};
const chip =
  "inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 text-xs text-muted hover:border-muted hover:text-fg aria-pressed:border-fg aria-pressed:bg-raised aria-pressed:text-fg";
---

<Base title={T.title} description={T.description}>
  <script is:inline type="application/ld+json" set:html={crumbLd} />

  <header class="max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">{T.h1}</h1>
    <p class="mt-2 text-muted">{T.lead}</p>
  </header>

  <dl class="mt-6 grid max-w-md grid-cols-2 gap-3">
    <div class="rounded-xl border border-line bg-panel p-4">
      <dt class="text-xs font-medium uppercase tracking-widest text-muted">{T.logged}</dt>
      <dd class="mt-1 text-2xl font-semibold text-fg">{changes.length}</dd>
    </div>
    <div class="rounded-xl border border-line bg-panel p-4">
      <dt class="text-xs font-medium uppercase tracking-widest text-muted">{T.lastChecked}</dt>
      <dd class="mt-1 text-2xl font-semibold text-fg">{changes[0] && showDate(changes[0].observed)}</dd>
    </div>
  </dl>

  <div role="group" aria-label={T.filter} class="mt-8 flex flex-wrap gap-2" id="fc-filter">
    <button type="button" data-kind="all" aria-pressed="true" class={chip}>
      {T.all} <span class="text-muted">{changes.length}</span>
    </button>
    {
      kindCounts.map(([k, n]) => (
        <button type="button" data-kind={k} aria-pressed="false" class={chip}>
          <span class={`h-1.5 w-1.5 rounded-full ${KIND_DOT[k] ?? "bg-muted"}`} aria-hidden="true" />
          {kindLabel[k as keyof typeof kindLabel]} <span class="text-muted">{n}</span>
        </button>
      ))
    }
  </div>

  <ol class="mt-6 max-w-3xl">
    {
      [...byDate.entries()].map(([date, list]) => (
        <li class="fc-day relative grid gap-3 border-l border-line pb-8 pl-6 sm:grid-cols-[8rem_1fr] sm:border-l-0 sm:pl-0">
          <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full border border-line bg-surface sm:hidden" aria-hidden="true" />
          <h2 class="text-sm font-medium text-fg sm:pt-3">
            <time datetime={date}>{showDate(date)}</time>
          </h2>
          <ul class="space-y-2">
            {list.map((c) => {
              const linked = c.slug && validSlugs.has(c.slug);
              const name = c.slug == null && c.name === "Directory" ? T.directory : c.name;
              return (
                <li data-kind={c.kind} class="fc-item flex gap-3 rounded-xl border border-line bg-panel p-4">
                  <span class="mt-0.5 shrink-0">
                    {linked ? <Logo slug={c.slug!} name={c.name} size={28} /> : <img src="/logo-white.svg" alt="" width="28" height="28" class="h-7 w-7 opacity-70" />}
                  </span>
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                      {linked ? (
                        <a href={`/gateway/${c.slug}/`} class="font-semibold text-fg hover:underline">{name}</a>
                      ) : (
                        <span class="font-semibold text-fg">{name}</span>
                      )}
                      <span class="inline-flex items-center gap-1.5 text-xs text-muted">
                        <span class={`h-1.5 w-1.5 rounded-full ${KIND_DOT[c.kind] ?? "bg-muted"}`} aria-hidden="true" />
                        {kindLabel[c.kind]}
                      </span>
                    </div>
                    <p class="mt-1 text-sm text-muted">{locale === "ms" ? c.whatMs : c.what}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        </li>
      ))
    }
  </ol>
  <p id="fc-empty" class="hidden text-sm text-muted">{T.empty}</p>

  <details class="mt-4 max-w-3xl rounded-xl border border-line bg-panel p-5">
    <summary class="cursor-pointer font-semibold text-fg">{T.howH}</summary>
    <p class="mt-2 text-sm text-muted">{T.how}</p>
  </details>
  <div class="mt-4 flex flex-wrap gap-2 text-sm">
    <a href="/gateways/" class="rounded-full border border-line px-3 py-1 text-muted hover:border-muted hover:text-fg">{T.table}</a>
    <a href="/calculator/" class="rounded-full border border-line px-3 py-1 text-muted hover:border-muted hover:text-fg">{T.calc}</a>
  </div>

  <script>
    // type filter: hide non-matching entries, then any day left empty
    const bar = document.getElementById("fc-filter");
    const empty = document.getElementById("fc-empty");
    bar?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-kind]");
      if (!btn) return;
      const kind = btn.dataset.kind;
      bar.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      document.querySelectorAll<HTMLElement>(".fc-item").forEach((li) => {
        li.hidden = kind !== "all" && li.dataset.kind !== kind;
      });
      let shown = 0;
      document.querySelectorAll<HTMLElement>(".fc-day").forEach((day) => {
        day.hidden = !day.querySelector(".fc-item:not([hidden])");
        if (!day.hidden) shown++;
      });
      empty?.classList.toggle("hidden", shown > 0);
    });
  </script>
</Base>
