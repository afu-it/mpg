---
export const prerender = true;

import Base from "../layouts/Base.astro";
import { breadcrumbLd } from "../lib/jsonld";

const crumbLd = breadcrumbLd(String(Astro.site ?? "https://malaysiapg.com.my/"), [
  { name: "Home", path: "/" },
  { name: "Privacy" },
]);
const effective = "2026-07-03";
---

<Base
  title="Privacy policy · Malaysia Payment Gateway (MPG)"
  description="What data MPG collects and does not collect: cookieless Cloudflare analytics, optional Clerk sign-in, no ads, no tracking pixels and no selling of data."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbLd)} />
  <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-sm text-muted">
    <a href="/" class="hover:text-fg hover:underline">Home</a>
    <span aria-hidden="true">/</span>
    <span class="text-fg">Privacy</span>
  </nav>

  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-semibold tracking-tight text-fg">Privacy policy</h1>
    <p class="mt-2 text-sm text-muted">Effective {effective}</p>
    <p class="mt-3 text-muted">
      MPG is a static comparison directory. You can read everything on this site
      without an account, and we collect as little as the site can function with.
    </p>

    <section class="mt-8">
      <h2 class="text-lg font-semibold text-fg">What we collect</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-muted">
        <li>
          <span class="text-fg">Anonymous usage analytics.</span> We use Cloudflare
          Web Analytics, which is cookieless and does not fingerprint or track you
          across sites. We see aggregate page views, not individuals.
        </li>
        <li>
          <span class="text-fg">Account details, only if you sign up.</span> Sign-in
          is handled by Clerk. If you create an account (needed only for the
          contribute application), Clerk processes your email address and, if you
          use Google sign-in, your name and profile picture. We use this solely to
          identify contributors.
        </li>
        <li>
          <span class="text-fg">Email you send us.</span> The contribute form opens
          your own mail app; the application arrives as a normal email and is kept
          only for managing contributions.
        </li>
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="text-lg font-semibold text-fg">What we do not do</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-muted">
        <li>No advertising, ad networks or tracking pixels.</li>
        <li>No selling or sharing of personal data with third parties.</li>
        <li>No cookies set by MPG itself; only Clerk sets cookies, and only to keep you signed in.</li>
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="text-lg font-semibold text-fg">Service providers</h2>
      <p class="mt-3 text-muted">
        The site is served by Cloudflare Pages (hosting and CDN) and Cloudflare Web
        Analytics. Authentication is provided by{" "}
        <a href="https://clerk.com/legal/privacy" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Clerk</a>.
        Each processes data under its own privacy policy.
      </p>
    </section>

    <section class="mt-8">
      <h2 class="text-lg font-semibold text-fg">External links</h2>
      <p class="mt-3 text-muted">
        Gateway entries link to provider websites and official rate cards. Those
        sites have their own privacy practices, which we do not control.
      </p>
    </section>

    <section class="mt-8">
      <h2 class="text-lg font-semibold text-fg">Your choices</h2>
      <p class="mt-3 text-muted">
        You can browse without signing in. To delete an account or ask what is
        held about you, reach us via the{" "}
        <a href="/about/#contact" class="text-accent hover:underline">contact section on the About page</a>{" "}
        and we will handle it promptly.
      </p>
    </section>
  </div>
</Base>
