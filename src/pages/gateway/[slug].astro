---
export const prerender = true;

import { getCollection, render } from "astro:content";
import { splitName } from "../../lib/name";
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import FeeCell from "../../components/FeeCell.astro";
import FeatureBadge from "../../components/FeatureBadge.astro";
import { FPX_BANKS, FPX_BANKS_SOURCE } from "../../lib/fpx-banks";
import { skillRepoUrl, skillInstallCommand, agentPrompt } from "../../lib/learn";
import { accessInfo } from "../../lib/access";

export async function getStaticPaths() {
  const gateways = await getCollection("gateways");
  return gateways.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const hasUnofficial = Object.values(d.fees).some(
  (v) => typeof v === "string" && v.includes("*"),
);
const { base: nameBase, note: nameNote } = splitName(d.name);

const channelLabels: Record<string, string> = {
  fpx: "FPX",
  card: "Card",
  ewallet: "E-wallet",
  duitnowqr: "DuitNow QR",
  bnpl: "BNPL",
};

const feeRows = [
  { label: "FPX (online banking)", value: d.fees.fpx },
  { label: "Card (local credit/debit)", value: d.fees.card },
  ...(d.fees.card_intl ? [{ label: "International card", value: d.fees.card_intl }] : []),
  { label: "E-wallet", value: d.fees.ewallet },
  { label: "DuitNow QR", value: d.fees.duitnowqr },
  ...(d.fees.bnpl ? [{ label: "BNPL", value: d.fees.bnpl }] : []),
  { label: "Setup fee", value: d.fees.setup },
  { label: "Monthly / annual fee", value: d.fees.monthly },
  { label: "Minimum transaction", value: d.min_txn },
  { label: "Settlement", value: d.settlement },
];

const features = [
  { label: "No-code (links/forms)", on: d.features.no_code },
  { label: "Developer API", on: d.features.api },
  { label: "Recurring / subscription", on: d.features.recurring },
  ...(d.webhooks !== undefined ? [{ label: "Webhooks", on: d.webhooks }] : []),
];

const access = accessInfo(d.category);

const mcpLabel =
  d.mcp === "official"
    ? "MCP · Official"
    : d.mcp === "community"
      ? "MCP · Community"
      : "No MCP server";

// AI-agent prompt + install command, generated from the gateway's setup-* skill.
const prompt = d.skill ? agentPrompt(d.name, d.skill) : null;
const installCmd = d.skill ? skillInstallCommand(d.skill) : null;
---

<Base title={`${d.name} fees & features | MPG`} description={d.tagline}>
  <a href="/gateways" class="text-sm text-muted hover:text-fg">← All gateways</a>

  <header class="mt-4 flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-center gap-3">
      <Logo slug={entry.id} name={d.name} size={36} />
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl font-semibold tracking-tight text-fg">
            {nameBase}
            {nameNote && <span class="ml-2 text-base font-normal text-muted">{nameNote}</span>}
          </h1>
          {d.category === "bnpl" && (
            <span class="rounded-full bg-brand-red px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-white">
              BNPL
            </span>
          )}
          {d.category === "bank" && (
            <span class="rounded-full border border-line px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-muted">
              Bank
            </span>
          )}
          {d.category === "ewallet" && (
            <span class="rounded-full border border-line px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-muted">
              E-wallet
            </span>
          )}
        </div>
        <p class="text-muted">{d.tagline}</p>
      </div>
    </div>
    <a
      href={d.website}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-md bg-brand-blue px-4 py-2 text-sm font-medium text-white hover:opacity-90"
    >
      Visit website →
    </a>
  </header>

  <!-- supported channels -->
  <div class="mt-6 flex flex-wrap gap-2">
    {
      d.channels.map((c) => (
        <span class={`rounded-full border border-line bg-raised px-3 py-1 text-xs ${c === "duitnowqr" ? "text-duitnow" : c === "fpx" ? "text-fpx" : "text-fg"}`}>
          {channelLabels[c] ?? c}
        </span>
      ))
    }
  </div>

  <!-- how you access it: integrate vs apply for a merchant account -->
  <div class="mt-4 flex items-start gap-3 rounded-md border border-line bg-panel px-4 py-3">
    <span class="mt-0.5 shrink-0 rounded-full bg-raised px-2 py-0.5 text-xs font-medium text-accent">
      {access.short}
    </span>
    <p class="text-sm text-muted">{access.hint}</p>
  </div>

  <div class="mt-8 grid gap-8 md:grid-cols-2">
    <!-- fees -->
    <section>
      <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">Fees</h2>
      <div class="overflow-hidden rounded-md border border-line">
        <table class="w-full text-sm">
          <tbody>
            {
              feeRows.map((row, i) => (
                <tr class={i % 2 ? "bg-panel" : ""}>
                  <th scope="row" class={`px-3 py-2 text-left font-normal ${row.label === "DuitNow QR" ? "text-duitnow" : row.label.startsWith("FPX") ? "text-fpx" : "text-muted"}`}>
                    {row.label}
                  </th>
                  <td class="px-3 py-2 text-right">
                    <FeeCell value={row.value} />
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- features -->
    <section>
      <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">Features</h2>
      <ul class="space-y-2 rounded-md border border-line p-4">
        {
          features.map((f) => (
            <li class="flex items-center justify-between">
              <span class="text-fg">{f.label}</span>
              <FeatureBadge on={f.on} label={f.label} />
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <!-- developer experience -->
  <section class="mt-8">
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">
      Developer experience
    </h2>
    <div class="flex flex-wrap items-center gap-2">
      <span
        class={`rounded-full border px-3 py-1 text-xs font-medium ${
          d.mcp === "official"
            ? "border-accent text-accent"
            : d.mcp === "community"
              ? "border-line text-fg"
              : "border-line text-muted"
        }`}
        title="Model Context Protocol: lets AI agents/tools integrate the API"
      >
        {mcpLabel}
      </span>
      {
        d.dev_docs && (
          <a
            href={d.dev_docs}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-line px-3 py-1 text-xs text-accent hover:underline"
          >
            API docs →
          </a>
        )
      }
    </div>
    {
      d.plugins && d.plugins.length > 0 && (
        <div class="mt-3">
          <p class="mb-1.5 text-xs text-muted">E-commerce plugins</p>
          <div class="flex flex-wrap gap-2">
            {d.plugins.map((p) => (
              <span class="rounded-full border border-line bg-raised px-3 py-1 text-xs text-fg">
                {p}
              </span>
            ))}
          </div>
        </div>
      )
    }
    {
      d.skill && (
        <div class="mt-4 rounded-md border border-line bg-panel p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-muted">
            Integrate with an AI agent
          </p>
          <p class="mt-1 text-sm text-muted">
            Paste this into Claude Code, Cursor or Codex. It uses{" "}
            <a
              href={skillRepoUrl(d.skill)}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:underline"
            >
              <code class="text-fg">{d.skill}</code>
            </a>{" "}
            and the{" "}
            <a href="/learn/integration-flow" class="text-accent hover:underline">
              safe flow
            </a>
            .
          </p>
          <button
            type="button"
            data-copy={prompt}
            class="mt-3 flex w-full items-start justify-between gap-3 rounded border border-line bg-surface px-3 py-2 text-left hover:border-accent"
            title="Click to copy"
          >
            <span class="text-sm text-fg">{prompt}</span>
            <span data-copy-label class="shrink-0 text-xs font-medium text-accent">
              Copy prompt
            </span>
          </button>
          <p class="mt-2 text-xs text-muted">
            First install it:{" "}
            <button
              type="button"
              data-copy={installCmd}
              class="font-mono text-muted hover:text-accent"
              title="Click to copy"
            >
              <span data-copy-label>npx skills@latest add … --skill {d.skill}</span>
            </button>
          </p>
        </div>
      )
    }
  </section>

  <!-- other payment methods -->
  {
    d.methods && d.methods.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">
          Other payment methods
        </h2>
        <div class="flex flex-wrap gap-2">
          {d.methods.map((m) => (
            <span class="rounded-full border border-line bg-raised px-3 py-1 text-xs text-fg">
              {m}
            </span>
          ))}
        </div>
      </section>
    )
  }

  <!-- supported banks -->
  {
    (d.channels.includes("fpx") || (d.banks && d.banks.length > 0)) && (
      <section class="mt-8">
        <h2 class="mb-1 text-sm font-medium uppercase tracking-wide text-muted">
          Supported banks
        </h2>
        {d.channels.includes("fpx") && (
          <p class="mb-3 text-xs text-muted">
            Online banking via{" "}
            <a href={FPX_BANKS_SOURCE} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
              FPX
            </a>{" "}
            the national bank set:
          </p>
        )}
        <div class="flex flex-wrap gap-2">
          {(d.banks ?? []).map((b) => (
            <span class="rounded-full border border-line bg-raised px-3 py-1 text-xs text-fg">
              {b}
            </span>
          ))}
          {d.channels.includes("fpx") &&
            FPX_BANKS.map((b) => (
              <span class="rounded-full border border-line bg-raised px-3 py-1 text-xs text-fg">
                {b}
              </span>
            ))}
        </div>
      </section>
    )
  }

  <!-- long-form body -->
  <section class="prose-mpg mt-8 max-w-2xl space-y-4 leading-relaxed text-fg">
    <Content />
  </section>

  <!-- meta / provenance -->
  <footer class="mt-10 border-t border-line pt-4 text-xs text-muted">
    {
      d.skill && (
        <p>
          Integration skill:{" "}
          <a
            href={skillRepoUrl(d.skill)}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent hover:underline"
          >
            <code>{d.skill}</code>
          </a>
        </p>
      )
    }
    <p class="mt-1">
      Source:
      <a href={d.source} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
        {d.source}
      </a>
    </p>
    <p class="mt-1">Last verified {d.verified_date}.</p>
    {d.notes && <p class="mt-2 max-w-2xl">{d.notes}</p>}
    {
      hasUnofficial && (
        <p class="mt-2 max-w-2xl">
          <span class="text-fg">*</span> Indicative rate from a third-party source, not
          officially published. Always confirm with the provider.
        </p>
      )
    }
  </footer>
</Base>

<script>
  import "../../scripts/copy.ts";
</script>
