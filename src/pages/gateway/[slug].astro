---
export const prerender = true;

import { getCollection, render } from "astro:content";
import { splitName } from "../../lib/name";
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import FeeCell from "../../components/FeeCell.astro";
import FeatureBadge from "../../components/FeatureBadge.astro";
import { FPX_BANKS, FPX_BANKS_SOURCE } from "../../lib/fpx-banks";
import { skillRepoUrl, skillInstallCommand, agentPrompt } from "../../lib/learn";
import { accessInfo } from "../../lib/access";
import { gatewayCost, REF_TICKET } from "../../lib/fees";
import { vsPairs, alternativesTargets } from "../../lib/seo-pages";
import { toApiGateway, type GatewayEntryLike } from "../../lib/api";
import { breadcrumbLd } from "../../lib/jsonld";

export async function getStaticPaths() {
  const gateways = await getCollection("gateways");
  return gateways.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const hasUnofficial = Object.values(d.fees).some(
  (v) => typeof v === "string" && v.includes("*"),
);
const { base: nameBase, note: nameNote } = splitName(d.name);

const channelLabels: Record<string, string> = {
  fpx: "FPX",
  card: "Card",
  ewallet: "E-wallet",
  duitnowqr: "DuitNow QR",
  bnpl: "BNPL",
};

const feeRows = [
  { label: "FPX (online banking)", value: d.fees.fpx },
  { label: "Card (local credit/debit)", value: d.fees.card },
  ...(d.fees.card_intl ? [{ label: "International card", value: d.fees.card_intl }] : []),
  { label: "E-wallet", value: d.fees.ewallet },
  { label: "DuitNow QR", value: d.fees.duitnowqr },
  ...(d.fees.bnpl ? [{ label: "BNPL", value: d.fees.bnpl }] : []),
  { label: "Setup fee", value: d.fees.setup },
  { label: "Monthly / annual fee", value: d.fees.monthly },
  { label: "Minimum transaction", value: d.min_txn },
  { label: "Settlement", value: d.settlement },
];

const features = [
  { label: "No-code (links/forms)", on: d.features.no_code },
  { label: "Developer API", on: d.features.api },
  { label: "Recurring / subscription", on: d.features.recurring },
  ...(d.webhooks !== undefined ? [{ label: "Webhooks", on: d.webhooks }] : []),
];

const access = accessInfo(d.category);
// Blended estimated fee on a RM100 transaction (matches the directory ranking).
const est = gatewayCost(d.fees, REF_TICKET);

const mcpLabel =
  d.mcp === "official"
    ? "MCP · Official"
    : d.mcp === "community"
      ? "MCP · Community"
      : "No MCP server";

// AI-agent prompt + install command, generated from the gateway's setup-* skill.
const prompt = d.skill ? agentPrompt(d.name, d.skill) : null;
const installCmd = d.skill ? skillInstallCommand(d.skill) : null;

// SERP-friendly title/description: brand base name (notes like "(by Razorpay)"
// stay out of the title). Taglines run 37-75 chars, so this fixed suffix lands
// every description inside the 110-160 char SERP window.
// avoid "Stripe Malaysia Malaysia" when the brand name already ends in Malaysia
const titleBrand = nameBase.endsWith(" Malaysia") ? nameBase : `${nameBase} Malaysia`;
const pageTitle = `${titleBrand} fees & features | MPG`;
const pageDesc = `${d.tagline} Fees, settlement times and integrations, verified from official sources on MPG.`;

// head-to-head pages featuring this gateway (internal mesh for the /vs pages)
const allApi = ((await getCollection("gateways")) as unknown as GatewayEntryLike[]).map(toApiGateway);
const myVs = vsPairs(allApi).filter((p) => p.a.slug === entry.id || p.b.slug === entry.id);
const hasAlternativesPage = alternativesTargets(allApi).some((g) => g.slug === entry.id);

// entity signals: this page is ABOUT a third-party provider (never an Offer of
// MPG's own; fees here are the provider's merchant pricing, not our product)
const siteHref = String(Astro.site ?? "https://malaysiapg.com.my/");
const pageUrl = `${siteHref.replace(/\/$/, "")}/gateway/${entry.id}/`;
const detailLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": pageUrl,
    url: pageUrl,
    name: pageTitle,
    dateModified: d.verified_date,
    isPartOf: { "@id": `${siteHref}#website` },
    about: {
      "@type": "FinancialService",
      name: nameBase,
      url: d.website,
      description: d.tagline,
      areaServed: "MY",
    },
  },
  breadcrumbLd(siteHref, [
    { name: "Home", path: "/" },
    { name: "Gateways", path: "/gateways/" },
    { name: nameBase },
  ]),
];
---

<Base title={pageTitle} description={pageDesc}>
  <link
    slot="head"
    rel="alternate"
    type="application/json"
    href={`/api/gateways/${entry.id}.json`}
    title={`${nameBase} data (JSON)`}
  />
  {detailLd.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  <a href="/gateways/" class="text-sm text-muted hover:text-fg">← All gateways</a>

  <header class="mt-4 flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-center gap-3">
      <Logo slug={entry.id} name={d.name} size={36} />
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl font-semibold tracking-tight text-fg">
            {nameBase}
            {nameNote && <span class="ml-2 text-base font-normal text-muted">{nameNote}</span>}
          </h1>
          {d.category === "bnpl" && (
            <span class="rounded-full bg-brand-red px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-white">
              BNPL
            </span>
          )}
          {d.category === "bank" && (
            <span class="rounded-full border border-line px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-muted">
              Bank
            </span>
          )}
          {d.category === "ewallet" && (
            <span class="rounded-full border border-line px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-muted">
              E-wallet
            </span>
          )}
        </div>
        <p class="text-muted">{d.tagline}</p>
      </div>
    </div>
    <a
      href={d.website}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-md bg-brand-blue px-4 py-2 text-sm font-medium text-white hover:opacity-90"
    >
      Visit website →
    </a>
  </header>

  <!-- supported channels -->
  <div class="mt-6 flex flex-wrap gap-2">
    {
      d.channels.map((c) => (
        <span class={`rounded-full border border-line bg-raised px-3 py-1 text-xs ${c === "duitnowqr" ? "text-duitnow" : c === "fpx" ? "text-fpx" : "text-fg"}`}>
          {channelLabels[c] ?? c}
        </span>
      ))
    }
  </div>

  <!-- how you access it: integrate vs apply for a merchant account -->
  <p class="mt-4 text-sm text-muted">
    <span class="font-medium text-accent">{access.short}</span>
    <span class="px-1.5">·</span>
    {access.hint}
  </p>

  <!-- desktop: data column left, capabilities rail right; mobile: single stack -->
  <div class="mt-14 lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
    <div class="min-w-0">
      <!-- the one number visitors come for, as the page's centrepiece -->
      <section>
        {
          est.rankable ? (
            <p class="text-5xl font-bold tracking-tight text-fg sm:text-6xl">
              RM{est.cost.toFixed(2)}
            </p>
          ) : (
            <p class="text-4xl font-bold tracking-tight text-muted sm:text-5xl">On request</p>
          )
        }
        <p class="mt-3 text-sm text-muted">
          {est.rankable ? "est. fee per RM100 sale (FPX/card/e-wallet 50/30/20)" : "no comparable published rates"}
          {" · "}verified {d.verified_date} ·{" "}
          <a href={d.source} target="_blank" rel="noopener noreferrer" class="underline-offset-2 hover:text-fg hover:underline">
            official source
          </a>
        </p>
      </section>

      <!-- fee lines: quiet list, no container -->
      <section class="mt-10">
        <table class="w-full text-sm">
          <tbody class="divide-y divide-line border-y border-line">
            {
              feeRows.map((row) => (
                <tr>
                  <th scope="row" class={`py-3 text-left font-normal ${row.label === "DuitNow QR" ? "text-duitnow" : row.label.startsWith("FPX") ? "text-fpx" : "text-muted"}`}>
                    {row.label}
                  </th>
                  <td class="py-3 text-right">
                    <FeeCell value={row.value} />
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      <!-- published plans/tiers (spec 17): shown side by side so nobody has to
           dig through the provider's own site -->
      {
        d.plans && d.plans.length > 0 && (
          <section class="mt-12">
            <h2 class="text-xs font-medium uppercase tracking-wide text-muted">Plans</h2>
            <div class={`mt-4 grid gap-8 ${d.plans.length >= 3 ? "sm:grid-cols-3" : "sm:grid-cols-2"}`}>
              {d.plans.map((p) => (
                <div class="min-w-0">
                  <p class="font-semibold text-fg">{p.name}</p>
                  {p.eligibility && <p class="mt-0.5 text-xs text-muted">{p.eligibility}</p>}
                  <dl class="mt-3 divide-y divide-line border-y border-line text-sm">
                    {p.rows.map((r) => (
                      <div class="py-2.5">
                        <dt class="text-xs text-muted">{r.label}</dt>
                        <dd class="mt-0.5 text-fg">{r.value}</dd>
                      </div>
                    ))}
                    {p.settlement && (
                      <div class="py-2.5">
                        <dt class="text-xs text-muted">Settlement</dt>
                        <dd class="mt-0.5 text-fg">{p.settlement}</dd>
                      </div>
                    )}
                  </dl>
                  <p class="mt-2 text-xs text-muted">
                    <a
                      href={p.source ?? d.source}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline-offset-2 hover:text-fg hover:underline"
                    >
                      Official source →
                    </a>
                  </p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- long-form body -->
      <section class="prose-mpg mt-12 max-w-2xl space-y-4 leading-relaxed text-fg">
        <Content />
      </section>
    </div>

    <aside class="mt-12 space-y-10 lg:mt-0">
      <!-- features -->
      <section>
        <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">Features</h2>
        <ul class="space-y-2.5 text-sm">
          {
            features.map((f) => (
              <li class="flex items-center gap-2 text-muted">
                <FeatureBadge on={f.on} label={f.label} />
                {f.label}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- developer experience -->
      <section>
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">
      Developer experience
    </h2>
    <div class="flex flex-wrap items-center gap-2">
      <span
        class={`rounded-full border px-3 py-1 text-xs font-medium ${
          d.mcp === "official"
            ? "border-accent text-accent"
            : d.mcp === "community"
              ? "border-line text-fg"
              : "border-line text-muted"
        }`}
        title="Model Context Protocol: lets AI agents/tools integrate the API"
      >
        {mcpLabel}
      </span>
      {
        d.dev_docs && (
          <a
            href={d.dev_docs}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-line px-3 py-1 text-xs text-accent hover:underline"
          >
            API docs →
          </a>
        )
      }
    </div>
    {
      d.plugins && d.plugins.length > 0 && (
        <div class="mt-3">
          <p class="mb-1.5 text-xs text-muted">E-commerce plugins</p>
          <div class="flex flex-wrap gap-2">
            {d.plugins.map((p) => (
              <span class="rounded-full border border-line bg-raised px-3 py-1 text-xs text-fg">
                {p}
              </span>
            ))}
          </div>
        </div>
      )
    }
    {
      d.skill && (
        <details class="group mt-4 rounded-md border border-line bg-panel p-4">
          <summary class="flex cursor-pointer select-none items-center justify-between text-xs font-medium uppercase tracking-wide text-muted [&::-webkit-details-marker]:hidden">
            Integrate with an AI agent
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-3.5 transition-transform group-open:rotate-180" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <p class="mt-2 text-sm text-muted">
            Paste this into Claude Code, Cursor or Codex. It uses{" "}
            <a
              href={skillRepoUrl(d.skill)}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:underline"
            >
              <code class="text-fg">{d.skill}</code>
            </a>{" "}
            and the{" "}
            <a href="/learn/integration-flow/" class="text-accent hover:underline">
              safe flow
            </a>
            .
          </p>
          <button
            type="button"
            data-copy={prompt}
            class="mt-3 flex w-full items-start justify-between gap-3 rounded border border-line bg-surface px-3 py-2 text-left hover:border-accent"
            title="Click to copy"
          >
            <span class="text-sm text-fg">{prompt}</span>
            <span data-copy-label class="shrink-0 text-xs font-medium text-accent">
              Copy prompt
            </span>
          </button>
          <p class="mt-2 text-xs text-muted">
            First install it:{" "}
            <button
              type="button"
              data-copy={installCmd}
              class="font-mono text-muted hover:text-accent"
              title="Click to copy"
            >
              <span data-copy-label>npx skills@latest add … --skill {d.skill}</span>
            </button>
          </p>
        </details>
      )
    }
  </section>

      <!-- other payment methods: folded like the banks list (spec 16) -->
      {
        d.methods && d.methods.length > 0 && (
          <section>
        <details class="group">
          <summary class="flex cursor-pointer select-none items-center gap-2 text-sm font-medium uppercase tracking-wide text-muted [&::-webkit-details-marker]:hidden">
            Other payment methods ({d.methods.length})
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-3.5 transition-transform group-open:rotate-180" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <div class="mt-3 flex flex-wrap gap-2">
            {d.methods.map((m) => (
              <span class="rounded-full border border-line bg-raised px-3 py-1 text-xs text-fg">
                {m}
              </span>
            ))}
          </div>
        </details>
      </section>
    )
  }

  <!-- supported banks: collapsed by default (spec 16 slice F) — most FPX
       gateways share the same national set, so the wall of 18 chips folds away.
       Content stays in the DOM (indexed). -->
  {
    (d.channels.includes("fpx") || (d.banks && d.banks.length > 0)) && (
      <section>
        <details class="group">
          <summary class="flex cursor-pointer select-none items-center gap-2 text-sm font-medium uppercase tracking-wide text-muted [&::-webkit-details-marker]:hidden">
            Supported banks ({(d.banks?.length ?? 0) + (d.channels.includes("fpx") ? FPX_BANKS.length : 0)})
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-3.5 transition-transform group-open:rotate-180" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          {d.channels.includes("fpx") && (
            <p class="mb-3 mt-2 text-xs text-muted">
              Online banking via{" "}
              <a href={FPX_BANKS_SOURCE} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
                FPX
              </a>{" "}
              the national bank set:
            </p>
          )}
          <div class="mt-2 flex flex-wrap gap-2">
            {(d.banks ?? []).map((b) => (
              <span class="rounded-full border border-line bg-raised px-3 py-1 text-xs text-fg">
                {b}
              </span>
            ))}
            {d.channels.includes("fpx") &&
              FPX_BANKS.map((b) => (
                <span class="rounded-full border border-line bg-raised px-3 py-1 text-xs text-fg">
                  {b}
                </span>
              ))}
          </div>
        </details>
      </section>
    )
  }

    </aside>
  </div>

  <!-- meta / provenance: one compact block (spec 16 slice F) -->
  <footer class="mt-10 border-t border-line pt-4 text-xs text-muted">
    {
      myVs.length > 0 && (
        <div>
          <p class="text-fg">Head-to-head comparisons</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {myVs.slice(0, 6).map((p) => (
              <a
                href={`/vs/${p.slug}/`}
                class="rounded-full border border-line bg-panel px-3 py-1 text-xs text-muted hover:border-accent hover:text-fg"
              >
                {splitName(p.a.name).base} vs {splitName(p.b.name).base}
              </a>
            ))}
            {hasAlternativesPage && (
              <a
                href={`/alternatives/${entry.id}/`}
                class="rounded-full border border-line bg-panel px-3 py-1 text-xs text-muted hover:border-accent hover:text-fg"
              >
                {splitName(d.name).base} alternatives
              </a>
            )}
            {myVs.length > 6 && (
              <a href="/vs/" class="rounded-full px-3 py-1 text-xs text-accent hover:underline">
                All comparisons →
              </a>
            )}
          </div>
        </div>
      )
    }
    <p class="mt-4">
      Last verified {d.verified_date} ·{" "}
      <a href={d.source} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
        Official source
      </a>
      {d.skill && (
        <>
          {" "}·{" "}
          <a href={skillRepoUrl(d.skill)} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
            <code>{d.skill}</code>
          </a>
        </>
      )}
    </p>
    {d.notes && <p class="mt-2 max-w-2xl">{d.notes}</p>}
    {
      hasUnofficial && (
        <p class="mt-2 max-w-2xl">
          <span class="text-fg">*</span> Indicative rate from a third-party source, not
          officially published. Always confirm with the provider.
        </p>
      )
    }
  </footer>
</Base>

<script>
  import "../../scripts/copy.ts";
</script>
