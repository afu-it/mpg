---
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import FlagMY from "../components/FlagMY.astro";
import { toApiGateway, type GatewayEntryLike } from "../lib/api";

const gateways = await getCollection("gateways");
const total = gateways.length;

// data teaser: the 5 cheapest ranked gateways, straight from the same engine
// as /gateways — the homepage shows the product, not marketing sections
const ranked = (gateways as unknown as GatewayEntryLike[])
  .map((e) => ({ e, api: toApiGateway(e) }))
  .filter((x) => x.api.rankable && x.api.est_fee_rm100 != null)
  .sort((a, b) => a.api.est_fee_rm100! - b.api.est_fee_rm100!)
  .slice(0, 5);

// entity signals for Google (site is new; helps search + AI systems identify it)
const siteUrl = String(Astro.site);
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Malaysia Payment Gateway (MPG)",
      description: `Independent directory comparing fees and features of ${total} Malaysian payment providers: FPX, cards, e-wallets, DuitNow QR and BNPL.`,
      inLanguage: "en",
      publisher: { "@id": `${siteUrl}#organization` },
    },
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "Malaysia Payment Gateway (MPG)",
      url: siteUrl,
      logo: `${siteUrl}icon-512.png`,
      sameAs: ["https://github.com/afu-it/mpg"],
    },
  ],
});
---

<Base full title={`Compare Malaysian payment gateway fees: ${total} providers | MPG`}>
  <link
    slot="head"
    rel="alternate"
    type="application/json"
    href="/api/gateways.json"
    title="MPG gateways data (JSON)"
  />
  <script is:inline type="application/ld+json" set:html={jsonLd} />

  <!-- hero: one message, oversized type, nothing else competing -->
  <section class="mx-auto w-full max-w-4xl px-4 pb-16 pt-10 text-center sm:px-6 md:pt-16">
    <h1 class="text-4xl font-bold leading-[1.05] tracking-[-0.03em] text-white sm:text-6xl md:text-7xl">
      Every <span class="whitespace-nowrap">Malaysian<FlagMY class="ml-[0.15em] inline-block h-[0.8em] w-auto -translate-y-[0.05em] align-baseline" /></span> payment gateway, compared.
    </h1>
    <p class="mx-auto mt-6 text-base text-muted sm:text-lg">
      {total} providers · every fee from official sources · free and independent
    </p>
    <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
      <a
        href="/gateways/"
        class="inline-flex h-12 items-center justify-center rounded-md bg-brand-blue px-8 text-sm font-medium text-white hover:opacity-90"
      >
        Browse gateways
      </a>
      <a
        href="/choose/"
        class="inline-flex h-12 items-center justify-center rounded-md border border-line px-8 text-sm font-medium text-fg hover:border-accent"
      >
        Help me choose
      </a>
    </div>
  </section>

  <!-- the product itself, quietly: cheapest ranked right now -->
  <section class="mx-auto w-full max-w-xl px-4 pb-20 sm:px-6">
    <p class="mb-3 text-center text-xs font-medium uppercase tracking-widest text-muted">
      Cheapest ranked today · est. per RM100 sale
    </p>
    <ol class="divide-y divide-line border-y border-line">
      {
        ranked.map(({ e, api }) => (
          <li>
            <a
              href={`/gateway/${e.id}/`}
              class="flex items-center gap-3 px-2 py-3.5 hover:bg-panel"
            >
              <Logo slug={e.id} name={e.data.name} size={20} />
              <span class="font-medium text-fg">{api.name}</span>
              <span class="ml-auto tabular-nums text-muted">
                RM{api.est_fee_rm100!.toFixed(2)}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="mt-4 text-center">
      <a href="/gateways/" class="text-sm text-accent underline-offset-4 hover:underline">
        View all {total} →
      </a>
    </p>
  </section>

  <!-- SEO definition block: kept verbatim for search + AI, folded so the page stays quiet -->
  <section class="mx-auto w-full max-w-2xl px-4 pb-24 sm:px-6">
    <details class="group">
      <summary class="flex cursor-pointer select-none items-center justify-center gap-2 text-sm text-muted hover:text-fg [&::-webkit-details-marker]:hidden">
        <h2 class="font-medium">What is a payment gateway in Malaysia?</h2>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-3.5 transition-transform group-open:rotate-180" aria-hidden="true">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </summary>
      <p class="mt-4 text-sm leading-relaxed text-muted">
        A payment gateway is the service that lets your website or app accept money from
        Malaysian customers: FPX online banking transfers, credit and debit cards, e-wallets
        like Touch 'n Go and GrabPay, DuitNow QR, and buy-now-pay-later plans. The gateway
        collects the payment, takes a fee per transaction, and settles the balance to your
        bank account, typically within one to three working days. Fees, settlement speed and
        integration effort differ widely between providers, which is exactly what this
        directory compares, using only officially published rates.
      </p>
    </details>
  </section>
</Base>
