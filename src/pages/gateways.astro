---
export const prerender = true;

import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import GatewayTable from "../components/GatewayTable.astro";
import { getCollection } from "astro:content";
import { getLocale, tr } from "../i18n/locale";
import { PROFILES, profileCopy } from "../lib/seo-pages";
import { PLATFORMS } from "../lib/platform-guides";

const locale = getLocale(Astro);
// provider count comes from the content collection, so the title never goes stale
const count = (await getCollection("gateways")).length;
const T = tr(locale, {
  en: {
    title: `Malaysia payment gateway list: ${count} providers, fees compared · MPG`,
    description:
      "Every Malaysian payment gateway, bank, e-wallet and BNPL provider in one sortable list: FPX, card and e-wallet fees, settlement and features, cheapest first.",
    shortlists: "Shortlists by need",
    platformGuide: (name: string) => `${name} payment gateways`,
    jsonTitle: "MPG gateways data (JSON)",
    filters: "Filters",
    closeFilters: "Close filters",
    h1: "Find the cheapest gateway for your sales",
    lead: "Filter by FPX, card or e-wallet, then open any row for the full price list. Cheapest first, worked out on a RM100 sale; gateways that don't publish prices sit at the bottom.",
    sort: "Sort:",
    sortGateways: "Sort gateways",
    lowest: "Lowest fees",
    popularity: "Popularity",
    fpx: "Lowest FPX",
    card: "Lowest card",
    ewallet: "Lowest e-wallet",
    nameAsc: "Name A-Z",
    nameDesc: "Name Z-A",
    search: "Search gateway…",
    clearAll: "Clear all",
    removeFilter: "Remove filter",
    searchLabel: "Search payment gateways by name",
  },
  ms: {
    title: `Senarai payment gateway Malaysia: ${count} penyedia, banding fee · MPG`,
    description:
      "Senarai semua payment gateway, bank, e-wallet dan penyedia BNPL di Malaysia: caj FPX, kad dan e-wallet, tempoh duit masuk dan ciri, paling murah di atas.",
    shortlists: "Senarai pendek ikut keperluan",
    platformGuide: (name: string) => `Payment gateway untuk ${name}`,
    jsonTitle: "Data gateway MPG (JSON)",
    filters: "Penapis",
    closeFilters: "Tutup penapis",
    h1: "Cari gateway paling murah untuk jualan anda",
    lead: "Tapis ikut FPX, kad atau e-wallet, kemudian klik mana-mana baris untuk senarai harga penuh. Paling murah di atas (dikira untuk jualan RM100). Gateway yang tak siarkan harga diletak paling bawah.",
    sort: "Susun:",
    sortGateways: "Susun gateway",
    lowest: "Caj paling rendah",
    popularity: "Populariti",
    fpx: "FPX paling murah",
    card: "Kad paling murah",
    ewallet: "E-wallet paling murah",
    nameAsc: "Nama A-Z",
    nameDesc: "Nama Z-A",
    search: "Cari gateway…",
    clearAll: "Kosongkan semua",
    removeFilter: "Buang penapis",
    searchLabel: "Cari payment gateway ikut nama",
  },
});
// crawlable links from the directory into the shortlist pages (SEO round 2026-10)
const SHORTLIST_SLUGS = [
  "cheapest-payment-gateway-malaysia",
  "payment-gateway-malaysia",
  "payment-gateway-fpx",
  "payment-gateway-duitnow-qr",
  "payment-gateway-physical-store",
  "payment-gateway-api",
  "payment-gateway-recurring",
];
const shortlists = [
  ...SHORTLIST_SLUGS.flatMap((slug) => {
    const def = PROFILES.find((p) => p.slug === slug);
    return def ? [{ href: `/best/${slug}/`, label: profileCopy(def, locale).h1 }] : [];
  }),
  ...PLATFORMS.map((p) => ({ href: `/learn/${p.slug}/`, label: T.platformGuide(p.name) })),
];
---

<Base
  full
  title={T.title}
  description={T.description}
>
  <link
    slot="head"
    rel="alternate"
    type="application/json"
    href="/api/gateways.json"
    title={T.jsonTitle}
  />
  <div class="flex w-full flex-col md:flex-row">
    <!-- filter sidebar: sticky column on desktop, LEFT DRAWER on mobile (spec 14).
         Same DOM either way, so table.ts filter wiring is untouched. -->
    <div
      id="gw-filters-scrim"
      hidden
      class="fixed inset-0 z-30 bg-black/50 md:hidden"
      aria-hidden="true"
    >
    </div>
    <aside
      id="gw-filters"
      class="fixed inset-y-0 left-0 z-40 w-80 max-w-[85vw] -translate-x-full overflow-y-auto border-r border-line bg-surface px-4 py-5 transition-transform duration-200 data-[open]:translate-x-0 motion-reduce:transition-none md:sticky md:top-14 md:z-auto md:h-[calc(100vh-3.5rem)] md:w-60 md:shrink-0 md:translate-x-0 md:border-b-0 md:py-6"
      aria-label={T.filters}
    >
      <div class="mb-4 flex items-center justify-between md:hidden">
        <span class="text-sm font-medium text-fg">{T.filters}</span>
        <button
          type="button"
          id="gw-filters-close"
          aria-label={T.closeFilters}
          class="flex size-11 items-center justify-center rounded-md text-muted hover:bg-panel hover:text-fg"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-5" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <Sidebar />
    </aside>

    <!-- main: full remaining width -->
    <div class="min-w-0 flex-1 px-4 py-6 sm:px-6">
      <div class="mb-4 max-w-3xl">
        <h1 class="text-2xl font-semibold tracking-tight text-fg">
          {T.h1}
        </h1>
        <p class="mt-1 text-sm text-muted">
          {T.lead}
        </p>
      </div>

      <!-- toolbar: search + sort, then active-filter chips and the count, directly above the table -->
      <GatewayTable>
        <div slot="controls" class="flex w-full flex-wrap items-center gap-3 sm:flex-nowrap">
        <!-- search: the main control, grows to fill the row; "/" focuses it -->
        <div class="relative w-full sm:order-first sm:flex-1">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <input
            id="gw-search"
            type="search"
            placeholder={T.search}
            autocomplete="off"
            aria-label={T.searchLabel}
            aria-keyshortcuts="/"
            class="h-10 w-full rounded-md border border-line bg-panel pl-9 pr-10 text-fg placeholder:text-muted focus:border-accent focus:outline-none"
          />
          <kbd class="pointer-events-none absolute right-2.5 top-1/2 hidden -translate-y-1/2 rounded border border-line px-1.5 text-xs text-muted sm:block" aria-hidden="true">/</kbd>
        </div>
        <!-- mobile: open the filter drawer -->
        <button
          type="button"
          id="gw-filters-open"
          aria-controls="gw-filters"
          aria-expanded="false"
          class="inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-md border border-line bg-panel px-3 text-sm text-muted transition-colors hover:border-accent hover:text-fg md:hidden"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
          </svg>
          {T.filters}
          <span id="gw-filters-count" hidden class="rounded-full bg-brand-blue px-2 py-0.5 text-xs font-medium text-white"></span>
        </button>
        <!-- sort dropdown: right of the search box -->
        <div id="gw-sort" class="relative min-w-0 flex-1 sm:flex-none">
          <button
            type="button"
            id="gw-sort-trigger"
            aria-haspopup="menu"
            aria-expanded="false"
            class="inline-flex h-10 w-full items-center justify-start gap-1.5 rounded-md border border-line bg-panel px-3 text-sm text-muted transition-colors hover:border-accent hover:text-fg focus:border-accent focus:outline-none sm:w-60"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-3.5 shrink-0"
              aria-hidden="true"
            >
              <path d="m3 16 4 4 4-4"></path>
              <path d="M7 20V4"></path>
              <path d="m21 8-4-4-4 4"></path>
              <path d="M17 4v16"></path>
            </svg>
            <span class="hidden text-muted/80 sm:inline">{T.sort}</span>
            <span id="gw-sort-label" class="min-w-0 flex-1 truncate text-left text-fg">{T.lowest}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              class="size-4 shrink-0"
            >
              <path
                fill-rule="evenodd"
                d="M11.47 4.72a.75.75 0 0 1 1.06 0l3.75 3.75a.75.75 0 0 1-1.06 1.06L12 6.31 8.78 9.53a.75.75 0 0 1-1.06-1.06l3.75-3.75Zm-3.75 9.75a.75.75 0 0 1 1.06 0L12 17.69l3.22-3.22a.75.75 0 1 1 1.06 1.06l-3.75 3.75a.75.75 0 0 1-1.06 0l-3.75-3.75a.75.75 0 0 1 0-1.06Z"
                clip-rule="evenodd"></path>
            </svg>
          </button>
          <ul
            id="gw-sort-menu"
            role="menu"
            aria-label={T.sortGateways}
            hidden
            class="absolute left-0 z-40 mt-1 w-full min-w-[12rem] overflow-hidden rounded-md border border-line bg-panel py-1 shadow-lg"
          >
            {
              [
                { key: "value", label: T.lowest, checked: true },
                { key: "popularity", label: T.popularity, checked: false },
                { key: "fpx", label: T.fpx, checked: false },
                { key: "card", label: T.card, checked: false },
                { key: "ewallet", label: T.ewallet, checked: false },
                { key: "name-asc", label: T.nameAsc, checked: false },
                { key: "name-desc", label: T.nameDesc, checked: false },
              ].map((o) => (
                <li role="none">
                  <button
                    type="button"
                    role="menuitemradio"
                    aria-checked={o.checked ? "true" : "false"}
                    data-sort-key={o.key}
                    data-sort-label={o.label}
                    class="group flex w-full items-center gap-2 px-3 py-1.5 text-left text-sm text-muted transition-colors hover:bg-surface hover:text-fg aria-checked:text-fg"
                  >
                    <span class="flex-1">{o.label}</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                      class="size-4 shrink-0 text-accent opacity-0 group-aria-checked:opacity-100"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
        </div>
        <div slot="chips" id="gw-chips" hidden class="contents" data-remove-label={T.removeFilter}>
          <ul id="gw-chip-list" class="contents" aria-label={T.filters}></ul>
          <button type="button" id="gw-chips-clear" class="text-sm text-muted underline-offset-2 hover:text-fg hover:underline">{T.clearAll}</button>
          <span class="text-line" aria-hidden="true">|</span>
          <template id="gw-chip-tpl">
          <li>
            <button type="button" class="inline-flex h-7 items-center gap-1.5 rounded-full border border-line bg-panel pl-3 pr-2 text-xs text-fg transition-colors hover:border-accent">
              <span data-chip-label></span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-3.5 text-muted" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
            </button>
          </li>
          </template>
        </div>
      </GatewayTable>

      <nav aria-labelledby="gw-shortlists" class="mt-10 border-t border-line pt-6">
        <h2 id="gw-shortlists" class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">{T.shortlists}</h2>
        <ul class="flex flex-wrap gap-2">
          {
            shortlists.map((l) => (
              <li>
                <a href={l.href} class="rounded-full border border-line bg-panel px-3 py-1 text-xs text-muted hover:text-fg">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</Base>
