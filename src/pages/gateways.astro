---
export const prerender = true;

import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import GatewayTable from "../components/GatewayTable.astro";
---

<Base
  full
  title="All Malaysian payment gateways, fees compared · MPG"
  description="Sortable table of every Malaysian payment gateway, bank, e-wallet and BNPL provider: FPX, card and e-wallet fees, settlement and features, ranked by cost."
>
  <link
    slot="head"
    rel="alternate"
    type="application/json"
    href="/api/gateways.json"
    title="MPG gateways data (JSON)"
  />
  <div class="flex w-full flex-col md:flex-row">
    <!-- filter sidebar: sticky column on desktop, LEFT DRAWER on mobile (spec 14).
         Same DOM either way, so table.ts filter wiring is untouched. -->
    <div
      id="gw-filters-scrim"
      hidden
      class="fixed inset-0 z-30 bg-black/50 md:hidden"
      aria-hidden="true"
    >
    </div>
    <aside
      id="gw-filters"
      class="fixed inset-y-0 left-0 z-40 w-80 max-w-[85vw] -translate-x-full overflow-y-auto border-r border-line bg-surface px-4 py-5 transition-transform duration-200 data-[open]:translate-x-0 motion-reduce:transition-none md:sticky md:top-14 md:z-auto md:h-[calc(100vh-3.5rem)] md:w-60 md:shrink-0 md:translate-x-0 md:border-b-0 md:py-6"
      aria-label="Filters"
    >
      <div class="mb-4 flex items-center justify-between md:hidden">
        <span class="text-sm font-medium text-fg">Filters</span>
        <button
          type="button"
          id="gw-filters-close"
          aria-label="Close filters"
          class="flex size-11 items-center justify-center rounded-md text-muted hover:bg-panel hover:text-fg"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-5" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <Sidebar />
    </aside>

    <!-- main: full remaining width -->
    <div class="min-w-0 flex-1 px-4 py-6 sm:px-6">
      <div class="mb-5 flex flex-wrap items-center gap-3">
        <div class="mr-auto">
          <h1 class="text-2xl font-semibold tracking-tight text-fg">
            Malaysian payment gateway fees, compared
          </h1>
          <p class="mt-1 text-sm text-muted">
            Ranked by lowest estimated fee (RM100 basket) by default. Gateways without
            comparable published rates show "On request" below. Click a column to re-sort.
          </p>
        </div>
        <!-- mobile: open the filter drawer -->
        <button
          type="button"
          id="gw-filters-open"
          aria-controls="gw-filters"
          aria-expanded="false"
          class="inline-flex h-11 w-full items-center justify-center gap-2 rounded-md border border-line bg-panel px-3 text-sm text-muted transition-colors hover:border-accent hover:text-fg md:hidden"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
          </svg>
          Filters
          <span id="gw-filters-count" hidden class="rounded-full bg-brand-blue px-2 py-0.5 text-xs font-medium text-white"></span>
        </button>
        <!-- sort dropdown: sits to the left of the search box -->
        <div id="gw-sort" class="relative w-full sm:w-auto">
          <button
            type="button"
            id="gw-sort-trigger"
            aria-haspopup="menu"
            aria-expanded="false"
            class="inline-flex h-9 w-full items-center justify-start gap-1.5 rounded-md border border-line bg-panel px-3 text-sm text-muted transition-colors hover:border-accent hover:text-fg focus:border-accent focus:outline-none sm:w-48"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-3.5 shrink-0"
              aria-hidden="true"
            >
              <path d="m3 16 4 4 4-4"></path>
              <path d="M7 20V4"></path>
              <path d="m21 8-4-4-4 4"></path>
              <path d="M17 4v16"></path>
            </svg>
            <span class="text-muted/80">Sort:</span>
            <span id="gw-sort-label" class="min-w-0 flex-1 truncate text-left text-fg">Lowest fees</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              class="size-4 shrink-0"
            >
              <path
                fill-rule="evenodd"
                d="M11.47 4.72a.75.75 0 0 1 1.06 0l3.75 3.75a.75.75 0 0 1-1.06 1.06L12 6.31 8.78 9.53a.75.75 0 0 1-1.06-1.06l3.75-3.75Zm-3.75 9.75a.75.75 0 0 1 1.06 0L12 17.69l3.22-3.22a.75.75 0 1 1 1.06 1.06l-3.75 3.75a.75.75 0 0 1-1.06 0l-3.75-3.75a.75.75 0 0 1 0-1.06Z"
                clip-rule="evenodd"></path>
            </svg>
          </button>
          <ul
            id="gw-sort-menu"
            role="menu"
            aria-label="Sort gateways"
            hidden
            class="absolute left-0 z-20 mt-1 w-full min-w-[12rem] overflow-hidden rounded-md border border-line bg-panel py-1 shadow-lg"
          >
            {
              [
                { key: "value", label: "Lowest fees", checked: true },
                { key: "popularity", label: "Popularity", checked: false },
                { key: "fpx", label: "Lowest FPX", checked: false },
                { key: "card", label: "Lowest card", checked: false },
                { key: "ewallet", label: "Lowest e-wallet", checked: false },
                { key: "name-asc", label: "Name A-Z", checked: false },
                { key: "name-desc", label: "Name Z-A", checked: false },
              ].map((o) => (
                <li role="none">
                  <button
                    type="button"
                    role="menuitemradio"
                    aria-checked={o.checked ? "true" : "false"}
                    data-sort-key={o.key}
                    data-sort-label={o.label}
                    class="group flex w-full items-center gap-2 px-3 py-1.5 text-left text-sm text-muted transition-colors hover:bg-surface hover:text-fg aria-checked:text-fg"
                  >
                    <span class="flex-1">{o.label}</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                      class="size-4 shrink-0 text-accent opacity-0 group-aria-checked:opacity-100"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
        <input
          id="gw-search"
          type="search"
          placeholder="Search gateway…"
          autocomplete="off"
          aria-label="Search payment gateways by name"
          class="h-9 w-full rounded-md border border-line bg-panel px-3 text-fg placeholder:text-muted focus:border-accent sm:w-72"
        />
      </div>

      <GatewayTable />
    </div>
  </div>
</Base>
