---
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const gateways = (await getCollection("gateways")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

// logo url map (same resolution as Logo.astro / compare.astro)
const logos = import.meta.glob("/src/assets/logos/*.{svg,png,webp}", {
  eager: true,
  query: "?url",
  import: "default",
});
const logoBySlug: Record<string, string> = {};
for (const [path, url] of Object.entries(logos)) {
  const key = path.split("/").pop()!.replace(/\.\w+$/, "");
  if (!logoBySlug[key] || path.endsWith(".svg")) logoBySlug[key] = url as string;
}

const meta = gateways.map((g) => ({
  id: g.id,
  name: g.data.name,
  category: g.data.category,
  tagline: g.data.tagline,
  logo: logoBySlug[g.id] ?? null,
}));
---

<Base
  title="My favourites — MPG"
  description="Your saved Malaysian payment gateways and comparison sets."
>
  <header class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight text-fg">My favourites</h1>
    <p class="mt-2 max-w-2xl text-muted">
      Gateways and comparison sets you've saved. Synced to your account across devices.
    </p>
  </header>

  <!-- signed-out prompt (shown by favourites.ts when no user) -->
  <div
    id="fav-signedout"
    hidden
    class="rounded-lg border border-dashed border-line p-10 text-center"
  >
    <p class="text-muted">Sign in to save gateways and comparisons.</p>
    <p class="mt-1 text-sm text-muted">
      Use the <span class="text-fg">Sign up</span> button in the top-right, then favourite any gateway with its ♥.
    </p>
  </div>

  <!-- signed-in content (revealed by favourites.ts) -->
  <div id="fav-root" hidden class="space-y-10">
    <section>
      <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">
        Saved gateways
      </h2>
      <p id="fav-empty" hidden class="text-sm text-muted">
        No favourites yet — tap the ♥ on any gateway to save it.
      </p>
      <div id="fav-list" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
    </section>

    <section>
      <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">
        Saved comparisons
      </h2>
      <p id="cmp-empty" hidden class="text-sm text-muted">
        No saved comparisons — build one on the
        <a href="/compare" class="text-accent hover:underline">Compare</a> page and hit Save.
      </p>
      <div id="cmp-list" class="grid gap-3 sm:grid-cols-2"></div>
    </section>
  </div>

  <script type="application/json" id="gw-meta" set:html={JSON.stringify(meta)} />
</Base>
