---
// Programmatic SEO: one pre-rendered head-to-head page per curated pair
// (spec 10). Fee strings pass through the same semantics as the rest of the
// site: official values plain, third-party values carry a trailing *, unknown
// values stay "Contact sales" or "—". Nothing is fabricated.
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import FeeCell from "../../components/FeeCell.astro";
import { parseFeeShape, effectiveCost } from "../../lib/fees";
import { toApiGateway, type GatewayEntryLike } from "../../lib/api";
import { vsPairs, buildVsPage } from "../../lib/seo-pages";
import { breadcrumbLd } from "../../lib/jsonld";
import { splitName } from "../../lib/name";
import { getLocale, tr, localizePath } from "../../i18n/locale";
import { gatewayMs } from "../../i18n/content";

export async function getStaticPaths() {
  const entries = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
  const gateways = entries.map(toApiGateway);
  return vsPairs(gateways).map((pair) => ({ params: { pair: pair.slug }, props: { pair } }));
}

const { pair } = Astro.props;
const locale = getLocale(Astro);
const page = buildVsPage(pair, locale);
const { a, b } = pair;
// BM settlement wording from the gateway overlays, English figures otherwise
const [msA, msB] = await Promise.all([gatewayMs(a.slug, locale), gatewayMs(b.slug, locale)]);
const settleRow = page.feeRows.find((r) => r.key === "settlement");
if (settleRow) {
  settleRow.a = msA?.data.settlement ?? settleRow.a;
  settleRow.b = msB?.data.settlement ?? settleRow.b;
}
const hasIndicative = [...page.feeRows, ...page.featureRows].some(
  (r) => r.a.includes("*") || r.b.includes("*"),
);
// winner highlight (2026-07-17, AFU): bold + colour the cheaper side of a row
// when BOTH sides publish comparable official figures (indicative * and
// Contact sales never win). Lower is better for every row in this set.
const LOWER_BETTER = new Set(["est", "fpx", "card", "card_intl", "ewallet", "duitnowqr", "bnpl", "setup"]);
function rowCost(key: string, v: string): number {
  if (key === "est") {
    const m = String(v).match(/RM(\d+(?:\.\d+)?)/);
    return m ? parseFloat(m[1]) : Infinity;
  }
  const shape = parseFeeShape(String(v));
  if (shape.indicative) return Infinity;
  return effectiveCost(shape, 100);
}
function winnerOf(r: { key: string; a: string; b: string }): "a" | "b" | null {
  if (!LOWER_BETTER.has(r.key)) return null;
  const ca = rowCost(r.key, r.a);
  const cb = rowCost(r.key, r.b);
  if (!isFinite(ca) || !isFinite(cb) || ca === cb) return null;
  return ca < cb ? "a" : "b";
}

const T = tr(locale, {
  en: {
    home: "Home",
    comparisons: "Comparisons",
    intro1:
      "Side-by-side fees and features for Malaysian merchants, from each provider's published pricing. For the full matrix including supported banks and e-wallets, open the",
    interactive: "interactive comparison",
    glance: "At a glance",
    fees: "Fees",
    estLabel: "Est. fee / RM100",
    blend: "blends officially published rates (FPX/card/e-wallet 50/30/20).",
    thirdParty: "= third-party figure, excluded from ranking.",
    confirm: "Fees change; confirm with the provider.",
    methodology: "Methodology",
    features: "Features",
    full: "Full comparison",
    details: (n: string) => `${n} details`,
    choose: "Help me choose",
  },
  ms: {
    home: "Utama",
    comparisons: "Perbandingan",
    intro1:
      "Fee dan ciri sebelah-menyebelah untuk peniaga Malaysia, diambil dari harga rasmi setiap gateway. Untuk jadual penuh, termasuk bank dan e-wallet yang disokong, buka",
    interactive: "perbandingan interaktif",
    glance: "Ringkasan",
    fees: "Fee",
    estLabel: "Anggaran caj / RM100",
    blend: "dikira dengan campur kadar rasmi FPX, kad dan e-wallet (50/30/20).",
    thirdParty: "= angka dari pihak ketiga, tidak dikira dalam ranking.",
    confirm: "Fee boleh berubah, jadi sahkan dulu dengan gateway.",
    methodology: "Cara kami kira",
    features: "Ciri",
    full: "Perbandingan penuh",
    details: (n: string) => `Butiran ${n}`,
    choose: "Bantu saya pilih",
  },
});

const crumbLd = breadcrumbLd(String(Astro.site ?? "https://malaysiapg.com.my/"), [
  { name: T.home, path: localizePath("/", locale) },
  { name: T.comparisons, path: localizePath("/vs/", locale) },
  { name: `${splitName(a.name).base} vs ${splitName(b.name).base}` },
]);
---

<Base title={page.title} description={page.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbLd)} />
  <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-sm text-muted">
    <a href="/" class="hover:text-fg hover:underline">{T.home}</a>
    <span aria-hidden="true">/</span>
    <a href="/vs/" class="hover:text-fg hover:underline">{T.comparisons}</a>
    <span aria-hidden="true">/</span>
    <span class="text-fg">{a.name} vs {b.name}</span>
  </nav>

  <h1 class="max-w-3xl text-3xl font-bold tracking-tight text-fg sm:text-4xl">
    {a.name} vs {b.name}
  </h1>
  <p class="mt-4 max-w-3xl text-muted">
    {T.intro1}{" "}
    <a href={`/compare/?ids=${a.slug},${b.slug}`} class="text-accent hover:underline">{T.interactive}</a>.
  </p>

  <section class="mt-10">
    <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">{T.glance}</h2>
    <ul class="max-w-3xl divide-y divide-line border-y border-line">
      {
        page.verdicts.map((v) => (
          <li class="py-3 text-sm text-fg">{v}</li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12">
    <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">{T.fees}</h2>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[520px] text-sm">
        <thead>
          <tr class="border-b border-line text-left">
            <th class="py-3 font-medium text-muted"></th>
            <th class="px-4 py-3">
              <a href={`/gateway/${a.slug}/`} class="flex items-center gap-2 font-medium text-fg hover:underline">
                <Logo slug={a.slug} name={a.name} size={20} /> {a.name}
              </a>
            </th>
            <th class="px-4 py-3">
              <a href={`/gateway/${b.slug}/`} class="flex items-center gap-2 font-medium text-fg hover:underline">
                <Logo slug={b.slug} name={b.name} size={20} /> {b.name}
              </a>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line border-b border-line">
          {
            page.feeRows.map((r) => {
              const win = winnerOf(r);
              return (
                <tr>
                  <td class={`py-2.5 pr-4 text-muted ${win ? "align-top" : ""}`}>{r.label}</td>
                  <td class={`px-4 py-2.5 ${win === "a" ? "font-semibold [&_span]:!text-accent" : ""}`}>
                    <FeeCell value={r.a} />
                  </td>
                  <td class={`px-4 py-2.5 ${win === "b" ? "font-semibold [&_span]:!text-accent" : ""}`}>
                    <FeeCell value={r.b} />
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p class="mt-2 text-xs text-muted">
      <span class="text-fg">{T.estLabel}</span> {T.blend}{" "}
      {hasIndicative && (
        <>
          <span class="text-fg">*</span> {T.thirdParty}{" "}
        </>
      )}
      {T.confirm}{" "}
      <a href="/about/" class="underline-offset-2 hover:text-fg hover:underline">{T.methodology}</a>
    </p>
  </section>

  <section class="mt-12">
    <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">{T.features}</h2>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[520px] text-sm">
        <tbody class="divide-y divide-line border-y border-line">
          {
            page.featureRows.map((r) => (
              <tr>
                <td class="py-2.5 pr-4 text-muted">{r.label}</td>
                <td class="px-4 py-2.5 text-fg">{r.a}</td>
                <td class="px-4 py-2.5 text-fg">{r.b}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href={`/compare/?ids=${a.slug},${b.slug}`}
      class="rounded-md bg-brand-blue px-4 py-2 text-sm font-medium text-white hover:opacity-90"
    >
      {T.full}
    </a>
    <a href={`/gateway/${a.slug}/`} class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      {T.details(a.name)}
    </a>
    <a href={`/gateway/${b.slug}/`} class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      {T.details(b.name)}
    </a>
    <a href="/choose/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      {T.choose}
    </a>
  </div>
</Base>
