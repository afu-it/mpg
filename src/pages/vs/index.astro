---
// Hub for every head-to-head page: gives the 71 /vs/ pages a crawlable index
// at depth 1 instead of leaving them reachable only via gateway detail pages.
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { toApiGateway, type GatewayEntryLike } from "../../lib/api";
import { vsPairs, PROFILES, profileCopy } from "../../lib/seo-pages";
import { breadcrumbLd } from "../../lib/jsonld";
import { splitName } from "../../lib/name";
import { getLocale, tr, localizePath } from "../../i18n/locale";

const entries = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
const gateways = entries.map(toApiGateway);
const pairs = vsPairs(gateways);
const popular = [...pairs]
  .sort((x, y) => y.a.popularity + y.b.popularity - (x.a.popularity + x.b.popularity))
  .slice(0, 8);

const label = (p: (typeof pairs)[number]) =>
  `${splitName(p.a.name).base} vs ${splitName(p.b.name).base}`;

const locale = getLocale(Astro);
const T = tr(locale, {
  en: {
    title: "Payment gateway comparisons: head-to-head fees | MPG",
    description:
      "Every head-to-head comparison of Malaysian payment gateways on MPG: published FPX, card and e-wallet fees, settlement and features, side by side.",
    home: "Home",
    comparisons: "Comparisons",
    h1: "Payment gateway comparisons",
    intro1: (n: number) =>
      `Head-to-head pages for ${n} popular pairings of Malaysian payment providers, built from the same officially published fees as the rest of the directory. Need a custom matchup? Use the`,
    tool: "interactive compare tool",
    intro2: "for any combination of up to seven providers.",
    popular: "Most popular",
    all: "All comparisons",
    guides: "Ranked guides",
  },
  ms: {
    title: "Perbandingan payment gateway: fee satu lawan satu | MPG",
    description:
      "Semua perbandingan satu lawan satu payment gateway Malaysia di MPG: caj FPX, kad dan e-wallet yang disiarkan, tempoh duit masuk dan ciri, sebelah-menyebelah.",
    home: "Utama",
    comparisons: "Perbandingan",
    h1: "Perbandingan payment gateway",
    intro1: (n: number) =>
      `Halaman satu lawan satu untuk ${n} pasangan payment gateway Malaysia yang popular. Semuanya guna fee rasmi yang sama dengan bahagian lain direktori ini. Nak banding pasangan lain? Guna`,
    tool: "alat banding interaktif",
    intro2: "untuk banding mana-mana gabungan, sehingga tujuh gateway.",
    popular: "Paling popular",
    all: "Semua perbandingan",
    guides: "Panduan ranking",
  },
});

const crumbLd = breadcrumbLd(String(Astro.site ?? "https://malaysiapg.com.my/"), [
  { name: T.home, path: localizePath("/", locale) },
  { name: T.comparisons },
]);
---

<Base title={T.title} description={T.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbLd)} />
  <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-sm text-muted">
    <a href="/" class="hover:text-fg hover:underline">{T.home}</a>
    <span aria-hidden="true">/</span>
    <span class="text-fg">{T.comparisons}</span>
  </nav>

  <h1 class="max-w-3xl text-3xl font-bold tracking-tight text-fg sm:text-4xl">{T.h1}</h1>
  <p class="mt-4 max-w-3xl text-muted">
    {T.intro1(pairs.length)}{" "}
    <a href="/compare/" class="text-accent hover:underline">{T.tool}</a>{" "}
    {T.intro2}
  </p>

  <section class="mt-10">
    <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">{T.popular}</h2>
    <div class="flex flex-wrap gap-2">
      {
        popular.map((p) => (
          <a
            href={`/vs/${p.slug}/`}
            class="rounded-full border border-line bg-panel px-3 py-1 text-sm text-fg hover:border-accent"
          >
            {label(p)}
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-8">
    <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">{T.all}</h2>
    <div class="flex flex-wrap gap-2">
      {
        pairs.map((p) => (
          <a
            href={`/vs/${p.slug}/`}
            class="rounded-full border border-line bg-panel px-3 py-1 text-xs text-muted hover:border-accent hover:text-fg"
          >
            {label(p)}
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-10">
    <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">{T.guides}</h2>
    <div class="flex flex-wrap gap-2">
      {
        PROFILES.map((p) => (
          <a
            href={`/best/${p.slug}/`}
            class="rounded-full border border-line bg-panel px-3 py-1 text-xs text-muted hover:border-accent hover:text-fg"
          >
            {profileCopy(p, locale).h1}
          </a>
        ))
      }
    </div>
  </section>
</Base>
