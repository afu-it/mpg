---
// BM money page (spec 12 slice G): "payment gateway murah malaysia".
// Same ranking engine as the whole site; copy asli Bahasa Malaysia.
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import { toApiGateway, type GatewayEntryLike } from "../../lib/api";
import { recommendOrClosest } from "../../lib/recommend";
import { headlineRates } from "../../lib/seo-pages";
import { breadcrumbLd } from "../../lib/jsonld";

const entries = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
const gateways = entries.map(toApiGateway);
const asOf = gateways.map((g) => g.verified_date).sort().at(-1);

const { matches } = recommendOrClosest(gateways, {}, 10);
const ranked = matches.filter((m) => m.gateway.rankable);
const onRequest = matches.filter((m) => !m.gateway.rankable);
const top = ranked[0]?.gateway;

const site = (Astro.site?.href ?? "https://malaysiapg.com.my/").replace(/\/$/, "");
const faqs = [
  {
    q: "Payment gateway apa paling murah di Malaysia sekarang?",
    a: `Setakat ${asOf}, ${top?.name} adalah yang paling murah antara penyedia yang menerbitkan kadar rasmi, dengan anggaran kos sekitar RM${top?.est_fee_rm100?.toFixed(2)} bagi setiap transaksi RM100. Penyedia berasaskan sebut harga mungkin boleh runding lebih rendah, tetapi tiada kadar rasmi untuk dibandingkan.`,
  },
  {
    q: "Macam mana kos ini dikira?",
    a: "Kami ambil kadar rasmi FPX, kad dan e-wallet yang diterbitkan sendiri oleh setiap penyedia, kemudian kira kos campuran atas satu transaksi RM100 (pemberat FPX 50%, kad 30%, e-wallet 20%, termasuk caj tetap). Penyedia tanpa kadar rasmi yang setanding tidak disenaraikan dalam ranking, sebaliknya ditanda sebagai sebut harga.",
  },
  {
    q: "Adakah yuran ini rasmi dan terkini?",
    a: `Ya. Setiap angka diambil dari laman harga rasmi penyedia dan membawa tarikh semakan (terkini ${asOf}) serta pautan sumber di halaman butirannya. Kadar pihak ketiga ditanda * dan dikecualikan dari ranking; jika tiada angka diterbitkan, kami tulis "Contact sales", bukan reka nombor.`,
  },
];

const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Payment gateway paling murah di Malaysia",
    inLanguage: "ms",
    itemListElement: ranked.map((m, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: m.gateway.name,
      url: `${site}/gateway/${m.gateway.slug}/`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: "ms",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  breadcrumbLd(site, [
    { name: "Utama", path: "/" },
    { name: "Bahasa Malaysia", path: "/ms/" },
    { name: "Payment gateway murah" },
  ]),
];
---

<Base
  lang="ms"
  title="Payment gateway murah Malaysia: ranking kos sebenar | MPG"
  description="Senarai payment gateway paling murah di Malaysia, dikira atas kos sebenar setiap transaksi RM100 dari kadar rasmi FPX, kad dan e-wallet setiap penyedia."
>
  <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-sm text-muted">
    <a href="/" class="hover:text-fg hover:underline">Utama</a>
    <span aria-hidden="true">/</span>
    <a href="/ms/" class="hover:text-fg hover:underline">BM</a>
    <span aria-hidden="true">/</span>
    <span class="text-fg">Payment gateway murah</span>
  </nav>

  <h1 class="text-2xl font-semibold tracking-tight text-fg">
    Payment gateway paling murah di Malaysia
  </h1>
  <p class="mt-2 max-w-3xl text-muted">
    "Murah" di sini diukur, bukan diagak: kami ambil kadar rasmi FPX, kad dan e-wallet yang
    diterbitkan sendiri oleh setiap penyedia, dan kira kos campuran atas satu transaksi RM100.
    Penyedia yang tidak menerbitkan kadar setanding tidak boleh diranking secara jujur, jadi
    mereka disenaraikan berasingan sebagai sebut harga.
  </p>
  {
    top && (
      <p class="mt-3 max-w-3xl font-medium text-fg">
        Setakat {asOf}, {top.name} adalah payment gateway paling murah dengan kadar rasmi
        diterbitkan, sekitar RM{top.est_fee_rm100!.toFixed(2)} bagi setiap transaksi RM100.
      </p>
    )
  }

  <section class="mt-8">
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">
      Ranking ikut anggaran kos (kadar rasmi)
    </h2>
    <ol class="space-y-3">
      {
        ranked.map((m, i) => (
          <li class="rounded-md border border-line bg-panel p-4">
            <div class="flex flex-wrap items-center gap-3">
              <span class="w-6 text-right font-semibold text-muted">{i + 1}.</span>
              <Logo slug={m.gateway.slug} name={m.gateway.name} size={26} />
              <a href={`/gateway/${m.gateway.slug}/`} class="font-medium text-fg hover:underline">
                {m.gateway.name}
              </a>
              <span class="ml-auto text-sm text-fg">
                ~RM{m.gateway.est_fee_rm100!.toFixed(2)}
                <span class="text-muted"> / RM100</span>
              </span>
            </div>
            {headlineRates(m.gateway) && (
              <p class="mt-2 pl-9 text-xs text-muted">{headlineRates(m.gateway)}</p>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  {
    onRequest.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">
          Padan juga, tetapi harga atas permintaan
        </h2>
        <ul class="space-y-2">
          {onRequest.map((m) => (
            <li class="flex items-center gap-3 rounded-md border border-line bg-panel px-4 py-3">
              <Logo slug={m.gateway.slug} name={m.gateway.name} size={22} />
              <a href={`/gateway/${m.gateway.slug}/`} class="text-fg hover:underline">
                {m.gateway.name}
              </a>
              <span class="ml-auto text-sm text-muted">Hubungi jualan</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="mt-8 flex flex-wrap gap-3">
    <a href="/calculator/" class="rounded-md bg-brand-blue px-4 py-2 text-sm font-medium text-white hover:opacity-90">
      Kira kos ikut saiz jualan anda
    </a>
    <a href="/ms/cara-pilih-payment-gateway/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      Cara pilih payment gateway
    </a>
    <a href="/gateways/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      Lihat semua {gateways.length} penyedia
    </a>
  </div>

  <section class="mt-10">
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">Soalan lazim</h2>
    <div class="space-y-4">
      {
        faqs.map((f) => (
          <div class="rounded-md border border-line bg-panel p-4">
            <h3 class="font-medium text-fg">{f.q}</h3>
            <p class="mt-1 text-sm text-muted">{f.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <p class="mt-10 border-t border-line pt-4 text-xs text-muted">
    Nota: senarai penuh, jadual perbandingan dan halaman butiran setiap penyedia berada dalam
    Bahasa Inggeris. Yuran adalah anggaran; sentiasa sahkan dengan penyedia sebelum membuat
    keputusan.
  </p>

  {jsonld.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</Base>
