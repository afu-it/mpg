---
// BM guide page (spec 12 slice G): "cara pilih payment gateway".
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { toApiGateway, type GatewayEntryLike } from "../../lib/api";
import { breadcrumbLd } from "../../lib/jsonld";

const entries = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
const gateways = entries.map(toApiGateway);
const total = gateways.length;
const rankedCount = gateways.filter((g) => g.rankable).length;
const asOf = gateways.map((g) => g.verified_date).sort().at(-1);

const site = (Astro.site?.href ?? "https://malaysiapg.com.my/").replace(/\/$/, "");

const steps = [
  {
    t: "1. Kenal pasti cara pelanggan anda bayar",
    d: "Di Malaysia, FPX (bayaran terus dari akaun bank) adalah saluran paling lazim untuk belian online, diikuti kad, e-wallet seperti Touch 'n Go dan GrabPay, serta DuitNow QR. Kalau pelanggan anda ramai bayar cara tertentu, saluran itu wajib ada. BNPL (ansuran) hanya berbaloi untuk bakul belian yang lebih besar.",
  },
  {
    t: "2. Tentukan cara anda nak terima bayaran",
    d: "Tanpa developer? Pilih penyedia dengan pautan bayaran (payment link) atau halaman bayaran siap sedia; anda boleh mula berniaga tanpa menulis kod. Ada sistem atau kedai online sendiri? Semak API, plugin WooCommerce/Shopify, dan sokongan webhook penyedia berkenaan.",
  },
  {
    t: "3. Semak keperluan khusus awal-awal",
    d: "Langganan bulanan perlukan sokongan bayaran berulang (recurring). Kalau aliran tunai ketat, bandingkan tempoh settlement: T+1 bermakna wang masuk sehari bekerja selepas jualan, T+2 dua hari, dan seterusnya. Perniagaan berdaftar biasanya diperlukan untuk buka akaun pedagang.",
  },
  {
    t: "4. Bandingkan kos atas bakul yang sama",
    d: `Kadar "1.5%" dan "RM1.00" tidak boleh dibanding terus. Kami tukar semua kadar rasmi kepada anggaran kos atas satu transaksi RM100 supaya perbandingan jadi adil. Daripada ${total} penyedia dalam direktori ini, ${rankedCount} menerbitkan kadar rasmi yang cukup untuk diranking (semakan terkini ${asOf}); yang lain perlu dihubungi untuk sebut harga.`,
  },
];

const faqs = [
  {
    q: "Perlu ke saya daftar syarikat dulu?",
    a: "Kebanyakan penyedia memerlukan perniagaan berdaftar (SSM) untuk akaun pedagang penuh, terutamanya untuk FPX. Sesetengah penyedia pautan bayaran menerima pemilik tunggal atau individu dengan had tertentu; semak syarat di halaman butiran penyedia.",
  },
  {
    q: "Berapa lama proses kelulusan?",
    a: "Bergantung pada penyedia dan saluran: pautan bayaran boleh aktif dalam sehari dua, manakala akaun dengan FPX penuh atau kadar kad khas biasanya mengambil beberapa hari bekerja hingga beberapa minggu kerana semakan pematuhan.",
  },
  {
    q: "Boleh ke tukar penyedia kemudian?",
    a: "Boleh, dan ramai peniaga berbuat demikian bila jumlah jualan naik dan kadar boleh dirunding. Elakkan terikat: simpan rekod transaksi anda sendiri dan pilih penyedia yang tidak mengunci data pelanggan anda.",
  },
];

const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: "ms",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  breadcrumbLd(site, [
    { name: "Utama", path: "/" },
    { name: "Bahasa Malaysia", path: "/ms/" },
    { name: "Cara pilih payment gateway" },
  ]),
];
---

<Base
  lang="ms"
  title="Cara pilih payment gateway di Malaysia: 4 langkah | MPG"
  description="Panduan ringkas memilih payment gateway untuk perniagaan Malaysia: saluran bayaran, cara integrasi, keperluan khusus, dan cara banding kos dengan adil."
>
  <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-sm text-muted">
    <a href="/" class="hover:text-fg hover:underline">Utama</a>
    <span aria-hidden="true">/</span>
    <a href="/ms/" class="hover:text-fg hover:underline">BM</a>
    <span aria-hidden="true">/</span>
    <span class="text-fg">Cara pilih</span>
  </nav>

  <h1 class="text-2xl font-semibold tracking-tight text-fg">
    Cara pilih payment gateway di Malaysia
  </h1>
  <p class="mt-2 max-w-3xl text-muted">
    Empat langkah, ikut turutan. Jawab keperluan dulu, baru bandingkan harga; gateway paling
    murah tidak berguna kalau ia tiada saluran yang pelanggan anda guna.
  </p>

  <div class="mt-8 max-w-3xl space-y-4">
    {
      steps.map((s) => (
        <section class="rounded-md border border-line bg-panel p-5">
          <h2 class="font-medium text-fg">{s.t}</h2>
          <p class="mt-2 text-sm text-muted">{s.d}</p>
        </section>
      ))
    }
  </div>

  <div class="mt-8 flex flex-wrap gap-3">
    <a href="/choose/" class="rounded-md bg-brand-blue px-4 py-2 text-sm font-medium text-white hover:opacity-90">
      Jawab 4 soalan, dapat cadangan
    </a>
    <a href="/ms/payment-gateway-murah/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      Senarai paling murah
    </a>
    <a href="/compare/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      Banding sebelah-menyebelah
    </a>
  </div>

  <section class="mt-10">
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">Soalan lazim</h2>
    <div class="space-y-4">
      {
        faqs.map((f) => (
          <div class="rounded-md border border-line bg-panel p-4">
            <h3 class="font-medium text-fg">{f.q}</h3>
            <p class="mt-1 text-sm text-muted">{f.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <p class="mt-10 border-t border-line pt-4 text-xs text-muted">
    Alat "Help me choose", jadual penuh dan halaman butiran penyedia berada dalam Bahasa
    Inggeris. Yuran adalah anggaran; sahkan dengan penyedia sebelum membuat keputusan.
  </p>

  {jsonld.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</Base>
