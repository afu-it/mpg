---
// BM hub (spec 12 slice G): landing for the curated Bahasa Malaysia pages.
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { toApiGateway, type GatewayEntryLike } from "../../lib/api";
import { breadcrumbLd } from "../../lib/jsonld";

const entries = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
const gateways = entries.map(toApiGateway);
const total = gateways.length;
const asOf = gateways.map((g) => g.verified_date).sort().at(-1);

const site = (Astro.site?.href ?? "https://malaysiapg.com.my/").replace(/\/$/, "");
const crumbLd = JSON.stringify(
  breadcrumbLd(site, [{ name: "Utama", path: "/" }, { name: "Bahasa Malaysia" }]),
);

const pages = [
  {
    href: "/ms/payment-gateway-murah/",
    t: "Payment gateway paling murah",
    d: "Ranking ikut kos sebenar setiap transaksi RM100, dari kadar rasmi sahaja.",
  },
  {
    href: "/ms/cara-pilih-payment-gateway/",
    t: "Cara pilih payment gateway",
    d: "Panduan 4 langkah: saluran bayaran, cara integrasi, keperluan khusus, dan perbandingan kos yang adil.",
  },
  {
    href: "/ms/payment-gateway-untuk-bisnes-online/",
    t: "Untuk bisnes online",
    d: "Penyedia dengan FPX dan pautan bayaran tanpa kod, sesuai untuk kedai online kecil.",
  },
];
---

<Base
  lang="ms"
  title="Banding payment gateway Malaysia dalam Bahasa Malaysia | MPG"
  description={`Direktori bebas membandingkan yuran ${total} payment gateway Malaysia: FPX, kad, e-wallet, DuitNow QR dan BNPL, dari kadar rasmi. Halaman utama dalam BM.`}
>
  <script is:inline type="application/ld+json" set:html={crumbLd} />

  <h1 class="text-2xl font-semibold tracking-tight text-fg">
    Banding payment gateway Malaysia
  </h1>
  <p class="mt-2 max-w-3xl text-muted">
    MPG ialah direktori bebas dan percuma yang membandingkan yuran {total} penyedia pembayaran
    Malaysia: FPX, kad, e-wallet, DuitNow QR dan BNPL. Setiap yuran disemak terus dari laman
    harga rasmi penyedia (semakan terkini {asOf}) dan membawa pautan sumber. Kami tidak pernah
    reka nombor: jika penyedia tidak menerbitkan kadar, kami tulis "Contact sales".
  </p>

  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    {
      pages.map((p) => (
        <a href={p.href} class="rounded-md border border-line bg-panel p-5 hover:border-accent">
          <h2 class="font-medium text-fg">{p.t}</h2>
          <p class="mt-2 text-sm text-muted">{p.d}</p>
        </a>
      ))
    }
  </div>

  <section class="mt-10 max-w-3xl">
    <h2 class="text-base font-medium text-fg">Selebihnya dalam Bahasa Inggeris</h2>
    <p class="mt-2 text-sm text-muted">
      Jadual penuh, halaman butiran setiap penyedia, alat perbandingan, kalkulator yuran dan
      panduan integrasi berada dalam Bahasa Inggeris. Angka dan data adalah sama; halaman BM
      ini fokus pada soalan yang paling kerap ditanya peniaga tempatan.
    </p>
    <div class="mt-4 flex flex-wrap gap-3">
      <a href="/gateways" class="rounded-md bg-brand-blue px-4 py-2 text-sm font-medium text-white hover:opacity-90">
        Jadual penuh (EN)
      </a>
      <a href="/calculator" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
        Kalkulator yuran
      </a>
      <a href="/choose" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
        Bantu saya pilih
      </a>
    </div>
  </section>
</Base>
