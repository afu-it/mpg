---
// BM money page (spec 12 slice G): "payment gateway untuk bisnes online".
// Mirrors the online-store profile needs (FPX + no-code) via recommend().
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import { toApiGateway, type GatewayEntryLike } from "../../lib/api";
import { recommendOrClosest } from "../../lib/recommend";
import { headlineRates } from "../../lib/seo-pages";
import { breadcrumbLd } from "../../lib/jsonld";

const entries = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
const gateways = entries.map(toApiGateway);
const asOf = gateways.map((g) => g.verified_date).sort().at(-1);

// baseline kedai online kecil: FPX (cara rakyat Malaysia bayar) + tanpa kod
const { matches } = recommendOrClosest(gateways, { channels: ["fpx"], noCode: true }, 8);
const ranked = matches.filter((m) => m.gateway.rankable);
const onRequest = matches.filter((m) => !m.gateway.rankable);
const top = ranked[0]?.gateway;

const site = (Astro.site?.href ?? "https://malaysiapg.com.my/").replace(/\/$/, "");
const faqs = [
  {
    q: "Payment gateway apa sesuai untuk kedai online kecil?",
    a: `Mulakan dengan penyedia yang ada FPX dan pautan bayaran tanpa kod, supaya anda boleh terima bayaran melalui WhatsApp atau Instagram sebelum ada website penuh. Setakat ${asOf}, ${top?.name} adalah pilihan termurah yang memenuhi kedua-dua syarat ini, sekitar RM${top?.est_fee_rm100?.toFixed(2)} setiap transaksi RM100.`,
  },
  {
    q: "Saya guna WooCommerce atau Shopify. Apa beza?",
    a: "Kebanyakan penyedia tempatan sediakan plugin rasmi WooCommerce; sokongan Shopify lebih terhad kerana Shopify mengawal saluran pembayarannya. Semak baris Plugins di halaman butiran setiap penyedia sebelum memilih.",
  },
  {
    q: "Kenapa FPX penting untuk bisnes online?",
    a: "FPX membenarkan pelanggan bayar terus dari akaun bank tanpa kad, dan ia saluran online paling dipercayai di Malaysia. Kos setiap transaksi FPX juga biasanya paling rendah berbanding kad, jadi ia baseline yang wajar untuk hampir semua kedai online.",
  },
];

const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Payment gateway untuk bisnes online di Malaysia",
    inLanguage: "ms",
    itemListElement: [...ranked, ...onRequest].map((m, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: m.gateway.name,
      url: `${site}/gateway/${m.gateway.slug}/`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: "ms",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  breadcrumbLd(site, [
    { name: "Utama", path: "/" },
    { name: "Bahasa Malaysia", path: "/ms/" },
    { name: "Untuk bisnes online" },
  ]),
];
---

<Base
  lang="ms"
  title="Payment gateway untuk bisnes online di Malaysia | MPG"
  description="Payment gateway terbaik untuk bisnes online Malaysia: ada FPX dan pautan bayaran tanpa kod, diranking ikut kos sebenar setiap transaksi RM100 dari kadar rasmi."
>
  <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-sm text-muted">
    <a href="/" class="hover:text-fg hover:underline">Utama</a>
    <span aria-hidden="true">/</span>
    <a href="/ms/" class="hover:text-fg hover:underline">BM</a>
    <span aria-hidden="true">/</span>
    <span class="text-fg">Untuk bisnes online</span>
  </nav>

  <h1 class="text-2xl font-semibold tracking-tight text-fg">
    Payment gateway untuk bisnes online di Malaysia
  </h1>
  <p class="mt-2 max-w-3xl text-muted">
    Baseline yang munasabah untuk kedai online kecil: FPX (cara kebanyakan rakyat Malaysia
    bayar online) dan pautan bayaran tanpa kod supaya anda boleh mula menjual sebelum menulis
    sebarang kod. Setiap penyedia di bawah memenuhi kedua-duanya, diranking ikut anggaran kos
    campuran atas transaksi RM100 dari kadar rasmi.
  </p>
  {
    top && (
      <p class="mt-3 max-w-3xl font-medium text-fg">
        Setakat {asOf}, pilihan termurah dengan kadar rasmi ialah {top.name}, sekitar
        RM{top.est_fee_rm100!.toFixed(2)} bagi setiap transaksi RM100.
      </p>
    )
  }

  <section class="mt-8">
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">
      Ranking ikut anggaran kos (kadar rasmi)
    </h2>
    <ol class="space-y-3">
      {
        ranked.map((m, i) => (
          <li class="rounded-md border border-line bg-panel p-4">
            <div class="flex flex-wrap items-center gap-3">
              <span class="w-6 text-right font-semibold text-muted">{i + 1}.</span>
              <Logo slug={m.gateway.slug} name={m.gateway.name} size={26} />
              <a href={`/gateway/${m.gateway.slug}`} class="font-medium text-fg hover:underline">
                {m.gateway.name}
              </a>
              <span class="ml-auto text-sm text-fg">
                ~RM{m.gateway.est_fee_rm100!.toFixed(2)}
                <span class="text-muted"> / RM100</span>
              </span>
            </div>
            {headlineRates(m.gateway) && (
              <p class="mt-2 pl-9 text-xs text-muted">{headlineRates(m.gateway)}</p>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  {
    onRequest.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">
          Padan juga, tetapi harga atas permintaan
        </h2>
        <ul class="space-y-2">
          {onRequest.map((m) => (
            <li class="flex items-center gap-3 rounded-md border border-line bg-panel px-4 py-3">
              <Logo slug={m.gateway.slug} name={m.gateway.name} size={22} />
              <a href={`/gateway/${m.gateway.slug}`} class="text-fg hover:underline">
                {m.gateway.name}
              </a>
              <span class="ml-auto text-sm text-muted">Hubungi jualan</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="mt-8 flex flex-wrap gap-3">
    <a href="/ms/cara-pilih-payment-gateway/" class="rounded-md bg-brand-blue px-4 py-2 text-sm font-medium text-white hover:opacity-90">
      Cara pilih payment gateway
    </a>
    <a href="/ms/payment-gateway-murah/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      Senarai paling murah
    </a>
    <a href="/gateways" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      Semua {gateways.length} penyedia
    </a>
  </div>

  <section class="mt-10">
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">Soalan lazim</h2>
    <div class="space-y-4">
      {
        faqs.map((f) => (
          <div class="rounded-md border border-line bg-panel p-4">
            <h3 class="font-medium text-fg">{f.q}</h3>
            <p class="mt-1 text-sm text-muted">{f.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <p class="mt-10 border-t border-line pt-4 text-xs text-muted">
    Halaman butiran dan jadual penuh berada dalam Bahasa Inggeris. Yuran adalah anggaran;
    sahkan dengan penyedia sebelum membuat keputusan.
  </p>

  {jsonld.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</Base>
