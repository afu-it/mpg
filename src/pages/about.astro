---
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { breadcrumbLd } from "../lib/jsonld";
import { getLocale, tr, formatDate } from "../i18n/locale";

const locale = getLocale(Astro);
const T = tr(locale, {
  en: {
    home: "Home",
    crumb: "About",
    title: "About MPG · the Malaysia Payment Gateway directory",
    description:
      "What MPG is, how every fee is sourced and verified against official provider pages, how the cost ranking works, and how to reach the maintainer.",
    h1: "About MPG",
    lead: (n: number) => `A free, independent list of ${n} Malaysian payment providers and what they charge.`,
    providers: "Providers",
    lastVerified: "Last verified",
    price: "Price",
    free: "Free",
    how: "How we work",
    principles: [
      { title: "Official sources only", desc: "Every fee links to the provider's own pricing page." },
      { title: "Nothing guessed", desc: 'No published rate? We say "Contact sales".' },
      { title: "One number to compare", desc: "Est. cost of a RM100 sale (FPX/card/e-wallet 50/30/20)." },
      { title: "Not paid by anyone", desc: "No ads, no affiliate links, no sponsored spots." },
    ],
    confirm: "Fees change and can be negotiated, so always confirm with the provider.",
    openSource: "Open source",
    code: "Code on GitHub (MIT)",
    data: "Data: CC BY 4.0",
    api: "Free API & MCP",
    credit: 'Reusing the data? Credit "Malaysia Payment Gateway (malaysiapg.com.my)".',
    spotted: "Spotted a wrong fee?",
    builtBy: "Built and run by one Malaysian developer, who reads every message.",
    fix: "Fix it",
    contact: "Contact",
  },
  ms: {
    home: "Utama",
    crumb: "Tentang",
    title: "Tentang MPG · direktori Malaysia Payment Gateway",
    description:
      "Apa itu MPG, dari mana setiap fee diambil dan macam mana ia disemak dengan laman rasmi gateway, cara ranking kos dibuat, dan cara hubungi pengurus laman.",
    h1: "Tentang MPG",
    lead: (n: number) => `Senarai percuma dan bebas ${n} payment gateway Malaysia, berserta caj mereka.`,
    providers: "Gateway",
    lastVerified: "Terakhir disemak",
    price: "Harga",
    free: "Percuma",
    how: "Cara kami bekerja",
    principles: [
      { title: "Sumber rasmi sahaja", desc: "Setiap fee ada link ke laman harga rasmi gateway itu sendiri." },
      { title: "Tiada tekaan", desc: 'Tiada kadar rasmi? Kami tulis "Hubungi jualan".' },
      { title: "Satu nombor untuk banding", desc: "Anggaran caj bagi jualan RM100 (FPX/kad/e-wallet 50/30/20)." },
      { title: "Tiada siapa bayar kami", desc: "Tiada iklan, tiada link affiliate, tiada ranking berbayar." },
    ],
    confirm: "Fee boleh berubah dan boleh dirunding, jadi sahkan dulu dengan gateway.",
    openSource: "Sumber terbuka",
    code: "Kod di GitHub (MIT)",
    data: "Data: CC BY 4.0",
    api: "API & MCP percuma",
    credit: 'Guna semula data ini? Sebut sumbernya: "Malaysia Payment Gateway (malaysiapg.com.my)".',
    spotted: "Jumpa fee yang salah?",
    builtBy: "Dibina dan diurus oleh seorang developer Malaysia yang baca setiap mesej.",
    fix: "Betulkan",
    contact: "Hubungi",
  },
});

const crumbLd = breadcrumbLd(String(Astro.site ?? "https://malaysiapg.com.my/"), [
  { name: T.home, path: "/" },
  { name: T.crumb },
]);
const gateways = await getCollection("gateways");
const total = gateways.length;
const lastVerified = gateways
  .map((g) => g.data.verified_date)
  .sort()
  .at(-1);

const principles = T.principles;
const ext = { target: "_blank", rel: "noopener noreferrer" };
---

<Base
  title={T.title}
  description={T.description}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbLd)} />

  <header class="max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">{T.h1}</h1>
    <p class="mt-2 text-muted">
      {T.lead(total)}
    </p>
  </header>

  <dl class="mt-8 grid gap-3 sm:grid-cols-3">
    <div class="rounded-xl border border-line bg-panel p-5">
      <dt class="text-xs font-medium uppercase tracking-widest text-muted">{T.providers}</dt>
      <dd class="mt-1 text-2xl font-semibold text-fg">{total}</dd>
    </div>
    <div class="rounded-xl border border-line bg-panel p-5">
      <dt class="text-xs font-medium uppercase tracking-widest text-muted">{T.lastVerified}</dt>
      <dd class="mt-1 text-2xl font-semibold text-fg">{lastVerified && locale === "ms" ? formatDate(lastVerified, locale) : lastVerified}</dd>
    </div>
    <div class="rounded-xl border border-line bg-panel p-5">
      <dt class="text-xs font-medium uppercase tracking-widest text-muted">{T.price}</dt>
      <dd class="mt-1 text-2xl font-semibold text-fg">{T.free}</dd>
    </div>
  </dl>

  <section class="mt-10">
    <h2 class="text-xs font-medium uppercase tracking-widest text-muted">{T.how}</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        principles.map((p) => (
          <div class="rounded-xl border border-line bg-panel p-5">
            <h3 class="font-semibold text-fg">{p.title}</h3>
            <p class="mt-1 text-sm text-muted">{p.desc}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-3 text-sm text-muted">
      {T.confirm}
    </p>
  </section>

  <section class="mt-10">
    <h2 class="text-xs font-medium uppercase tracking-widest text-muted">{T.openSource}</h2>
    <div class="mt-3 flex flex-wrap gap-2 text-sm">
      <a href="https://github.com/afu-it/mpg" {...ext} class="rounded-full border border-line px-3 py-1 text-muted hover:border-muted hover:text-fg">{T.code}</a>
      <a href="https://creativecommons.org/licenses/by/4.0/" {...ext} class="rounded-full border border-line px-3 py-1 text-muted hover:border-muted hover:text-fg">{T.data}</a>
      <a href="/learn/api/" class="rounded-full border border-line px-3 py-1 text-muted hover:border-muted hover:text-fg">{T.api}</a>
    </div>
    <p class="mt-3 text-sm text-muted">
      {T.credit}
    </p>
  </section>

  <section class="mt-10 flex flex-col gap-4 rounded-xl border border-line bg-panel p-5 sm:flex-row sm:items-center sm:justify-between" id="contact">
    <div>
      <h2 class="font-semibold text-fg">{T.spotted}</h2>
      <p class="mt-1 text-sm text-muted">{T.builtBy}</p>
    </div>
    <div class="flex gap-2">
      <a href="/contribute/" class="rounded-md bg-brand-blue px-4 py-2 text-sm font-medium text-white hover:opacity-90">{T.fix}</a>
      <a href="/contact/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:border-muted hover:text-fg">{T.contact}</a>
    </div>
  </section>
</Base>
