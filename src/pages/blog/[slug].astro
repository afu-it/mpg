---
// Blog post pages (spec 15). Prose is evergreen markdown; the dated answer box
// and fee table render LIVE directory data for the gateways a post declares,
// so published numbers can never drift from /gateways. Literal pillar routes
// (fees-pricing.astro, ...) take precedence over this dynamic route.
export const prerender = true;

import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostAuthor from "../../components/PostAuthor.astro";
import PostFeeBox from "../../components/PostFeeBox.astro";
import PostCard from "../../components/PostCard.astro";
import Logo from "../../components/Logo.astro";
import { postCards } from "../../lib/blog-cards";
import { articleLd, blogPath, clusterBySlug } from "../../lib/blog";
import { getLocale, tr, formatDate } from "../../i18n/locale";
import { gatewayMs, postMsEntry } from "../../i18n/content";
import { breadcrumbLd } from "../../lib/jsonld";
import { toApiGateway, type GatewayEntryLike } from "../../lib/api";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const locale = getLocale(Astro);
// BM overlay (src/content/posts-ms/<id>.md): text only; dates, gateways and
// sources stay on the English entry. Missing file or empty body -> English.
const ms = await postMsEntry(entry.id, locale);
const title = ms?.data.title ?? d.title;
const description = ms?.data.description ?? d.description;
const faq = ms && ms.data.faq.length > 0 ? ms.data.faq : d.faq;
const imageAlt = ms?.data.imageAlt ?? d.imageAlt;
const shown = ms?.body?.trim() ? ms : entry;
const { Content, headings } = await render(shown);
// table of contents: the post's own section headings
const toc = headings.filter((h) => h.depth === 2);
const words = (shown.body ?? "").split(/\s+/).filter(Boolean).length;
const mins = Math.max(1, Math.round(words / 220));

const T = tr(locale, {
  en: {
    home: "Home",
    blog: "Blog",
    breadcrumb: "Breadcrumb",
    byline: (pub: string, upd?: string) => `By Afu · Published ${pub}${upd ? ` · Updated ${upd}` : ""}`,
    mins: (n: number) => `${n} min read`,
    onThisPage: "On this page",
    perSale: "per RM100 sale",
    card: "Card",
    nextStep: "Next step",
    quickAnswer: "Quick answer",
    verifiedAsOf: (date: string) => `Verified rates as of ${date}`,
    fpx: "FPX",
    localCards: "local cards",
    ewallet: "e-wallet",
    duitnow: "DuitNow QR",
    estimated: "estimated",
    perBasket: (rm: string) => `RM${rm} per RM100 basket`,
    onRequest: "cost on request",
    settlement: "settlement",
    settlementLabel: "Settlement",
    faq: "Frequently asked questions",
    compare: "Compare these gateways",
    choose: "Help me choose a gateway",
    calculator: "Fee calculator",
    sources: "Sources",
    related: "Related guides",
  },
  ms: {
    home: "Utama",
    blog: "Blog",
    breadcrumb: "Laluan halaman",
    byline: (pub: string, upd?: string) => `Oleh Afu · Diterbitkan ${pub}${upd ? ` · Dikemas kini ${upd}` : ""}`,
    mins: (n: number) => `${n} min baca`,
    onThisPage: "Dalam halaman ini",
    perSale: "bagi jualan RM100",
    card: "Kad",
    nextStep: "Langkah seterusnya",
    quickAnswer: "Jawapan ringkas",
    verifiedAsOf: (date: string) => `Kadar disemak pada ${date}`,
    fpx: "FPX",
    localCards: "kad tempatan",
    ewallet: "e-wallet",
    duitnow: "DuitNow QR",
    estimated: "anggaran",
    perBasket: (rm: string) => `RM${rm} bagi jualan RM100`,
    onRequest: "Hubungi jualan",
    settlement: "duit masuk",
    settlementLabel: "Duit masuk",
    faq: "Soalan lazim",
    compare: "Bandingkan gateway ini",
    choose: "Bantu saya pilih gateway",
    calculator: "Kalkulator fee",
    sources: "Sumber",
    related: "Panduan berkaitan",
  },
});
const showDate = (iso: string) => (locale === "ms" ? formatDate(iso, locale) : iso);
// fee cells keep their figures; only the "Contact sales" placeholder is translated
const fee = (v: string | undefined) => (locale === "ms" && v === "Contact sales" ? "Hubungi jualan" : v);

const site = (Astro.site?.href ?? "https://malaysiapg.com.my/").replace(/\/$/, "");
const path = `/blog/${entry.id}/`;
const cluster = clusterBySlug(d.cluster);

// dated quick-answer lines (GEO): generated from live data at build time
const all = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
const featured = d.gateways
  .map((s) => all.find((e) => e.id === s))
  .filter((e): e is GatewayEntryLike => Boolean(e))
  .map((e) => ({ e, api: toApiGateway(e) }));
const settlementOf = new Map(
  await Promise.all(
    featured.map(async (f) => [f.e.id, (await gatewayMs(f.e.id, locale))?.data.settlement ?? fee(f.e.data.settlement)] as const),
  ),
);
const answerDate = featured
  .map((f) => f.e.data.verified_date)
  .sort()
  .at(-1);

const related = (await postCards(d.cluster, locale)).filter((c) => !c.href.endsWith(`/${entry.id}/`)).slice(0, 3);
const clusterName = cluster ? (locale === "ms" ? cluster.nameMs : cluster.name) : "";

const postLd = JSON.stringify(
  articleLd(
    site,
    path,
    title,
    description,
    d.pubDate,
    d.updatedDate,
    d.image ? { url: d.image, alt: imageAlt } : undefined,
    locale,
  ),
);
const crumbLd = JSON.stringify(
  breadcrumbLd(site, [
    { name: T.home, path: "/" },
    { name: T.blog, path: "/blog/" },
    ...(cluster && cluster.live ? [{ name: clusterName, path: blogPath(cluster.slug) }] : []),
    { name: title },
  ]),
);
const faqLd =
  faq.length > 0
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        inLanguage: locale === "ms" ? "ms" : "en",
        mainEntity: faq.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      })
    : null;

const compareHref =
  featured.length > 1 ? `/compare/?ids=${featured.map((f) => f.e.id).join(",")}` : null;
---

<Base title={title} description={description} ogImage={d.image} ogImageAlt={imageAlt}>
  <script is:inline type="application/ld+json" set:html={postLd} />
  <script is:inline type="application/ld+json" set:html={crumbLd} />
  {faqLd && <script is:inline type="application/ld+json" set:html={faqLd} />}

  <nav aria-label={T.breadcrumb} class="mb-6 flex flex-wrap items-center gap-2 text-sm text-muted">
    <a href="/" class="hover:text-fg hover:underline">{T.home}</a>
    <span aria-hidden="true">/</span>
    <a href="/blog/" class="hover:text-fg hover:underline">{T.blog}</a>
    {
      cluster && cluster.live && (
        <>
          <span aria-hidden="true">/</span>
          <a href={blogPath(cluster.slug)} class="hover:text-fg hover:underline">
            {clusterName}
          </a>
        </>
      )
    }
  </nav>

  <header class="max-w-3xl">
    <h1 class="text-balance text-3xl font-bold tracking-tight text-fg sm:text-5xl">{title}</h1>
    <p class="mt-4 text-lg text-muted">{description}</p>
    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
      {
        featured.length > 0 && (
          <span class="flex -space-x-1.5" aria-hidden="true">
            {featured.map(({ e }) => (
              <span class="grid size-8 place-items-center rounded-full bg-raised ring-2 ring-surface">
                <Logo slug={e.id} name={e.data.name} size={18} />
              </span>
            ))}
          </span>
        )
      }
      <span>{T.byline(showDate(d.pubDate), d.updatedDate ? showDate(d.updatedDate) : undefined)}</span>
      <span aria-hidden="true">·</span>
      <span>{T.mins(mins)}</span>
    </div>
  </header>

  {
    d.image && (
      <img
        src={d.image}
        alt={imageAlt ?? title}
        width="1200"
        height="630"
        fetchpriority="high"
        class="mt-8 w-full max-w-3xl rounded-xl border border-line"
      />
    )
  }

  {
    featured.length > 0 && (
      <section class="mt-8" aria-label={T.quickAnswer}>
        <p class="text-xs font-medium uppercase tracking-widest text-muted">
          {T.verifiedAsOf(answerDate ? showDate(answerDate) : "")}
        </p>
        <ul class={`mt-3 grid gap-3 ${featured.length >= 3 ? "sm:grid-cols-3" : featured.length === 2 ? "sm:grid-cols-2" : ""} max-w-5xl`}>
          {featured.map(({ e, api }) => (
            <li>
              <a href={`/gateway/${e.id}/`} class="flex h-full flex-col rounded-xl border border-line bg-panel p-4 hover:border-muted">
                <span class="flex items-center gap-2 font-semibold text-fg">
                  <Logo slug={e.id} name={e.data.name} size={22} />
                  {e.data.name}
                </span>
                <span class="mt-3 text-2xl font-semibold text-fg">
                  {api.rankable && api.est_fee_rm100 != null ? `RM${api.est_fee_rm100.toFixed(2)}` : fee("Contact sales")}
                </span>
                <span class="text-xs text-muted">{api.rankable && api.est_fee_rm100 != null ? `${T.estimated} ${T.perSale}` : T.onRequest}</span>
                <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-xs">
                  <dt class="text-muted">{T.fpx}</dt>
                  <dd class="text-fg">{fee(e.data.fees.fpx)}</dd>
                  <dt class="text-muted">{T.card}</dt>
                  <dd class="text-fg">{fee(e.data.fees.card)}</dd>
                  <dt class="text-muted">{T.settlementLabel}</dt>
                  <dd class="text-fg">{settlementOf.get(e.id)}</dd>
                </dl>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_260px]">
    <article class="min-w-0 max-w-[70ch]">
      <div class="post-body text-[15px] leading-7 text-muted sm:text-base">
        <Content />
      </div>

      <PostFeeBox slugs={d.gateways} />

      {
        faq.length > 0 && (
          <section class="mt-12">
            <h2 class="text-xl font-semibold text-fg">{T.faq}</h2>
            <div class="mt-4 space-y-2">
              {faq.map((f) => (
                <details class="group rounded-xl border border-line bg-panel px-5 py-4">
                  <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-medium text-fg">
                    {f.q}
                    <span class="mt-0.5 text-muted transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                  </summary>
                  <p class="mt-2 text-sm leading-6 text-muted">{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }

      {
        d.sources.length > 0 && (
          <section class="mt-10">
            <h2 class="text-xs font-medium uppercase tracking-widest text-muted">{T.sources}</h2>
            <ul class="mt-3 flex flex-wrap gap-2 text-xs">
              {d.sources.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full border border-line px-3 py-1 text-muted hover:border-muted hover:text-fg">
                    {s.label} ↗
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <PostAuthor />
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-20 space-y-6">
        {
          toc.length > 1 && (
            <nav aria-label={T.onThisPage}>
              <p class="text-xs font-medium uppercase tracking-widest text-muted">{T.onThisPage}</p>
              <ul class="mt-3 space-y-2 border-l border-line text-sm">
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class="-ml-px block border-l border-transparent pl-3 text-muted hover:border-fg hover:text-fg">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <div class="rounded-xl border border-line bg-panel p-4">
          <p class="text-xs font-medium uppercase tracking-widest text-muted">{T.nextStep}</p>
          <div class="mt-3 flex flex-col gap-2 text-sm">
            {
              compareHref && (
                <a href={compareHref} class="rounded-md bg-brand-blue px-3 py-2 text-center font-medium text-white hover:opacity-90">
                  {T.compare}
                </a>
              )
            }
            <a href="/choose/" class="rounded-md border border-line px-3 py-2 text-center text-muted hover:border-muted hover:text-fg">{T.choose}</a>
            <a href="/calculator/" class="rounded-md border border-line px-3 py-2 text-center text-muted hover:border-muted hover:text-fg">{T.calculator}</a>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <div class="mt-8 flex flex-wrap gap-2 lg:hidden">
    {
      compareHref && (
        <a href={compareHref} class="rounded-md bg-brand-blue px-4 py-2 text-sm font-medium text-white hover:opacity-90">{T.compare}</a>
      )
    }
    <a href="/choose/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">{T.choose}</a>
    <a href="/calculator/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">{T.calculator}</a>
  </div>

  {
    related.length > 0 && (
      <section class="mt-16 border-t border-line pt-10">
        <h2 class="text-xs font-medium uppercase tracking-widest text-muted">{T.related}</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((c) => <PostCard card={c} />)}
        </div>
      </section>
    )
  }
</Base>

<style is:global>
  .post-body > * + * {
    margin-top: 1.1rem;
  }
  .post-body h2 {
    margin-top: 2.75rem;
    scroll-margin-top: 5rem;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-fg, #fafafa);
  }
  .post-body h3 {
    margin-top: 1.75rem;
    scroll-margin-top: 5rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-fg, #fafafa);
  }
  .post-body ul,
  .post-body ol {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .post-body ul {
    list-style: disc;
  }
  .post-body ol {
    list-style: decimal;
  }
  .post-body li::marker {
    color: var(--color-line, #3d3d42);
  }
  .post-body a {
    color: var(--color-accent, #4f86f5);
    text-underline-offset: 2px;
  }
  .post-body a:hover {
    text-decoration: underline;
  }
  .post-body strong {
    color: var(--color-fg, #fafafa);
    font-weight: 600;
  }
  .post-body blockquote {
    border-left: 2px solid var(--color-accent, #4f86f5);
    padding-left: 1rem;
    color: var(--color-fg, #fafafa);
  }
  .post-body table {
    width: 100%;
    font-size: 0.875rem;
  }
  .post-body th,
  .post-body td {
    border-bottom: 1px solid var(--color-line, #3d3d42);
    padding: 0.5rem 0.75rem 0.5rem 0;
    text-align: left;
  }
</style>
