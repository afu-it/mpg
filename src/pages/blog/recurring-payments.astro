---
// Pillar page: recurring payments cluster (spec 15 slice D). A literal route so
// it wins over the dynamic /blog/[slug] post route.
export const prerender = true;

import { getCollection } from "astro:content";
import BlogPillar from "../../components/BlogPillar.astro";
import { toApiGateway, type GatewayEntryLike } from "../../lib/api";
import { getLocale, tr } from "../../i18n/locale";

const T = tr(getLocale(Astro), {
  en: {
    heading: "Recurring payments in Malaysia",
    intro: (n: number) => `Charge customers automatically. ${n} gateways here support it.`,
    topLabel: "Cheapest with recurring",
    seeAll: (n: number) => `All ${n}`,
    saas: "Gateways for SaaS",
    what: "What is recurring billing?",
    calculator: "Fee calculator",
  },
  ms: {
    heading: "Bayaran berulang di Malaysia",
    intro: (n: number) => `Caj pelanggan secara automatik. ${n} gateway di sini ada ciri ini.`,
    topLabel: "Paling murah untuk bayaran berulang",
    seeAll: (n: number) => `Semua ${n}`,
    saas: "Gateway untuk SaaS",
    what: "Apa itu bayaran berulang?",
    calculator: "Kalkulator fee",
  },
});

// live tiles: cheapest ranked gateways that support recurring billing
const all = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
const recurring = all.map(toApiGateway).filter((g) => g.features.recurring);
const top = recurring
  .filter((g) => g.rankable && g.est_fee_rm100 != null)
  .sort((a, b) => a.est_fee_rm100! - b.est_fee_rm100!)
  .slice(0, 3)
  .map((g) => ({ slug: g.slug, name: g.name, est: g.est_fee_rm100! }));
const verified = all.map((e) => e.data.verified_date).sort().at(-1);
---

<BlogPillar
  cluster="recurring-payments"
  heading={T.heading}
  intro={T.intro(recurring.length)}
  topLabel={T.topLabel}
  top={top}
  seeAll={{ href: "/best/payment-gateway-recurring/", label: T.seeAll(recurring.length) }}
  tools={[
    { href: "/best/payment-gateway-saas/", label: T.saas },
    { href: "/learn/glossary/recurring-payments/", label: T.what },
    { href: "/calculator/", label: T.calculator },
  ]}
  verified={verified}
/>
