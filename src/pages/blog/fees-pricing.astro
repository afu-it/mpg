---
// Pillar page: fees & pricing cluster (spec 15 slice B). A literal route so it
// wins over the dynamic /blog/[slug] post route.
export const prerender = true;

import { getCollection } from "astro:content";
import BlogPillar from "../../components/BlogPillar.astro";
import { toApiGateway, type GatewayEntryLike } from "../../lib/api";
import { getLocale, tr } from "../../i18n/locale";

const T = tr(getLocale(Astro), {
  en: {
    heading: "Payment gateway fees in Malaysia",
    intro: "What each gateway really charges, from official rate cards.",
    topLabel: "Cheapest right now",
    seeAll: "Full ranking",
    calculator: "Fee calculator",
    compare: "Compare gateways",
    log: "Fee change log",
  },
  ms: {
    heading: "Fee payment gateway di Malaysia",
    intro: "Caj sebenar setiap gateway, terus dari senarai harga rasmi mereka.",
    topLabel: "Paling murah sekarang",
    seeAll: "Senarai penuh",
    calculator: "Kalkulator fee",
    compare: "Bandingkan gateway",
    log: "Rekod perubahan fee",
  },
});

// live tiles: cheapest ranked gateways right now
const all = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
const top = all
  .map(toApiGateway)
  .filter((g) => g.rankable && g.est_fee_rm100 != null)
  .sort((a, b) => a.est_fee_rm100! - b.est_fee_rm100!)
  .slice(0, 3)
  .map((g) => ({ slug: g.slug, name: g.name, est: g.est_fee_rm100! }));
const verified = all.map((e) => e.data.verified_date).sort().at(-1);
---

<BlogPillar
  cluster="fees-pricing"
  heading={T.heading}
  intro={T.intro}
  topLabel={T.topLabel}
  top={top}
  seeAll={{ href: "/best/payment-gateway-malaysia/", label: T.seeAll }}
  tools={[
    { href: "/calculator/", label: T.calculator },
    { href: "/compare/", label: T.compare },
    { href: "/fee-changes/", label: T.log },
  ]}
  verified={verified}
/>
