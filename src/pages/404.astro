---
import Base from "../layouts/Base.astro";
---

<Base title="Not found — MPG">
  <section class="py-20 text-center">
    <p class="text-sm font-medium uppercase tracking-wide text-accent">404</p>
    <h1 class="mt-2 text-2xl font-semibold text-fg">Page not found</h1>
    <p class="mt-2 text-muted">
      That gateway or page doesn't exist (or may have been removed).
    </p>
    <a
      href="/"
      class="mt-6 inline-block rounded-md bg-accent px-4 py-2 text-sm font-medium text-black hover:opacity-90"
    >
      ← Back to all gateways
    </a>
  </section>
</Base>
