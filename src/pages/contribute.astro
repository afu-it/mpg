---
// Open-for-contribution page (spec 11, reworked by spec 19): the repo is now
// PUBLIC, so the primary path is fork + PR on GitHub. The Clerk-gated
// application form stays as a fallback for people without GitHub.
export const prerender = true;

import Base from "../layouts/Base.astro";
import { breadcrumbLd } from "../lib/jsonld";

const crumbLd = breadcrumbLd(String(Astro.site ?? "https://malaysiapg.com.my/"), [
  { name: "Home", path: "/" },
  { name: "Contribute" },
]);

const areas = [
  "Fix or update a gateway's fees (with an official source)",
  "Add a missing Malaysian gateway",
  "Fill in supported banks / e-wallet methods",
  "Improve the Learn guides or docs",
  "Something else",
];

const repoUrl = "https://github.com/afu-it/mpg";
const steps = [
  {
    n: "1",
    title: "Fork the repo",
    desc: "The code and all gateway data are open source on GitHub. Fork it to your account.",
  },
  {
    n: "2",
    title: "Edit one file",
    desc: "Each gateway is a single markdown file. Fix the fee, bump the verified date, keep the official source link.",
  },
  {
    n: "3",
    title: "Open a pull request",
    desc: "Tests check the data automatically. Link your official source in the PR description.",
  },
  {
    n: "4",
    title: "Merged and live",
    desc: "Every change is reviewed against the source before it goes live on the site.",
  },
];
---

<Base
  title="Contribute to MPG | Malaysia Payment Gateway"
  description="Help keep Malaysia's payment gateway directory accurate: fix fees with official sources, add missing gateways, improve the guides. Apply to contribute."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbLd)} />
  <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-sm text-muted">
    <a href="/" class="hover:text-fg hover:underline">Home</a>
    <span aria-hidden="true">/</span>
    <span class="text-fg">Contribute</span>
  </nav>

  <div class="mx-auto max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">Contribute to MPG</h1>
    <p class="mt-4 text-muted">
      This directory stays useful only if the data stays true. If you spot an outdated fee,
      know a gateway we missed, or want to improve the guides, you can help. The whole
      site is{" "}
      <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">open source on GitHub</a>.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-brand-blue px-4 py-2 text-sm font-medium text-white hover:opacity-90"
      >
        View the repo on GitHub
      </a>
      <a
        href={`${repoUrl}/issues/new/choose`}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg"
      >
        Report a fee change
      </a>
    </div>

    <section class="mt-8">
      <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">The rules (non-negotiable)</h2>
      <ul class="space-y-2 text-sm text-muted">
        <li class="rounded-md border border-line bg-panel px-4 py-3">
          <strong class="text-fg">Every fee needs an official source.</strong>{" "}
          Provider pricing page or rate card, with a date. No source, no number.
        </li>
        <li class="rounded-md border border-line bg-panel px-4 py-3">
          <strong class="text-fg">Never invent a figure.</strong>{" "}
          Unpublished pricing stays "Contact sales". Third-party figures carry a trailing *.
        </li>
        <li class="rounded-md border border-line bg-panel px-4 py-3">
          <strong class="text-fg">One gateway = one markdown file.</strong>{" "}
          Data lives in simple, schema-checked files; tests and checks must pass before merge.
        </li>
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">How it works</h2>
      <ol class="grid gap-3 sm:grid-cols-2">
        {
          steps.map((s) => (
            <li class="rounded-md border border-line bg-panel p-4">
              <span class="grid h-6 w-6 place-items-center rounded-full bg-brand-blue text-xs font-semibold text-white">
                {s.n}
              </span>
              <h3 class="mt-2 text-sm font-medium text-fg">{s.title}</h3>
              <p class="mt-1 text-sm text-muted">{s.desc}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-8">
      <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-muted">No GitHub? Send a report instead</h2>

      <!-- signed out: sign-up gate -->
      <div id="apply-gate" class="rounded-md border border-line bg-panel p-5 text-center">
        <p class="text-sm text-muted">
          Reports are tied to an account, so sign up (free) first, then this form unlocks.
        </p>
        <button
          id="apply-signup"
          type="button"
          class="mt-3 rounded-md bg-brand-blue px-4 py-2 text-sm font-medium text-white hover:opacity-90"
        >
          Sign up to apply
        </button>
      </div>

      <!-- signed in: application form -> prefilled email -->
      <form id="apply-form" hidden class="space-y-4 rounded-md border border-line bg-panel p-5">
        <p class="text-sm text-muted">
          Applying as <span id="apply-email" class="text-fg"></span>. Submitting opens a
          prefilled email in your mail app; just hit send.
        </p>
        <div>
          <label for="apply-github" class="mb-1 block text-sm font-medium text-fg">GitHub username or profile link</label>
          <input
            id="apply-github"
            name="github"
            required
            placeholder="octocat or https://github.com/octocat"
            class="w-full rounded-md border border-line bg-raised px-3 py-2 text-sm text-fg placeholder:text-muted focus:border-accent focus:outline-none"
          />
        </div>
        <div>
          <label for="apply-area" class="mb-1 block text-sm font-medium text-fg">What do you want to contribute?</label>
          <select
            id="apply-area"
            name="area"
            class="w-full rounded-md border border-line bg-raised px-3 py-2 text-sm text-fg focus:border-accent focus:outline-none"
          >
            {areas.map((a) => <option value={a}>{a}</option>)}
          </select>
        </div>
        <div>
          <label for="apply-message" class="mb-1 block text-sm font-medium text-fg">Tell us a little more</label>
          <textarea
            id="apply-message"
            name="message"
            rows="4"
            placeholder="Which gateway, what is wrong or missing, and your source if you have one."
            class="w-full rounded-md border border-line bg-raised px-3 py-2 text-sm text-fg placeholder:text-muted focus:border-accent focus:outline-none"></textarea>
        </div>
        <button
          type="submit"
          class="rounded-md bg-brand-blue px-4 py-2 text-sm font-medium text-white hover:opacity-90"
        >
          Send application
        </button>
      </form>
    </section>

    <p class="mt-8 text-xs text-muted">
      Prefer neither? You can still help: use the details on a gateway page to tell the
      provider their public pricing is unclear, or just share this site.
    </p>
  </div>

  <script>
    import "../scripts/contribute.ts";
  </script>
</Base>
