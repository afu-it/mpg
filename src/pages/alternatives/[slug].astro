---
// "Alternatives to X" pages (spec 12 item 7): one per big-brand gateway,
// derived from popularity (alternativesTargets), ranked via recommend()
// through buildAlternativesPage. Same engine, same honesty rules.
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import { toApiGateway, type GatewayEntryLike } from "../../lib/api";
import { alternativesTargets, buildAlternativesPage, alternativesJsonLd, headlineRates } from "../../lib/seo-pages";
import { breadcrumbLd } from "../../lib/jsonld";
import { getLocale, tr, localizePath } from "../../i18n/locale";
import { gatewayTagline } from "../../i18n/content";

export async function getStaticPaths() {
  const entries = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
  const gateways = entries.map(toApiGateway);
  return alternativesTargets(gateways).map((g) => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
const entries = (await getCollection("gateways")) as unknown as GatewayEntryLike[];
const gateways = entries.map(toApiGateway);
const target = gateways.find((g) => g.slug === slug)!;
const asOf = gateways.map((g) => g.verified_date).sort().at(-1);
const locale = getLocale(Astro);
const page = buildAlternativesPage(gateways, target, 8, asOf, locale);
const T = tr(locale, {
  en: {
    home: "Home",
    gateways: "Gateways",
    alternatives: "Alternatives",
    rankedBy: "Ranked by estimated cost (published rates)",
    alsoFits: "Also fits, pricing on request",
    contactSales: "Contact sales",
    compareTop: (n: string) => `Compare ${n} with the top picks`,
    details: (n: string) => `${n} details`,
    answer4: "Answer 4 questions instead",
    faq: "FAQ",
    more: "More alternatives guides",
    altOf: (n: string) => `${n} alternatives`,
  },
  ms: {
    home: "Utama",
    gateways: "Gateway",
    alternatives: "Pilihan lain",
    rankedBy: "Disusun ikut anggaran caj (kadar rasmi)",
    alsoFits: "Juga sesuai, tapi harga kena tanya",
    contactSales: "Hubungi jualan",
    compareTop: (n: string) => `Banding ${n} dengan pilihan teratas`,
    details: (n: string) => `Butiran ${n}`,
    answer4: "Atau jawab 4 soalan",
    faq: "Soalan lazim",
    more: "Lagi panduan gateway alternatif",
    altOf: (n: string) => `Pilihan lain selain ${n}`,
  },
});
// taglines in the page language (BM overlay when present)
const taglines = new Map(
  await Promise.all(
    page.ranked.map(async (m) => [m.gateway.slug, await gatewayTagline({ id: m.gateway.slug, data: m.gateway }, locale)] as const),
  ),
);

const site = (Astro.site?.href ?? "https://malaysiapg.com.my/").replace(/\/$/, "");
const jsonld = [
  ...alternativesJsonLd(page, site),
  breadcrumbLd(site, [
    { name: T.home, path: localizePath("/", locale) },
    { name: T.gateways, path: localizePath("/gateways/", locale) },
    { name: target.name, path: localizePath(`/gateway/${target.slug}/`, locale) },
    { name: T.alternatives },
  ]),
];

const compareIds = [target.slug, ...page.ranked.slice(0, 3).map((m) => m.gateway.slug)].join(",");
const otherTargets = alternativesTargets(gateways).filter((g) => g.slug !== target.slug);
---

<Base title={page.title} description={page.description}>
  <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-sm text-muted">
    <a href="/" class="hover:text-fg hover:underline">{T.home}</a>
    <span aria-hidden="true">/</span>
    <a href="/gateways/" class="hover:text-fg hover:underline">{T.gateways}</a>
    <span aria-hidden="true">/</span>
    <a href={`/gateway/${target.slug}/`} class="hover:text-fg hover:underline">{page.base}</a>
    <span aria-hidden="true">/</span>
    <span class="text-fg">{T.alternatives}</span>
  </nav>

  <h1 class="max-w-3xl text-3xl font-bold tracking-tight text-fg sm:text-4xl">
    {page.h1}
  </h1>
  <p class="mt-4 max-w-3xl text-muted">{page.intro}</p>
  {page.answerLine && <p class="mt-3 max-w-3xl font-medium text-fg">{page.answerLine}</p>}

  {
    page.ranked.length > 0 && (
      <section class="mt-12">
        <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">
          {T.rankedBy}
        </h2>
        <ol class="divide-y divide-line border-y border-line">
          {page.ranked.map((m, i) => (
            <li class="py-4">
              <div class="flex flex-wrap items-center gap-3">
                <span class="w-6 text-right font-semibold text-muted">{i + 1}.</span>
                <Logo slug={m.gateway.slug} name={m.gateway.name} size={26} />
                <a href={`/gateway/${m.gateway.slug}/`} class="font-medium text-fg hover:underline">
                  {m.gateway.name}
                </a>
                <span class="ml-auto text-sm tabular-nums text-fg">
                  ~RM{m.gateway.est_fee_rm100!.toFixed(2)}
                  <span class="text-muted"> / RM100</span>
                </span>
              </div>
              <p class="mt-2 pl-9 text-sm text-muted">
                {taglines.get(m.gateway.slug) ?? m.gateway.tagline}
                {headlineRates(m.gateway, 3, locale) && (
                  <span class="text-xs"> · {headlineRates(m.gateway, 3, locale)}</span>
                )}
              </p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    page.onRequest.length > 0 && (
      <section class="mt-12">
        <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">
          {T.alsoFits}
        </h2>
        <ul class="divide-y divide-line border-y border-line">
          {page.onRequest.map((m) => (
            <li class="flex items-center gap-3 px-1 py-3">
              <Logo slug={m.gateway.slug} name={m.gateway.name} size={22} />
              <a href={`/gateway/${m.gateway.slug}/`} class="text-fg hover:underline">
                {m.gateway.name}
              </a>
              <span class="ml-auto text-sm text-muted">{T.contactSales}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href={`/compare/?ids=${compareIds}`}
      class="rounded-md bg-brand-blue px-4 py-2 text-sm font-medium text-white hover:opacity-90"
    >
      {T.compareTop(page.base)}
    </a>
    <a href={`/gateway/${target.slug}/`} class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      {T.details(page.base)}
    </a>
    <a href="/choose/" class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">
      {T.answer4}
    </a>
  </div>

  <section class="mt-12">
    <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">{T.faq}</h2>
    <div class="max-w-3xl divide-y divide-line border-y border-line">
      {
        page.faqs.map((f) => (
          <div class="py-4">
            <h3 class="font-medium text-fg">{f.q}</h3>
            <p class="mt-1 text-sm text-muted">{f.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-12 border-t border-line pt-6">
    <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-muted">{T.more}</h2>
    <div class="flex flex-wrap gap-2">
      {
        otherTargets.map((g) => (
          <a
            href={`/alternatives/${g.slug}/`}
            class="rounded-full border border-line bg-panel px-3 py-1 text-xs text-muted hover:text-fg"
          >
            {T.altOf(g.name)}
          </a>
        ))
      }
    </div>
  </section>

  {jsonld.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</Base>
