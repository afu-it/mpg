---
export const prerender = true;

import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { toApiGateway, type GatewayEntryLike } from "../lib/api";

const entries = (await getCollection("gateways")) as unknown as GatewayEntryLike[];

const logos = import.meta.glob("/src/assets/logos/*.{svg,png,webp}", {
  eager: true, query: "?url", import: "default",
});
const logoBySlug: Record<string, string> = {};
for (const [path, url] of Object.entries(logos)) {
  const key = path.split("/").pop()!.replace(/\.\w+$/, "");
  if (!logoBySlug[key] || path.endsWith(".svg")) logoBySlug[key] = url as string;
}

const data = entries.map((e) => ({ ...toApiGateway(e), logo: logoBySlug[e.id] ?? null }));

const channels = [
  { key: "fpx", label: "FPX (online banking)" },
  { key: "card", label: "Cards" },
  { key: "ewallet", label: "E-wallets" },
  { key: "duitnowqr", label: "DuitNow QR" },
  { key: "bnpl", label: "BNPL (instalments)" },
];
const card = "block rounded-md border border-line bg-panel p-4 cursor-pointer hover:border-accent";
---

<Base
  title="Help me choose a Malaysia payment gateway | MPG"
  description="Answer four quick questions and get a ranked shortlist of Malaysian payment gateways that fit your needs, cheapest first, with reasons for every pick."
>
  <div class="mx-auto max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">Help me choose</h1>
    <p class="mt-4 text-muted">
      Answer up to four questions. We will shortlist the gateways that fit, cheapest first.
    </p>

    <form id="choose-form" class="mt-8 space-y-4">
      <!-- Step 1: integration style -->
      <fieldset data-step="0" class="space-y-3">
        <legend class="mb-1 text-base font-medium text-fg">How do you want to integrate?</legend>
        {
          [{ v: "any", l: "No preference" }, { v: "nocode", l: "No-code (payment links)" }, { v: "developer", l: "Developer (API / plugin)" }].map((o) => (
            <label class={card}><input type="radio" name="integration" value={o.v} checked={o.v === "any"} class="mr-2" />{o.l}</label>
          ))
        }
      </fieldset>

      <!-- Step 2: channels (multi) -->
      <fieldset data-step="1" hidden class="space-y-3">
        <legend class="mb-1 text-base font-medium text-fg">Which payment methods do you need?</legend>
        {
          channels.map((c) => (
            <label class={card}><input type="checkbox" name="channel" value={c.key} class="mr-2" />{c.label}</label>
          ))
        }
      </fieldset>

      <!-- Step 3: recurring -->
      <fieldset data-step="2" hidden class="space-y-3">
        <legend class="mb-1 text-base font-medium text-fg">Do you need recurring / subscriptions?</legend>
        {
          [{ v: "any", l: "No preference" }, { v: "yes", l: "Yes" }, { v: "no", l: "No" }].map((o) => (
            <label class={card}><input type="radio" name="recurring" value={o.v} checked={o.v === "any"} class="mr-2" />{o.l}</label>
          ))
        }
      </fieldset>

      <!-- Step 4: access type -->
      <fieldset data-step="3" hidden class="space-y-3">
        <legend class="mb-1 text-base font-medium text-fg">How do you want to onboard?</legend>
        {
          [{ v: "any", l: "No preference" }, { v: "integrate", l: "Integrate yourself (gateway)" }, { v: "account", l: "Merchant account (bank / e-wallet)" }, { v: "bnpl", l: "BNPL at checkout" }].map((o) => (
            <label class={card}><input type="radio" name="access" value={o.v} checked={o.v === "any"} class="mr-2" />{o.l}</label>
          ))
        }
      </fieldset>

      <div id="choose-nav" class="flex items-center gap-3 pt-2">
        <button type="button" id="choose-back" hidden class="rounded-md border border-line px-4 py-2 text-sm text-muted hover:text-fg">Back</button>
        <button type="button" id="choose-next" class="ml-auto rounded-md bg-accent px-4 py-2 text-sm font-medium text-white">Next</button>
      </div>
    </form>

    <div id="choose-results" hidden class="mt-8"></div>

    <!-- SEO copy kept verbatim, folded so the wizard stays the page (spec 16 rollout) -->
    <section class="mt-12 border-t border-line pt-6">
      <details class="group">
        <summary class="flex cursor-pointer select-none items-center gap-2 text-sm text-muted hover:text-fg [&::-webkit-details-marker]:hidden">
          <h2 class="font-medium">How the recommendation works</h2>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-3.5 transition-transform group-open:rotate-180" aria-hidden="true">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Your answers filter the directory by hard requirements: the payment channels your
          customers use, recurring billing, whether you want a no-code setup or a developer
          API, and the kind of account you can open. Matching providers are then ranked by the
          same estimated blended cost used across this site: officially published FPX, card and
          e-wallet rates applied to a RM100 transaction. Providers without comparable published
          rates are shown as quote-based rather than ranked.
        </p>
        <h3 class="mt-5 text-sm font-medium text-fg">Why results may differ from ads</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          We only rank on rates a provider publishes on its own site, each with a source link
          and verified date. Promotional or negotiated rates you see elsewhere are real but not
          comparable, so they never move the ranking. Shortlist two or three candidates here,
          then confirm current pricing with the provider before signing up.
        </p>
      </details>
    </section>
  </div>

  <script type="application/json" id="gw-data" set:html={JSON.stringify(data)} />
  <script>
    import "../scripts/choose.ts";
  </script>
</Base>
