---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { organizationLd } from "../lib/jsonld";
// preload the text face so the LCP headline doesn't wait on the CSS → font chain
import interWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  full?: boolean; // full-bleed layout (index with sidebar)
}

const {
  title = "MPG · Malaysia Payment Gateways",
  description = "Compare fees and features of 60+ Malaysian payment gateways: FPX, cards, e-wallets, DuitNow QR and BNPL, sourced from official rate cards. Free and independent.",
  full = false,
} = Astro.props;

// footer date = most recent fee verification across the directory (data-true,
// and Google reads it as the page's freshness signal)
const updated = (await getCollection("gateways"))
  .map((g) => g.data.verified_date)
  .sort()
  .at(-1);

// canonical: https + trailing slash, matching the sitemap's URL form exactly
// (Google had picked the http:// duplicate of the homepage without this)
const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : Astro.url.pathname + "/";
const canonical = new URL(canonicalPath, Astro.site);

// sitewide Organization entity (same @id as the homepage graph, so they merge);
// the homepage already emits it inside its WebSite graph — skip the duplicate
const orgLd =
  canonicalPath === "/" ? null : JSON.stringify(organizationLd(String(Astro.site ?? Astro.url.origin)));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- ?v= busts sticky favicon caches; bump it when the brand mark changes -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/icon-512.png", Astro.site ?? Astro.url)} />
    {orgLd && <script is:inline type="application/ld+json" set:html={orgLd} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col tabular-nums">
    <div
      id="top-progress"
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5"
      style="background: #001bcf; transform-origin: left center; transform: scaleX(0); box-shadow: 0 0 10px #001bcf, 0 0 6px #001bcf;"
    >
    </div>
    <header class="sticky top-0 z-20 border-b border-line bg-surface">
      <div class="flex h-14 w-full items-center px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-fg">
          <!-- dark theme uses the white mark; the coloured /logo.svg is reserved for the future light mode -->
          <img src="/logo-white.svg" alt="Malaysia Payment Gateway logo" width="22" height="22" class="h-[22px] w-[22px] object-contain" />
          <span class="sm:hidden">MPG</span>
          <span class="hidden sm:inline">Malaysia Payment Gateway</span>
        </a>
        <nav class="ml-auto flex items-center gap-2 text-sm">
          <a href="/gateways" class="rounded-md px-2.5 py-1.5 text-muted hover:bg-panel hover:text-fg">Gateways</a>
          <a href="/compare" class="rounded-md px-2.5 py-1.5 text-muted hover:bg-panel hover:text-fg">Compare</a>
          <a href="/learn" class="rounded-md px-2.5 py-1.5 text-muted hover:bg-panel hover:text-fg">Learn</a>
          <div id="clerk-auth" class="flex items-center gap-2"></div>
        </nav>
      </div>
    </header>

    {
      full ? (
        <main class="w-full flex-1">
          <slot />
        </main>
      ) : (
        <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
          <slot />
        </main>
      )
    }

    <footer class="border-t border-line">
      <div class="w-full space-y-1 px-4 py-6 text-xs text-muted sm:px-6">
        <p>
          Fees are indicative and may change or be negotiable by volume.
          Always confirm with the provider before deciding.
        </p>
        <p>Last updated {updated}. MPG is an independent directory, not affiliated with any provider.</p>
        <p class="pt-1">
          <a href="/choose" class="text-muted underline-offset-2 hover:text-fg hover:underline">Help me choose</a>
          <span class="px-1">·</span>
          <a href="/best/payment-gateway-malaysia/" class="text-muted underline-offset-2 hover:text-fg hover:underline">Best gateways</a>
          <span class="px-1">·</span>
          <a href="/calculator" class="text-muted underline-offset-2 hover:text-fg hover:underline">Fee calculator</a>
          <span class="px-1">·</span>
          <a href="/fee-changes" class="text-muted underline-offset-2 hover:text-fg hover:underline">Fee changes</a>
          <span class="px-1">·</span>
          <a href="/vs/" class="text-muted underline-offset-2 hover:text-fg hover:underline">Comparisons</a>
          <span class="px-1">·</span>
          <a href="/learn/api" class="text-muted underline-offset-2 hover:text-fg hover:underline">API &amp; MCP for developers</a>
          <span class="px-1">·</span>
          <a href="/contribute" class="text-muted underline-offset-2 hover:text-fg hover:underline">Contribute</a>
          <span class="px-1">·</span>
          <a href="/about" class="text-muted underline-offset-2 hover:text-fg hover:underline">About</a>
          <span class="px-1">·</span>
          <a href="/contact" class="text-muted underline-offset-2 hover:text-fg hover:underline">Contact</a>
          <span class="px-1">·</span>
          <a href="/privacy" class="text-muted underline-offset-2 hover:text-fg hover:underline">Privacy</a>
        </p>
      </div>
    </footer>

    <script>
      import "../scripts/progress.ts";
      import "../scripts/auth.ts";
    </script>
  </body>
</html>
