---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  full?: boolean; // full-bleed layout (index with sidebar)
}

const {
  title = "MPG · Malaysia Payment Gateways",
  description = "Compare fees and features of Malaysian payment gateways (FPX, cards, e-wallets, and DuitNow QR) in one place.",
  full = false,
} = Astro.props;

const updated = "2026-06-24";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="flex min-h-screen flex-col tabular-nums">
    <div
      id="top-progress"
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5"
      style="background: #001bcf; transform-origin: left center; transform: scaleX(0); box-shadow: 0 0 10px #001bcf, 0 0 6px #001bcf;"
    >
    </div>
    <header class="sticky top-0 z-20 border-b border-line bg-surface">
      <div class="flex h-14 w-full items-center px-4 sm:px-6">
        <a href="/" class="font-semibold tracking-tight text-fg">
          MPG <span class="hidden font-normal text-muted sm:inline">· Malaysia Payment Gateways</span>
        </a>
        <nav class="ml-auto flex items-center gap-2 text-sm">
          <a href="/gateways" class="rounded-md px-2.5 py-1.5 text-muted hover:bg-panel hover:text-fg">Gateways</a>
          <a href="/compare" class="rounded-md px-2.5 py-1.5 text-muted hover:bg-panel hover:text-fg">Compare</a>
          <a href="/learn" class="rounded-md px-2.5 py-1.5 text-muted hover:bg-panel hover:text-fg">Learn</a>
          <div id="clerk-auth" class="flex items-center gap-2"></div>
        </nav>
      </div>
    </header>

    {
      full ? (
        <main class="w-full flex-1">
          <slot />
        </main>
      ) : (
        <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
          <slot />
        </main>
      )
    }

    <footer class="border-t border-line">
      <div class="w-full space-y-1 px-4 py-6 text-xs text-muted sm:px-6">
        <p>
          Fees are indicative and may change or be negotiable by volume.
          Always confirm with the provider before deciding.
        </p>
        <p>Last updated {updated}. MPG is an independent directory, not affiliated with any provider.</p>
        <p class="pt-1">
          <a href="/choose" class="text-muted underline-offset-2 hover:text-fg hover:underline">Help me choose</a>
          <span class="px-1">·</span>
          <a href="/best/payment-gateway-malaysia" class="text-muted underline-offset-2 hover:text-fg hover:underline">Best gateways</a>
          <span class="px-1">·</span>
          <a href="/learn/api" class="text-muted underline-offset-2 hover:text-fg hover:underline">API &amp; MCP for developers</a>
        </p>
      </div>
    </footer>

    <script>
      import "../scripts/progress.ts";
      import "../scripts/auth.ts";
    </script>
  </body>
</html>
