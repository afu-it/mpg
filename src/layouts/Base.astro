---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { organizationLd } from "../lib/jsonld";
import { pairFor } from "../lib/i18n-pages";
import { CLUSTERS, blogPath } from "../lib/blog";
// preload the text face so the LCP headline doesn't wait on the CSS → font chain
import interWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  full?: boolean; // full-bleed layout (index with sidebar)
  lang?: "en" | "ms"; // BM pages under /ms/ set "ms" (spec 12 slice G)
  ogImage?: string; // site-relative 1200x630 social image (blog posts)
  ogImageAlt?: string;
}

const {
  title = "MPG · Malaysia Payment Gateways",
  description = "Compare fees and features of 70+ Malaysian payment gateways: FPX, cards, e-wallets, DuitNow QR and BNPL, sourced from official rate cards. Free and independent.",
  full = false,
  lang = "en",
  ogImage,
  ogImageAlt,
} = Astro.props;

// footer date = most recent fee verification across the directory (data-true,
// and Google reads it as the page's freshness signal)
const updated = (await getCollection("gateways"))
  .map((g) => g.data.verified_date)
  .sort()
  .at(-1);

// canonical: https + trailing slash, matching the sitemap's URL form exactly
// (Google had picked the http:// duplicate of the homepage without this)
const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : Astro.url.pathname + "/";
const canonical = new URL(canonicalPath, Astro.site);

// sitewide Organization entity (same @id as the homepage graph, so they merge);
// the homepage already emits it inside its WebSite graph — skip the duplicate
const orgLd =
  canonicalPath === "/" ? null : JSON.stringify(organizationLd(String(Astro.site ?? Astro.url.origin)));

// reciprocal hreflang for the curated BM pairs (both sides, x-default = en)
const i18nPair = pairFor(canonicalPath);

// footer topic pillars (spec 15): only clusters whose pillar page has shipped
const livePillars = CLUSTERS.filter((c) => c.live);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- ?v= busts sticky favicon caches; bump it when the brand mark changes -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(ogImage ?? "/icon-512.png", Astro.site ?? Astro.url)} />
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {orgLd && <script is:inline type="application/ld+json" set:html={orgLd} />}
    {
      i18nPair && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(i18nPair.en, Astro.site)} />
          <link rel="alternate" hreflang="ms" href={new URL(i18nPair.ms, Astro.site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(i18nPair.en, Astro.site)} />
        </>
      )
    }
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col tabular-nums">
    <div
      id="top-progress"
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5"
      style="background: #001bcf; transform-origin: left center; transform: scaleX(0); box-shadow: 0 0 10px #001bcf, 0 0 6px #001bcf;"
    >
    </div>
    <header class="sticky top-0 z-20 border-b border-line bg-surface">
      <div class="flex h-14 w-full items-center px-4 sm:px-6">
        <!-- mobile nav drawer trigger (spec 14) -->
        <button
          type="button"
          id="nav-open"
          aria-label="Open menu"
          aria-controls="nav-drawer"
          aria-expanded="false"
          class="-ml-2 mr-1 flex size-11 items-center justify-center rounded-md text-muted hover:bg-panel hover:text-fg sm:hidden"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-5" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-fg">
          <!-- dark theme uses the white mark; the coloured /logo.svg is reserved for the future light mode -->
          <img src="/logo-white.svg" alt="Malaysia Payment Gateway logo" width="22" height="22" class="h-[22px] w-[22px] object-contain" />
          <span class="sm:hidden">MPG</span>
          <span class="hidden sm:inline">Malaysia Payment Gateway</span>
        </a>
        <nav class="ml-auto flex items-center gap-2 text-sm">
          <a href="/gateways/" class="hidden rounded-md px-2.5 py-1.5 text-muted hover:bg-panel hover:text-fg sm:inline-block">Gateways</a>
          <a href="/compare/" class="hidden rounded-md px-2.5 py-1.5 text-muted hover:bg-panel hover:text-fg sm:inline-block">Compare</a>
          <a href="/blog/" class="hidden rounded-md px-2.5 py-1.5 text-muted hover:bg-panel hover:text-fg sm:inline-block">Guides</a>
          <a href="/learn/" class="hidden rounded-md px-2.5 py-1.5 text-muted hover:bg-panel hover:text-fg sm:inline-block">Learn</a>
          <div id="clerk-auth" class="flex items-center gap-2"></div>
        </nav>
      </div>
    </header>

    <!-- mobile nav drawer (spec 14): left slide-in, scrim + Esc + X to close -->
    <div id="nav-scrim" hidden class="fixed inset-0 z-30 bg-black/50 sm:hidden" aria-hidden="true"></div>
    <aside
      id="nav-drawer"
      class="fixed inset-y-0 left-0 z-40 w-80 max-w-[85vw] -translate-x-full overflow-y-auto border-r border-line bg-surface px-4 py-4 transition-transform duration-200 data-[open]:translate-x-0 motion-reduce:transition-none sm:hidden"
      aria-label="Site menu"
    >
      <div class="mb-3 flex items-center justify-between">
        <span class="flex items-center gap-2 font-semibold text-fg">
          <img src="/logo-white.svg" alt="Malaysia Payment Gateway logo" width="20" height="20" class="h-5 w-5 object-contain" />
          Menu
        </span>
        <button
          type="button"
          id="nav-close"
          aria-label="Close menu"
          class="flex size-11 items-center justify-center rounded-md text-muted hover:bg-panel hover:text-fg"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-5" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <nav class="flex flex-col text-sm" aria-label="Mobile">
        {
          [
            { href: "/gateways/", label: "Gateways" },
            { href: "/compare/", label: "Compare" },
            { href: "/choose/", label: "Help me choose" },
            { href: "/calculator/", label: "Fee calculator" },
            { href: "/fee-changes/", label: "Fee changes" },
            { href: "/best/payment-gateway-malaysia/", label: "Best gateways" },
            { href: "/vs/", label: "Comparisons" },
            { href: "/blog/", label: "Guides" },
            { href: "/learn/", label: "Learn" },
            { href: "/learn/api/", label: "API & MCP" },
            { href: "/contribute/", label: "Contribute" },
            { href: "/about/", label: "About" },
          ].map((l) => (
            <a href={l.href} class="rounded-md px-2 py-3 text-fg hover:bg-panel">
              {l.label}
            </a>
          ))
        }
      </nav>
    </aside>

    {
      full ? (
        <main class="w-full flex-1">
          <slot />
        </main>
      ) : (
        <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
          <slot />
        </main>
      )
    }

    <footer class="border-t border-line">
      <div class="mx-auto w-full max-w-6xl px-4 pt-10 sm:px-6">
        <div class="flex flex-col gap-3 rounded-lg border border-line bg-panel px-5 py-3 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm text-muted">
            <span class="font-medium text-white">Spotted a fee change?</span> Tell us and we will re-check it against the official source.
          </p>
          <a href="/contribute/" class="inline-flex h-8 shrink-0 items-center self-start rounded-md bg-brand-blue px-4 text-xs font-medium text-white hover:opacity-90 sm:self-auto">Report a change</a>
        </div>
      </div>
      <div class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_2fr]">
        <div class="max-w-xs">
          <a href="/" class="flex items-center gap-2 font-semibold text-white">
            <img src="/logo-white.svg" alt="" width="22" height="22" class="h-[22px] w-[22px] object-contain" />
            Malaysia Payment Gateway
          </a>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            An independent directory of Malaysian payment gateway fees, each one taken from the provider's official pricing page.
          </p>
          <p class="mt-5 flex items-center gap-2 text-xs text-muted">
            <span class="size-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
            Fees last verified {updated}
          </p>
          <a href="https://github.com/afu-it/mpg" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 rounded-md border border-line px-3 py-1.5 text-xs text-fg hover:border-accent">
            <svg viewBox="0 0 16 16" class="size-3.5" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
            Open source on GitHub
          </a>
        </div>
        <div class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-3">
          <div>
            <p class="mb-3 text-xs font-medium uppercase tracking-wider text-white">Tools</p>
            <ul class="space-y-2 text-muted">
              <li><a href="/choose/" class="hover:text-white">Help me choose</a></li>
              <li><a href="/calculator/" class="hover:text-white">Fee calculator</a></li>
              <li><a href="/best/payment-gateway-malaysia/" class="hover:text-white">Best gateways</a></li>
              <li><a href="/vs/" class="hover:text-white">Comparisons</a></li>
              <li><a href="/fee-changes/" class="hover:text-white">Fee changes</a></li>
            </ul>
          </div>
          <div>
            <p class="mb-3 text-xs font-medium uppercase tracking-wider text-white">Guides</p>
            <ul class="space-y-2 text-muted">
              <li><a href="/blog/" class="hover:text-white">All guides</a></li>
              {
                livePillars.map((c) => (
                  <li>
                    <a href={blogPath(c.slug)} class="hover:text-white">
                      {c.name}
                    </a>
                  </li>
                ))
              }
              <li><a href="/learn/" class="hover:text-white">Learn</a></li>
              <li><a href="/learn/api/" class="hover:text-white">API &amp; MCP</a></li>
            </ul>
          </div>
          <div>
            <p class="mb-3 text-xs font-medium uppercase tracking-wider text-white">Site</p>
            <ul class="space-y-2 text-muted">
              <li><a href="/about/" class="hover:text-white">About</a></li>
              <li><a href="/contact/" class="hover:text-white">Contact</a></li>
              <li><a href="/contribute/" class="hover:text-white">Contribute</a></li>
              <li><a href="/ms/" class="hover:text-white" hreflang="ms" lang="ms">Bahasa Malaysia</a></li>
              <li><a href="/privacy/" class="hover:text-white">Privacy</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="border-t border-line">
        <div class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-muted sm:flex-row sm:justify-between sm:px-6">
          <span>© {new Date().getFullYear()} Malaysia Payment Gateway. Open source, open data.</span>
          <span>Fees are indicative; always confirm with the provider. Not affiliated with any provider.</span>
        </div>
      </div>
    </footer>

    <script>
      import "../scripts/progress.ts";
      import "../scripts/auth.ts";
      import "../scripts/nav.ts";
    </script>
  </body>
</html>
